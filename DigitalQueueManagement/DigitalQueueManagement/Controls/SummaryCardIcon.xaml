<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalQueueManagement.Controls.SummaryCardIcon"
             x:Name="Root">
    <Border WidthRequest="30"
            HeightRequest="30"
            BackgroundColor="{Binding TintColor, Source={x:Reference Root}}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 9">
        <Label Text="{Binding IconName, Source={x:Reference Root}}"
               FontFamily="MaterialIcons"
               FontSize="17"
               TextColor="{Binding IconColor, Source={x:Reference Root}}"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center" />
    </Border>
</ContentView>
