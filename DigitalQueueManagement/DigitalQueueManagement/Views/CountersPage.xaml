<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DigitalQueueManagement.Model"
             xmlns:vm="clr-namespace:DigitalQueueManagement.ViewModel"
             xmlns:listview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             x:Class="DigitalQueueManagement.Views.CountersPage"
             x:DataType="vm:CounterOperationsViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="CounterCardHover" TargetType="Border">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Stroke" Value="#BFDBFE" />
                                    <Setter Property="StrokeThickness" Value="1.2" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <VerticalStackLayout x:Name="PageContentLayout"
                             BindingContext="{Binding QueueSession}"
                             x:DataType="vm:QueueSessionViewModel"
                             Padding="28,22,28,36"
                             Spacing="18">
            <Grid x:Name="MetricGrid"
                  ColumnDefinitions="*,*,*,*"
                  RowDefinitions="Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Border Grid.Column="0" Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Active counter" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                            <Label Grid.Column="1" Text="desktop_windows" FontFamily="MaterialIcons" FontSize="17" TextColor="#159B85" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding SelectedCounterDisplayName}" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="{Binding SelectedCounterAvailabilityText}" FontSize="9" TextColor="#64748B" VerticalOptions="End" />
                        </Grid>
                        <Label Grid.Row="2" Text="{Binding SelectedCounterDisplayService, StringFormat='●  {0} terminal'}" FontSize="9" TextColor="#159B85" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Waiting" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                            <Label Grid.Column="1" Text="schedule" FontFamily="MaterialIcons" FontSize="17" TextColor="#183E91" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding WaitingTokenCount}" FontSize="27" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="Tokens" FontSize="9" TextColor="#64748B" VerticalOptions="End" />
                        </Grid>
                        <Label Grid.Row="2" Text="●  Across all counters" FontSize="9" TextColor="#183E91" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Completed" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                            <Label Grid.Column="1" Text="verified_user" FontFamily="MaterialIcons" FontSize="17" TextColor="#159B85" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding CompletedTokenCount}" FontSize="27" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="Tokens" FontSize="9" TextColor="#64748B" VerticalOptions="End" />
                        </Grid>
                        <Label Grid.Row="2" Text="●  Today" FontSize="9" TextColor="#159B85" />
                    </Grid>
                </Border>
                <Border Grid.Column="3" Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Skipped" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                            <Label Grid.Column="1" Text="monitor_heart" FontFamily="MaterialIcons" FontSize="17" TextColor="#DC6670" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding SkippedTokenCount}" FontSize="27" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="Tokens" FontSize="9" TextColor="#64748B" VerticalOptions="End" />
                        </Grid>
                        <Label Grid.Row="2" Text="●  Available for recall" FontSize="9" TextColor="#DC6670" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="WorkspaceGrid"
                  ColumnDefinitions="320,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="16"
                  RowSpacing="16">
                <Border x:Name="MobileCounterSelectorPanel"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        IsVisible="False"
                        Padding="16"
                        BackgroundColor="White"
                        Stroke="#DCE7F5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="ACTIVE COUNTER" FontSize="11" FontAttributes="Bold" TextColor="#444653" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                <Border Padding="10,5" BackgroundColor="{Binding SelectedCounterAvailabilityBackgroundColor}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                                    <HorizontalStackLayout Spacing="6">
                                        <BoxView WidthRequest="8" HeightRequest="8" Color="{Binding SelectedCounterAvailabilityColor}" CornerRadius="4" VerticalOptions="Center" />
                                        <Label Text="{Binding SelectedCounterAvailabilityText}" FontSize="12" TextColor="{Binding SelectedCounterAvailabilityColor}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Button Text="Manage"
                                        FontSize="11"
                                        Padding="8,4"
                                        TextColor="#183E91"
                                        BackgroundColor="#EEF4FF"
                                        CornerRadius="8"
                                        Clicked="OnManageCountersClicked" />
                            </HorizontalStackLayout>
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout x:Name="MobileCounterChoices"
                                                   BindableLayout.ItemsSource="{Binding CounterSummaries}"
                                                   Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:QueueCounterSummary">
                                        <Border Style="{StaticResource CounterCardHover}"
                                                Padding="12,8"
                                                BackgroundColor="#F5F7FB"
                                                Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 10">
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                <Label Text="desktop_windows"
                                                       FontFamily="MaterialIcons"
                                                       FontSize="16"
                                                       TextColor="#64748B"
                                                       VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#334155" />
                                                    <Label Text="{Binding AvailabilityText}"
                                                           FontSize="10"
                                                           TextColor="#64748B" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#EEF4FF" />
                                                    <Setter Property="Stroke" Value="#183E91" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCounterTapped" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="CounterListPanel"
                        Grid.Column="0"
                        Padding="16"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                <Label Text="desktop_windows" FontFamily="MaterialIcons" FontSize="16" TextColor="#183E91" />
                                <Label Text="Terminals &amp; counters" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="{Binding OnlineCounterCount, StringFormat='{0} Active'}" FontSize="9" TextColor="#64748B" VerticalOptions="Center" />
                        </Grid>
                        <Grid HeightRequest="240">
                            <listview:SfListView x:Name="CounterListView"
                                                 ItemsSource="{Binding CounterSummaries}"
                                                 ItemSize="80"
                                                 HeightRequest="240"
                                                 SelectionMode="None"
                                                 IsVisible="{Binding HasCounters}">
                                <listview:SfListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:QueueCounterSummary">
                                        <Grid BackgroundColor="White">
                                            <Border Style="{StaticResource CounterCardHover}" Margin="0,4" Padding="10,6" BackgroundColor="White" Stroke="#E9EEF5" StrokeThickness="1" StrokeShape="RoundRectangle 9">
                                                <Grid RowDefinitions="Auto,1,Auto" RowSpacing="8">
                                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="9">
                                                        <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 7" VerticalOptions="Center">
                                                            <Label Text="desktop_windows" FontFamily="MaterialIcons" FontSize="16" TextColor="#64748B" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                        </Border>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                            <Label Text="{Binding Name}" FontSize="10" FontAttributes="Bold" TextColor="#0F172A" />
                                                            <Label Text="{Binding Service}" FontSize="8" TextColor="#64748B" />
                                                        </VerticalStackLayout>
                                                        <Border Grid.Column="2" Padding="7,4" BackgroundColor="{Binding AvailabilityBackgroundColor}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                                            <Label Text="{Binding AvailabilityText, StringFormat='• {0}'}" FontSize="8" FontAttributes="Bold" TextColor="{Binding AvailabilityColor}" />
                                                        </Border>
                                                    </Grid>
                                                    <BoxView Grid.Row="1" HeightRequest="1" Color="#E2E8F0" />
                                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="End">
                                                        <HorizontalStackLayout Spacing="5">
                                                            <Label Text="{Binding TokenStatus}" FontSize="8" FontAttributes="Bold" TextColor="#64748B" />
                                                            <Label Text="{Binding TokenId}" FontSize="9" FontAttributes="Bold" TextColor="#183E91" />
                                                        </HorizontalStackLayout>
                                                        <Label Grid.Column="1" Text="{Binding AvailabilityText}" FontSize="8" TextColor="#64748B" />
                                                    </Grid>
                                                </Grid>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="#183E91" />
                                                        <Setter Property="BackgroundColor" Value="#F1F5FF" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnCounterTapped" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </listview:SfListView.ItemTemplate>
                            </listview:SfListView>
                            <VerticalStackLayout IsVisible="{Binding HasNoCounters}"
                                                 Spacing="5"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">
                                <Label Text="No counters available" FontSize="12" FontAttributes="Bold" TextColor="#334155" HorizontalTextAlignment="Center" />
                                <Label Text="Add a counter to start serving." FontSize="10" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button Text="···  Manage terminals"
                                TextColor="#183E91"
                                BackgroundColor="White"
                                BorderColor="#D8E2F0"
                                BorderWidth="1"
                                FontSize="10"
                                FontAttributes="Bold"
                                Padding="12,9"
                                CornerRadius="8"
                                Clicked="OnManageCountersClicked">
                            <Button.VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#BFDBFE" />
                                                <Setter Property="BorderWidth" Value="1.2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </Button.VisualStateManager.VisualStateGroups>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="OperationsPanel"
                        Grid.Column="1"
                        Padding="22"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="10">
                        <Border x:Name="MobileCurrentTokenPanel"
                                Padding="0"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                <BoxView WidthRequest="10" HeightRequest="10" Color="#10B981" CornerRadius="5" VerticalOptions="Center" />
                                <Border Padding="10,5" BackgroundColor="#E9FBF4" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                    <Label Text="{Binding SelectedCounterTokenStatus}" FontSize="9" FontAttributes="Bold" TextColor="#159B85" VerticalOptions="Center" />
                                </Border>
                                <Border Padding="10,5" BackgroundColor="#FFF6E8" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                    <Label x:Name="PriorityLabel"
                                           Text="{Binding SelectedCounterToken.Priority, StringFormat='{0} Priority'}"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           TextColor="#B45309"
                                           VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" Padding="10,6" BackgroundColor="#EEF4FF" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                                <Label Text="{Binding SelectedCounterDisplayName}" FontSize="9" FontAttributes="Bold" TextColor="#183E91" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="3" Padding="0,4" HorizontalOptions="Center">
                            <Label x:Name="SelectedTokenIdLabel"
                                   Text="{Binding SelectedCounterTokenId}"
                                   FontSize="58"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center" />
                            <Border Padding="12,6" BackgroundColor="#EEF4FF" StrokeThickness="0" StrokeShape="RoundRectangle 14" HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="confirmation_number" FontFamily="MaterialIcons" FontSize="12" TextColor="#183E91" />
                                    <Label Text="{Binding SelectedCounterTokenService}" FontSize="10" FontAttributes="Bold" TextColor="#183E91" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <Border Padding="16,10" BackgroundColor="#F4F7FD" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="*,1,*" ColumnSpacing="0">
                                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="Serving duration" FontSize="9" TextColor="#64748B" />
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label x:Name="ServingDurationLabel" Text="04:58" FontSize="18" FontAttributes="Bold" TextColor="#0F172A">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding SelectedCounterTokenStatus}" Value="Ready">
                                                    <Setter Property="Text" Value="—" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Border Padding="8,3" BackgroundColor="#D1FAE5" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                            <Label Text="{Binding SelectedCounterTokenStatus}" FontSize="8" FontAttributes="Bold" TextColor="#047857" VerticalOptions="Center" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="44" Color="#E2E8F0" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="2" Spacing="4" Padding="16,0,0,0" VerticalOptions="Center">
                                    <Label Text="Initial wait" FontSize="9" TextColor="#64748B" />
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label x:Name="InitialWaitLabel" Text="3m 12s" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="Under avg." FontSize="8" TextColor="#64748B" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="MobileCounterActionsPanel"
                                Padding="0"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="CallNextButton"
                                    Text="Call next"
                                    TextColor="White"
                                    BackgroundColor="#153F9A"
                                    FontSize="11"
                                    FontFamily="OpenSansSemibold"
                                    FontAttributes="Bold"
                                    Padding="12,12"
                                    ContentLayout="Left, 8"
                                    CornerRadius="5"
                                    IsEnabled="{Binding CanCallNext}"
                                    Clicked="OnCallNextClicked" />
                            <Button x:Name="CompleteButton"
                                    Grid.Column="1"
                                    Text="Complete service"
                                    TextColor="White"
                                    BackgroundColor="#94A3B8"
                                    FontSize="11"
                                    FontFamily="OpenSansSemibold"
                                    FontAttributes="Bold"
                                    Padding="12,12"
                                    ContentLayout="Left, 8"
                                    CornerRadius="5"
                                    IsEnabled="{Binding CanCompleteCurrent}"
                                    Clicked="OnCompleteClicked" />
                        </Grid>
                        <BoxView x:Name="CounterActionsDivider" HeightRequest="1" Color="#E2E8F0" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button x:Name="SkipButton"
                                    Text="Skip token"
                                    TextColor="#475569"
                                    BackgroundColor="#F8FAFC"
                                    BorderColor="#E2E8F0"
                                    BorderWidth="1"
                                    FontSize="9"
                                    FontFamily="OpenSansSemibold"
                                    FontAttributes="Bold"
                                    Padding="8,6"
                                    CornerRadius="5"
                                    IsEnabled="{Binding CanSkipCurrent}"
                                    Clicked="OnSkipClicked" />
                            <Button x:Name="RecallButton"
                                    Grid.Column="1"
                                    Text="Recall token"
                                    TextColor="#475569"
                                    BackgroundColor="#F8FAFC"
                                    BorderColor="#E2E8F0"
                                    BorderWidth="1"
                                    FontSize="9"
                                    FontFamily="OpenSansSemibold"
                                    FontAttributes="Bold"
                                    Padding="8,6"
                                    CornerRadius="5"
                                    IsEnabled="{Binding CanRecallCurrent}"
                                    Clicked="OnRecallClicked" />
                            <Button x:Name="TransferButton"
                                    Grid.Column="2"
                                    Text="Transfer token"
                                    TextColor="#183E91"
                                    BackgroundColor="#F8FAFC"
                                    BorderColor="#E2E8F0"
                                    BorderWidth="1"
                                    FontSize="9"
                                    FontFamily="OpenSansSemibold"
                                    FontAttributes="Bold"
                                    Padding="8,6"
                                    CornerRadius="5"
                                    IsEnabled="{Binding CanTransferCurrent}"
                                    Clicked="OnTransferClicked" />
                        </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="MobileQueueSummaryPanel"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        IsVisible="False"
                        Padding="14"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="QUEUE SUMMARY" FontSize="11" FontAttributes="Bold" TextColor="#444653" />
                            <Label Grid.Column="1"
                                   Text="{Binding SelectedCounterDisplayName, StringFormat='{0} Today'}"
                                   FontSize="11"
                                   TextColor="#64748B" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border Padding="8" BackgroundColor="#EEF4FF" Stroke="#DCE8FF" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Waiting" FontSize="11" TextColor="#334155" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding WaitingTokenCount}" FontSize="20" FontAttributes="Bold" TextColor="#183E91" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Padding="8" BackgroundColor="#E9FBF4" Stroke="#D3F3E9" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Completed" FontSize="11" TextColor="#334155" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding CompletedTokenCount}" FontSize="20" FontAttributes="Bold" TextColor="#08796D" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Padding="8" BackgroundColor="#F4F4F8" Stroke="#E7E7ED" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Skipped" FontSize="11" TextColor="#334155" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding SkippedTokenCount}" FontSize="20" FontAttributes="Bold" TextColor="#7A7A87" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="QueuePreviewPanel"
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="16"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="Waiting queue preview" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" />
                                <Border Padding="7,3" BackgroundColor="#EEF4FF" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                                    <Label Text="Next 3" FontSize="8" FontAttributes="Bold" TextColor="#183E91" />
                                </Border>
                            </HorizontalStackLayout>
                            <Button Grid.Column="1"
                                    Text="{Binding WaitingTokenCount, StringFormat='View all {0} waiting  ›'}"
                                    TextColor="#183E91"
                                    BackgroundColor="Transparent"
                                    FontSize="8"
                                    FontAttributes="Bold"
                                    Padding="4,2"
                                    Clicked="OnViewAllWaitingClicked" />
                        </Grid>
                        <Grid>
                            <listview:SfListView ItemsSource="{Binding CounterWaitingPreview}"
                                                 ItemSize="56"
                                                 HeightRequest="168"
                                                 SelectionMode="None"
                                                 IsVisible="{Binding HasCounterWaitingTokens}">
                                <listview:SfListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:QueueTokenListItem">
                                        <Border Style="{StaticResource CounterCardHover}" Margin="0,3" Padding="9,7" BackgroundColor="#F8FAFF" Stroke="#EEF2F7" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                            <Grid ColumnDefinitions="48,1,*,Auto" ColumnSpacing="10">
                                                <Label Text="{Binding Id}" FontSize="10" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                                                <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="30" Color="#E2E8F0" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
                                                    <Label Text="{Binding Service}" FontSize="9" FontAttributes="Bold" TextColor="#0F172A" />
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Label Text="{Binding CounterName}" FontSize="8" TextColor="#64748B" />
                                                        <Label Text="·" FontSize="8" TextColor="#94A3B8" />
                                                        <Label Text="{Binding Wait}" FontSize="8" TextColor="#64748B" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="3" Spacing="3" HorizontalOptions="End" VerticalOptions="Center">
                                                    <Border Padding="6,3" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                                        <Label Text="{Binding Priority}" FontSize="7" FontAttributes="Bold" TextColor="#475569" />
                                                    </Border>
                                                    <Label Text="{Binding QueuePositionText}" FontSize="7" TextColor="#64748B" HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </listview:SfListView.ItemTemplate>
                            </listview:SfListView>
                            <VerticalStackLayout IsVisible="{Binding HasNoCounterWaitingTokens}" Spacing="4" Padding="10">
                                <Label Text="No waiting tokens" FontSize="10" FontAttributes="Bold" TextColor="#334155" />
                                <Label Text="The queue preview is clear." FontSize="9" TextColor="#64748B" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="6" HeightRequest="6" Color="#10B981" CornerRadius="3" VerticalOptions="Center" />
                                <Label Text="Local sample data" FontSize="8" TextColor="#64748B" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="Estimated total queue: 24 min" FontSize="8" TextColor="#64748B" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
</ContentView>
