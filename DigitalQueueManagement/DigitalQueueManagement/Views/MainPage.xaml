<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigitalQueueManagement.ViewModel"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:dialogs="clr-namespace:DigitalQueueManagement.Views.Dialogs"
             x:Class="DigitalQueueManagement.Views.MainPage"
             x:DataType="vm:AppShellViewModel"
             BackgroundColor="{StaticResource Canvas}"
             Shell.NavBarIsVisible="False">
    <Grid x:Name="PageRoot"
          RowDefinitions="68,*,Auto"
          BackgroundColor="{StaticResource Canvas}">
        <Grid x:Name="DesktopHeader"
              Grid.Row="0"
              BackgroundColor="White">
            <Grid x:Name="HeaderLayout"
                  ColumnDefinitions="Auto,*,Auto"
                  MaximumWidthRequest="1560"
                  HorizontalOptions="Center"
                  Padding="28,0">
                <Grid Grid.Column="0"
                      ColumnDefinitions="40,*"
                      ColumnSpacing="12"
                      VerticalOptions="Center">
                    <Border WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#183E91"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <Label Text="key"
                               FontFamily="MaterialIcons"
                               FontSize="20"
                               TextColor="White"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               SemanticProperties.Description="Queue key" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="1"
                                         VerticalOptions="Center">
                        <Label Text="{Binding QueueSession.ActiveHeaderTitle}"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="monitor_heart"
                                   FontFamily="MaterialIcons"
                                   FontSize="12"
                                   TextColor="#64748B"
                                   VerticalTextAlignment="Center" />
                            <Label Text="{Binding QueueSession.CurrentDateText}"
                                   FontSize="11"
                                   TextColor="#64748B" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
                <Border Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Padding="4"
                        BackgroundColor="white"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <buttons:SfSegmentedControl x:Name="HeaderTabs"
                                               WidthRequest="360"
                                               SegmentWidth="116"
                                               SegmentHeight="38"
                                               Background="#EEF4FF"
                                               CornerRadius="7"
                                               SegmentCornerRadius="7"
                                               StrokeThickness="0"
                                               ShowSeparator="False"
                                               SegmentBackground="#EEF4FF"
                                               SelectedIndex="{Binding QueueSession.HeaderTabIndex, Mode=TwoWay}">
                        <buttons:SfSegmentedControl.TextStyle>
                            <buttons:SegmentTextStyle FontSize="14" TextColor="#64748B" />
                        </buttons:SfSegmentedControl.TextStyle>
                        <buttons:SfSegmentedControl.SegmentTemplate>
                            <DataTemplate x:DataType="buttons:SfSegmentItem">
                                <Grid HeightRequest="38">
                                    <Border x:Name="HeaderTabHoverBackground"
                                            InputTransparent="True"
                                            StrokeShape="RoundRectangle 7"
                                            StrokeThickness="0">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#EEF4FF" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="Opacity" Value="0" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <Grid ColumnDefinitions="16,Auto"
                                          ColumnSpacing="6"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          InputTransparent="True">
                                        <Image Source="{Binding ImageSource}"
                                               WidthRequest="15"
                                               HeightRequest="15"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Text}"
                                               FontSize="14"
                                               TextColor="#64748B"
                                               VerticalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </buttons:SfSegmentedControl.SegmentTemplate>
                        <buttons:SfSegmentedControl.SelectionIndicatorSettings>
                            <buttons:SelectionIndicatorSettings SelectionIndicatorPlacement="Fill"
                                                                Background="#183E91"
                                                                TextColor="White" />
                        </buttons:SfSegmentedControl.SelectionIndicatorSettings>
                    </buttons:SfSegmentedControl>
                </Border>
                <Button Grid.Column="2"
                        Text="more_horiz"
                        FontFamily="MaterialIcons"
                        FontSize="19"
                        TextColor="#64748B"
                        BackgroundColor="Transparent"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Clicked="OnOptionsClicked"
                        SemanticProperties.Description="More options and reset queue" />
            </Grid>
            <BoxView HeightRequest="1"
                     Color="#E2E8F0"
                     VerticalOptions="End" />
        </Grid>
        <Grid x:Name="MobileHeader"
              Grid.Row="0"
              IsVisible="False"
              Padding="20,8"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{StaticResource Canvas}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                <Label x:Name="MobileHeaderTitle"
                       Text="Queue Overview"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />
                <Label x:Name="MobileHeaderDate"
                       Text="{Binding QueueSession.CurrentDateText}"
                       FontSize="12"
                       TextColor="#475569" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="more_vert"
                    FontFamily="MaterialIcons"
                    FontSize="20"
                    TextColor="#475569"
                    BackgroundColor="Transparent"
                    Padding="8"
                    Clicked="OnOptionsClicked"
                    SemanticProperties.Description="More options and reset queue" />
        </Grid>
        <ContentView Grid.Row="1"
                     x:Name="PageHost"
                     HorizontalOptions="Center"
                     MaximumWidthRequest="1560" />
        <Grid x:Name="MobileBottomNavigation"
              Grid.Row="2"
              IsVisible="False"
              HeightRequest="68"
              ColumnDefinitions="*,*,*"
              BackgroundColor="White">
            <BoxView HeightRequest="1"
                     Color="#E2E8F0"
                     VerticalOptions="Start"
                     Grid.ColumnSpan="3" />
            <Button x:Name="MobileOverviewButton"
                    Grid.Column="0"
                    Text="Overview"
                    FontSize="12"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0,6"
                    ContentLayout="Top,2"
                    Clicked="OnMobileOverviewClicked" />
            <Button x:Name="MobileTokensButton"
                    Grid.Column="1"
                    Text="Tokens"
                    FontSize="12"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0,6"
                    ContentLayout="Top,2"
                    Clicked="OnMobileTokensClicked" />
            <Button x:Name="MobileCountersButton"
                    Grid.Column="2"
                    Text="Counters"
                    FontSize="12"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    Padding="0,6"
                    ContentLayout="Top,2"
                    Clicked="OnMobileCountersClicked" />
        </Grid>
        <dialogs:DesktopPopupHost x:Name="DesktopPopupHost"
                                  Grid.RowSpan="3"
                                  IsVisible="False" />
        <dialogs:MobileBottomSheetHost x:Name="MobileBottomSheetHost"
                                       Grid.RowSpan="3"
                                       IsVisible="False" />
    </Grid>
</ContentPage>
