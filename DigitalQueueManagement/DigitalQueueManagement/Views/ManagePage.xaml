<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigitalQueueManagement.ViewModel"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="DigitalQueueManagement.Views.ManagePage"
             x:DataType="vm:ManagePageViewModel">
    <Grid RowDefinitions="Auto,*">
        <Grid x:Name="NavigationRow"
              Grid.Row="0"
              Margin="28,22,28,0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12">
            <Border Padding="4"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    VerticalOptions="Center">
                <buttons:SfSegmentedControl x:Name="SectionTabs"
                                           SegmentHeight="42"
                                           VisibleSegmentsCount="3"
                                           StrokeThickness="0"
                                           ShowSeparator="False"
                                           SegmentBackground="Transparent"
                                           SelectedIndex="{Binding QueueSession.ManageTabIndex, Mode=TwoWay}">
                    <buttons:SfSegmentedControl.TextStyle>
                        <buttons:SegmentTextStyle FontSize="12" TextColor="#64748B" />
                    </buttons:SfSegmentedControl.TextStyle>
                    <buttons:SfSegmentedControl.SelectionIndicatorSettings>
                        <buttons:SelectionIndicatorSettings SelectionIndicatorPlacement="Fill"
                                                            Background="#183E91"
                                                            TextColor="White" />
                    </buttons:SfSegmentedControl.SelectionIndicatorSettings>
                </buttons:SfSegmentedControl>
            </Border>
            <Border x:Name="OperationalStatus"
                    Grid.Column="1"
                    Padding="12,7"
                    BackgroundColor="White"
                    Stroke="#A7F3D0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="8"
                             HeightRequest="8"
                             Color="#10B981"
                             CornerRadius="4"
                             VerticalOptions="Center" />
                    <Label Text="Operational Hub · Local sample"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#334155"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
        <ScrollView Grid.Row="1">
            <ContentView x:Name="PageContentHost" />
        </ScrollView>
    </Grid>
</ContentView>
