<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SmartExpense"
             xmlns:converters="clr-namespace:SmartExpense"
             x:Class="SmartExpense.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <converters:ColorWithOpacityConverter x:Key="ColorWithOpacityConverter"/>
            <converters:TransactionAmountConverter x:Key="TransactionAmountConverter" />
            <converters:TransactionAmountColorConverter x:Key="TransactionAmountColorConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
