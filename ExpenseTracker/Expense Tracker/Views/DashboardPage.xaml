<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:input="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:core="clr-namespace:Syncfusion.Maui.Shimmer;assembly=Syncfusion.Maui.Core"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:listview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:converters="clr-namespace:SmartExpense;assembly=SmartExpense"
             xmlns:dashboard="clr-namespace:SmartExpense;assembly=SmartExpense"
             xmlns:popups="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             xmlns:local="clr-namespace:SmartExpense" 
             x:Class="SmartExpense.DashboardPage"
             x:DataType="dashboard:DashboardViewModel">

    <Shell.NavBarIsVisible>
        False
    </Shell.NavBarIsVisible>
    <Grid x:Name="DashboardRoot" BackgroundColor="#E4E9FF" >
        <Grid.Resources>
            <ResourceDictionary>
                <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
                <converters:StringToInitialsConverter x:Key="StringToInitialsConverter"/>
                <!-- Icon-only Tab Header -->
                <DataTemplate x:Key="IconTabHeaderTemplate" x:DataType="dashboard:NavItem">
                    <Border
                        Padding="8"
                        StrokeThickness="1"
                        BackgroundColor="Transparent"
                        Stroke="{Binding IsSelected, Converter={StaticResource BoolToBackgroundConverter}}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Image
                            Source="{Binding CurrentIcon}"
                            WidthRequest="22"
                            HeightRequest="22"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Border>
                </DataTemplate>
            </ResourceDictionary>
            <Style TargetType="listview:ListViewItem">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Background"
                                        Value="Transparent"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Background"
                                        Value= "Transparent"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Background"
                                        Value="Transparent"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="Background"
                                        Value="LightBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Tapped">
                                <VisualState.Setters>
                                    <Setter Property="Background"
                                            Value="LightBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </Grid.Resources>


        <!-- ================= MOBILE LAYOUT (MATCHES DASHBOARD FLOW) ================= -->

        <Grid RowDefinitions="Auto,*"
              IsVisible="{OnPlatform WinUI=False, Android=True, iOS=True, MacCatalyst=False}">

            <!-- ================= APP BAR ================= -->
            <Border BackgroundColor="#F5F7FA"
                    Grid.Row="0"
                    Padding="14,12">


                <Grid ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">

                    <!-- LEFT: TITLE -->
                    <Label Text="Dashboard"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#23264A"
                           VerticalTextAlignment="Center"/>

                    <!-- RIGHT: User initial avatar (tap to logout) -->
                    <Border Grid.Column="1"
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#8FD3C8"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>

                        <Label Text="{Binding UserInitial}"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="Black"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="16"
                                     Spacing="20">

                    <dashboard:DashboardInsightsView/>

                    <!-- ================= FINANCIAL OVERVIEW ================= -->
                        <Border Padding="20"
                                BackgroundColor="#F5F7FA"
                                Stroke="Transparent"
                                Grid.Row="0">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Opacity="0.08"
                                    Radius="6"
                                    Offset="0,2" />
                        </Border.Shadow>
                        <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                            <Label Text="Financial Overview"
                                   Style="{StaticResource TitleLabelStyle}"
                                   FontSize="16"
                                   Grid.Row="0"
                                   Padding="0,0,0,12"
                                   />
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

                                    <buttons:SfSegmentedControl 
                                                                Grid.Column="0"
                                                                HorizontalOptions="Start"
                                                                ItemsSource="{Binding FinancialSegments}"
                                                                SelectedIndex="{Binding SelectedCategorySegmentIndex, Mode=TwoWay}"
                                                                HeightRequest="46"
                                                                SegmentWidth="52"
                                                                Stroke="#2F6D86"
                                                                ShowSeparator="False">

                                        <buttons:SfSegmentedControl.SelectionIndicatorSettings>
                                            <buttons:SelectionIndicatorSettings
                                                SelectionIndicatorPlacement="Fill"
                                                Background="#2F6D86"
                                                TextColor="White"/>
                                        </buttons:SfSegmentedControl.SelectionIndicatorSettings>

                                    </buttons:SfSegmentedControl>


                                    <Grid Grid.Column="1" VerticalOptions="End" HorizontalOptions="End">

                                        <!-- ICON -->
                                        <Label 
                                            Text="&#xE72B;"
                                            FontFamily="ExpenseTrackerIcons"
                                            FontSize="33"
                                            HorizontalOptions="End"
                                            TextColor="#5F6368"/>

                                        <input:SfComboBox 
                                                VerticalOptions="Fill"
                                                Opacity="0.01"
                                                DropdownWidth="120"
                                                BackgroundColor="#F9FAFB"
                                                DropDownBackground="#FFFFFF"
                                                SelectionTextHighlightColor="#111827"
                                                SelectedDropDownItemBackground="#DBEAFE"
                                                ItemsSource="{Binding PeriodOptions}"
                                                SelectedItem="{Binding SelectedFinancialPeriod, Mode=TwoWay}"
                                                ShowBorder="False"
                                                IsClearButtonVisible="False"/>
                                    </Grid>

                                </Grid>

                                <Grid Grid.Row="2">
                                    <chart:SfCircularChart HeightRequest="360">
                                        <chart:SfCircularChart.Legend>
                                            <chart:ChartLegend Placement="Bottom"/>
                                        </chart:SfCircularChart.Legend>

                                        <chart:DoughnutSeries ItemsSource="{Binding FinancialCategoryBreakdown}"
                                                              XBindingPath="Category"
                                                              YBindingPath="Amount"
                                                              ShowDataLabels="True"
                                                              EnableAnimation="True"
                                                              InnerRadius="0.5"
                                                              LabelContext="Percentage"
                                                              PaletteBrushes="{Binding FinancialDoughnutPalette}">
                                            <chart:DoughnutSeries.DataLabelSettings>
                                                <chart:CircularDataLabelSettings UseSeriesPalette="False"
                                                                                 SmartLabelAlignment="Hide">

                                                </chart:CircularDataLabelSettings>
                                            </chart:DoughnutSeries.DataLabelSettings>


                                            <!-- CENTER VIEW -->
                                            <chart:DoughnutSeries.CenterView>
                                                <Label
                                                    Text="{Binding BindingContext.DoughnutCenterText, Source={x:Reference DashboardRoot}}"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    TextColor="#2F6D86"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    IsVisible="{Binding BindingContext.FinancialCategoryBreakdown.Count, Source={x:Reference DashboardRoot}, Converter={StaticResource IntToBoolConverter}}"/>
                                            </chart:DoughnutSeries.CenterView>

                                        </chart:DoughnutSeries>

                                    </chart:SfCircularChart>

                                    <Label IsVisible="{Binding FinancialCategoryBreakdown.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=Invert}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Text="No Records Found"/>
                                </Grid>
                            </Grid>
                        </Border>

                    <!-- ================= RECENT TRANSACTIONS ================= -->
                    <Border Grid.Column="1"
                            Padding="18"
                            HeightRequest="450"
                            BackgroundColor="#F5F7FA"
                            Stroke="Transparent"
                            Margin="0,0,0,0">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Opacity="0.08"
                                    Radius="6"
                                    Offset="0,2" />
                        </Border.Shadow>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            
                                <Label Grid.Row="0"
                                       Text="Recent Transactions"
                                       FontAttributes="Bold"
                                       FontSize="16"/>
                        
                                <listview:SfListView ItemsSource="{Binding RecentTransactionsPreview}"
                                                     AutoFitMode="Height"
                                                        Grid.Row="1"
                                                        IsScrollingEnabled="False"
                                                        ScrollBarVisibility="Never"
                                                        SelectionBackground="Transparent"
                                                        Background="Transparent"
                                                        BackgroundColor="Transparent"
                                                        SelectionMode="None"
                                                     >
                                    <listview:SfListView.ItemTemplate>
                                        <DataTemplate x:DataType="dashboard:TransactionDisplayItem">
                                            <VerticalStackLayout>
                                                <Grid Padding="8,10"
                                                      ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0"
                                                            HeightRequest="40"
                                                            WidthRequest="40"
                                                            BackgroundColor="{Binding IconBackground,Converter={StaticResource ColorWithOpacityConverter}, ConverterParameter=0.2}"
                                                            HorizontalOptions="Start">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="20"/>
                                                        </Border.StrokeShape>

                                                        <Label Text="{Binding IconGlyph}"
                                                               FontFamily="MaterialIcons"
                                                               FontSize="20"
                                                               TextColor="{Binding IconBackground}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>
                                                    </Border>

                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Spacing="2"
                                                                         Padding="12,0">
                                                        <Label Text="{Binding Title}"/>
                                                        <Label Text="{Binding Category}"
                                                               FontSize="12"
                                                               TextColor="#6B7280"/>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout Grid.Column="2"
                                                                         HorizontalOptions="End"
                                                                         Spacing="2">
                                                        <Label
                                                            Text="{Binding ., Converter={StaticResource TransactionAmountConverter}}"
                                                            TextColor="{Binding Type, Converter={StaticResource TransactionAmountColorConverter}}"
                                                            FontAttributes="Bold"
                                                            HorizontalOptions="End"/>
                                                        <Label Text="{Binding Date, StringFormat='{0:d}'}"
                                                               FontSize="12"
                                                               TextColor="#6B7280"
                                                               HorizontalOptions="End"/>
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <BoxView HeightRequest="1"
                                                         BackgroundColor="#1F92B8"
                                                         Opacity="0.25"
                                                         Margin="0,8,0,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </listview:SfListView.ItemTemplate>
                                </listview:SfListView>
                                <Label Grid.Row="1"
                                    Text="No Records Found"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding RecentTransactions.Count,
                                                            Converter={StaticResource IntToBoolConverter},
                                                            ConverterParameter=Invert}"/>
                   
                        </Grid>
                    </Border>

                    <!-- ================= ACCOUNT OVERVIEW ================= -->
                    <Border Padding="20"
                            Stroke="Transparent"
                            BackgroundColor="#F5F7FA">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Opacity="0.08"
                                    Radius="6"
                                    Offset="0,2" />
                        </Border.Shadow>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid
                              ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="12"
                              VerticalOptions="Center"
                              Padding="0,0,0,16">
                                <!-- LEFT: Title + Balance -->

                                <!-- Title -->
                                <Label
                                  Text="Account Overview"
                                  Padding="0,0,0,12"
                                  FontAttributes="Bold"
                                  FontSize="16"
                                  Grid.Column="0"
                                  Grid.Row="0"
                                  VerticalOptions="Center"
                                  TextColor="#23264A"/>
                                <!-- Balance -->
                                <Label  Grid.Column="0"
                                          Grid.Row="1"
                                          Text="{Binding TotalBalanceText, StringFormat='Balance : {0}'}"
                                          FontSize="16"
                                          Padding="0,0,0,16"
                                          TextColor="#6B7280"/>


                                <!-- Period Dropdown -->
                                <Grid Grid.Column="1" Grid.Row="1"
                                       HorizontalOptions="End"
                                       Padding="8,0,0,16"
                                       VerticalOptions="End">

                                    <!-- ICON -->
                                    <Label
                                         Text="&#xE72B;"
                                         FontFamily="ExpenseTrackerIcons"
                                         FontSize="33"
                                         HorizontalOptions="End"
                                         VerticalOptions="Center"
                                         TextColor="#5F6368"/>

                                    <input:SfComboBox
                                            VerticalOptions="End"
                                            Opacity="0.01"
                                            DropdownWidth="120"
                                            BackgroundColor="#F9FAFB"
                                            DropDownBackground="#FFFFFF"
                                            SelectionTextHighlightColor="#111827"
                                            SelectedDropDownItemBackground="#DBEAFE"
                                            ItemsSource="{Binding PeriodOptions}"
                                            SelectedItem="{Binding SelectedAccountPeriod, Mode=TwoWay}"
                                            ShowBorder="False"
                                            IsClearButtonVisible="False"/>
                                </Grid>
                            </Grid>
                            <Grid>
                                <chart:SfCartesianChart HeightRequest="350">
                                    <chart:SfCartesianChart.Legend>
                                        <chart:ChartLegend Placement="Bottom"/>
                                    </chart:SfCartesianChart.Legend>
                                    <chart:SfCartesianChart.XAxes>
                                        <chart:CategoryAxis  ShowMajorGridLines="False">
                                            <chart:CategoryAxis.LabelStyle>
                                                <chart:ChartAxisLabelStyle
                                                      FontSize="14"
                                                      FontAttributes="None"
                                                      Margin="0,0,6,0"/>
                                            </chart:CategoryAxis.LabelStyle>

                                        </chart:CategoryAxis>
                                    </chart:SfCartesianChart.XAxes>
                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis Minimum="0"
                                                               ShowMajorGridLines="True"
                                                               LabelCreated="OnYAxisLabelCreated">
                                            <chart:NumericalAxis.LabelStyle>
                                                <chart:ChartAxisLabelStyle
                                                          FontSize="14"
                                                          FontAttributes="None"/>
                                            </chart:NumericalAxis.LabelStyle>
                                            <chart:NumericalAxis.MajorTickStyle>
                                                <chart:ChartAxisTickStyle Stroke="Transparent"
                                                                        StrokeWidth="1"
                                                                        TickSize="10"/>
                                            </chart:NumericalAxis.MajorTickStyle>

                                        </chart:NumericalAxis>
                                    </chart:SfCartesianChart.YAxes>

                                    <!-- Income spline area (lighter, multi-stop gradient) -->
                                    <chart:SplineAreaSeries
                                              ItemsSource="{Binding MonthlyTrends}"
                                              XBindingPath="Month"
                                              YBindingPath="Income"
                                              Label="Income"
                                              EnableAnimation="True"
                                              StrokeWidth="2"
                                              Stroke="#2485FA">
                                        <chart:SplineAreaSeries.Fill>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="0,1">
                                                <GradientStop Color="#802485FA"
                                                              Offset="0.25"/>
                                                <GradientStop Color="#662485FA"
                                                              Offset="0.50"/>
                                                <GradientStop Color="#332485FA"
                                                              Offset="0.75"/>
                                                <GradientStop Color="#002485FA"
                                                              Offset="1.00"/>
                                            </LinearGradientBrush>
                                        </chart:SplineAreaSeries.Fill>
                                    </chart:SplineAreaSeries>

                                    <!-- Expense spline area (lighter, multi-stop gradient) -->
                                    <chart:SplineAreaSeries
                                          ItemsSource="{Binding MonthlyTrends}"
                                          XBindingPath="Month"
                                          YBindingPath="Expense"
                                          Label="Expense"
                                          EnableAnimation="True"
                                          StrokeWidth="2"
                                          Stroke="#CC4AE0">
                                        <chart:SplineAreaSeries.Fill>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="0,1">
                                                <GradientStop Color="#80CC4AE0"
                                                              Offset="0.25"/>
                                                <GradientStop Color="#66CC4AE0"
                                                              Offset="0.50"/>
                                                <GradientStop Color="#33CC4AE0"
                                                              Offset="0.75"/>
                                                <GradientStop Color="#00CC4AE0"
                                                              Offset="1.00"/>
                                            </LinearGradientBrush>
                                        </chart:SplineAreaSeries.Fill>
                                    </chart:SplineAreaSeries>
                                </chart:SfCartesianChart>
                                <Label
                                  Text="No Records Found"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  IsVisible="{Binding MonthlyTrends.Count,
                                  Converter={StaticResource IntToBoolConverter},
                                  ConverterParameter=Invert}"/>
                            </Grid>
                            <!-- Add Transaction button moved to header -->
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>


        <!-- Desktop layout (WinUI) - duplicate of mobile for now -->
        <Grid RowDefinitions="Auto,*"
              IsVisible="{OnPlatform WinUI=True,Android=False,iOS=False,MacCatalyst=True}">

            <!-- ================= DESKTOP APP BAR ================= -->
            <Border Grid.Row="0"
                    BackgroundColor="#F5F7FA"
                    Padding="20,9"
                    Margin="0,0,0,0">

                <Grid ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">
                    <!-- LEFT: APP TITLE -->
                    <Label
                        Text="Dashboard"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="Black"
                        VerticalTextAlignment="Center"/>

                    <!-- RIGHT: ACTION BUTTONS -->
                    <HorizontalStackLayout
                        Grid.Column="1"
                        Spacing="12"
                        VerticalOptions="Center">
                        <!-- ADD EXPENSE (desktop) -->
                        <Button Grid.Column="2"
                                Clicked="OnDesktopAddClicked"
                                HeightRequest="38"
                                Padding="14,6"
                                CornerRadius="20"
                                BackgroundColor="#2F6D86"
                                TextColor="White"
                                FontAttributes="Bold"
                                HorizontalOptions="Start">
                            <Button.Text>Add Transaction</Button.Text>
                        </Button>
                        <!-- User initial avatar (tap to logout) -->
                        <Border
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#8FD3C8"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <Ellipse WidthRequest="40"
                                         HeightRequest="40"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding UserInitial}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="Black"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20"
                                     Spacing="18">
                    <dashboard:DashboardInsightsView/>
                    <!-- ================= CHARTS ================= -->
                    <Grid x:Name="DesktopChartsGrid"
                          ColumnDefinitions="2*,1*"
                          ColumnSpacing="10">
                        <!-- FINANCIAL OVERVIEW  -->
                        <Grid x:Name="DesktopFinancialOverview"
                              Grid.Column="0"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*"
                              ColumnSpacing="0">
                            <Border Padding="20" Stroke="Transparent"
                                    BackgroundColor="#F5F7FA"
                                    Grid.Row="0">
                                <Border.Shadow>
                                    <Shadow Brush="#000000"
                                            Opacity="0.08"
                                            Radius="6"
                                            Offset="0,2" />
                                </Border.Shadow>

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="12">
                                        <Label Text="Financial Overview"
                                               Style="{StaticResource TitleLabelStyle}"
                                               FontSize="16"
                                               Grid.Row="0"
                                               Padding="0,0,0,12"
                                               Grid.Column="0"/>

                                        <HorizontalStackLayout Grid.Row="1"
                                                               Grid.Column="0"
                                                               Spacing="12"
                                                               VerticalOptions="Start">
                                            <buttons:SfSegmentedControl Grid.Row="0"
                                                                        Grid.Column="1"
                                                                        SelectedIndex="{Binding SelectedCategorySegmentIndex, Mode=TwoWay}"
                                                                        SelectionChanged="OnCategorySegmentSelectionChanged"
                                                                        SegmentWidth="85"
                                                                        Stroke="#2F6D86">
                                                <buttons:SfSegmentedControl.SelectionIndicatorSettings>
                                                    <buttons:SelectionIndicatorSettings SelectionIndicatorPlacement="Fill"
                                                                                        Background="#2F6D86"
                                                                                        TextColor="White"/>
                                                </buttons:SfSegmentedControl.SelectionIndicatorSettings>
                                                <buttons:SfSegmentedControl.ItemsSource>
                                                    <x:Array Type="{x:Type x:String}">
                                                        <x:String>Income</x:String>
                                                        <x:String>Expense</x:String>
                                                    </x:Array>
                                                </buttons:SfSegmentedControl.ItemsSource>
                                            </buttons:SfSegmentedControl>
                                        </HorizontalStackLayout>

                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Stroke="Gray"
                                            StrokeThickness="0.8"
                                            BackgroundColor="White"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="5"/>
                                            </Border.StrokeShape>

                                            <input:SfComboBox
                                                WidthRequest="170"
                                                HorizontalOptions="End"
                                                HeightRequest="40"
                                                BackgroundColor="#F9FAFB"
                                                DropDownBackground="#FFFFFF"
                                                SelectionTextHighlightColor="#111827"
                                                SelectedDropDownItemBackground="#DBEAFE"
                                                SelectedItem="{Binding SelectedFinancialPeriod, Mode=TwoWay}"
                                                SelectedIndex="{Binding SelectedFinancialPeriodIndex, Mode=TwoWay}"
                                                ShowBorder="False"
                                                IsClearButtonVisible="False"
                                                ItemsSource="{Binding PeriodOptions}"/>
                                        </Border>

                                    </Grid>

                                    <Grid>
                                        <chart:SfCircularChart HeightRequest="430">
                                            <chart:SfCircularChart.Resources>
                                                <DataTemplate x:Key="legendTemplate" x:DataType="{x:Null}">
                                                    <StackLayout WidthRequest="200"
                                                                 Orientation="Horizontal">
                                                        <Ellipse HeightRequest="12"
                                                                 WidthRequest="12"
                                                                 Margin="3"
                                                                 Background="{Binding IconBrush}"/>
                                                        <Label Padding="5,0,0,0"
                                                               Text="{Binding Text}"/>

                                                    </StackLayout>
                                                </DataTemplate>
                                            </chart:SfCircularChart.Resources>

                                            <chart:SfCircularChart.Legend>
                                                <chart:ChartLegend Placement="Right">
                                                    <chart:ChartLegend.ItemTemplate>
                                                        <DataTemplate x:DataType="{x:Null}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                                  Padding="6,4"
                                                                  ColumnSpacing="8">

                                                                <!-- Color dot (slice color) -->
                                                                <Ellipse
                                                                    WidthRequest="10"
                                                                    HeightRequest="10"
                                                                    VerticalOptions="Center"
                                                                    Fill="{Binding IconBrush}"/>

                                                                <!-- Category (X value) -->
                                                                <Label
                                                                    Grid.Column="1"
                                                                    Text="{Binding Text}"
                                                                    FontSize="13"
                                                                    TextColor="#374151"
                                                                    VerticalOptions="Center"/>

                                                                <!-- Amount (Y value) -->
                                                                <Label
                                                                    Grid.Column="2"
                                                                    Text="{Binding Value, StringFormat='${0:N0}'}"
                                                                    FontSize="13"
                                                                    TextColor="#374151"
                                                                    HorizontalOptions="End"
                                                                    VerticalOptions="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </chart:ChartLegend.ItemTemplate>
                                                </chart:ChartLegend>
                                            </chart:SfCircularChart.Legend>

                                            <chart:DoughnutSeries ItemsSource="{Binding FinancialCategoryBreakdown}"
                                                                  XBindingPath="Category"
                                                                  YBindingPath="Amount"
                                                                  ShowDataLabels="True"
                                                                  EnableAnimation="True"
                                                                  InnerRadius="0.5"
                                                                  LabelContext="Percentage"
                                                                  PaletteBrushes="{Binding FinancialDoughnutPalette}">
                                                <chart:DoughnutSeries.DataLabelSettings>
                                                    <chart:CircularDataLabelSettings UseSeriesPalette="False"
                                                                                     SmartLabelAlignment="Hide">
                                                    </chart:CircularDataLabelSettings>
                                                </chart:DoughnutSeries.DataLabelSettings>


                                                <!-- CENTER VIEW -->
                                                <chart:DoughnutSeries.CenterView>
                                                    <Label
                                                        Text="{Binding BindingContext.DoughnutCenterText, Source={x:Reference DashboardRoot}}"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="#2F6D86"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center"
                                                        IsVisible="{Binding BindingContext.FinancialCategoryBreakdown.Count, Source={x:Reference DashboardRoot}, Converter={StaticResource IntToBoolConverter}}"/>
                                                </chart:DoughnutSeries.CenterView>

                                            </chart:DoughnutSeries>

                                        </chart:SfCircularChart>

                                        <Label IsVisible="{Binding FinancialCategoryBreakdown.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=Invert}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Text="No Records Found"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- RECENT TRANSACTIONS -->
                        <Border  x:Name="DesktopRecentTransactions"
                                 Grid.Column="1"
                                 Padding="18"
                                 HeightRequest="{OnPlatform MacCatalyst=560}"
                                 BackgroundColor="#F5F7FA"
                                 Stroke="Transparent"
                                 Margin="0,0,0,0">
                            <Border.Shadow>
                                <Shadow Brush="#000000"
                                        Opacity="0.08"
                                        Radius="6"
                                        Offset="0,2" />
                            </Border.Shadow>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                    <Label Text="Recent Transactions" Grid.Row="0"
                                           FontAttributes="Bold"
                                           FontSize="16"/>

                                    <listview:SfListView ItemsSource="{Binding RecentTransactionsPreview}"
                                                         AutoFitMode="Height"
                                                         Grid.Row="1"
                                                         IsScrollingEnabled="False"
                                                         ScrollBarVisibility="Never"
                                                         SelectionBackground="Transparent"
                                                         Background="Transparent"
                                                         BackgroundColor="Transparent"
                                                         SelectionMode="None">
                                        <listview:SfListView.ItemTemplate>
                                            <DataTemplate x:DataType="dashboard:TransactionDisplayItem">
                                                <VerticalStackLayout>
                                                    <Grid Padding="8,10"
                                                          ColumnDefinitions="Auto,*,Auto">
                                                        <Border HeightRequest="40"
                                                                WidthRequest="40"
                                                                BackgroundColor="{Binding IconBackground,Converter={StaticResource ColorWithOpacityConverter}, ConverterParameter=0.2}"
                                                                HorizontalOptions="Start">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="20"/>
                                                            </Border.StrokeShape>

                                                            <Label Text="{Binding IconGlyph}"
                                                                   FontFamily="MaterialIcons"
                                                                   FontSize="20"
                                                                   TextColor="{Binding IconBackground}"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"/>
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="2"
                                                                             Padding="12,0">
                                                            <Label Text="{Binding Title}"/>
                                                            <Label Text="{Binding Category}"
                                                                   FontSize="14"
                                                                   TextColor="#6B7280"/>
                                                        </VerticalStackLayout>

                                                        <VerticalStackLayout Grid.Column="2"
                                                                             HorizontalOptions="End"
                                                                             Spacing="2">
                                                            <Label
                                                                Text="{Binding ., Converter={StaticResource TransactionAmountConverter}}"
                                                                TextColor="{Binding Type, Converter={StaticResource TransactionAmountColorConverter}}"
                                                                FontAttributes="Bold"
                                                                HorizontalOptions="End"/>
                                                            <Label Text="{Binding Date, StringFormat='{0:d}'}"
                                                                   FontSize="14"
                                                                   TextColor="#6B7280"
                                                                   HorizontalOptions="End"/>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                    <BoxView HeightRequest="1"
                                                             BackgroundColor="#1F92B8"
                                                             Opacity="0.25"
                                                             Margin="0,8,0,0"/>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </listview:SfListView.ItemTemplate>
                                    </listview:SfListView>
                                    <Label Grid.Row="1"
                                        Text="No Records Found"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding RecentTransactions.Count,
                                                            Converter={StaticResource IntToBoolConverter},
                                                            ConverterParameter=Invert}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Account OVERVIEW -->
                    <Border Padding="20"
                            Stroke="Transparent"
                            BackgroundColor="#F5F7FA">
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Opacity="0.08"
                                    Radius="6"
                                    Offset="0,2" />
                        </Border.Shadow>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="12"
                                VerticalOptions="Center"
                                Padding="0,0,0,12">
                                <!-- LEFT: Title + Balance -->

                                <!-- Title -->
                                <Label
                                    Text="Account Overview"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    VerticalOptions="Center"
                                    TextColor="{AppThemeBinding Light=#23264A, Dark=#F2F4FF}"/>
                                <!-- Balance -->
                                <Label  Grid.Column="0"
                                        Grid.Row="1"
                                        Text="{Binding TotalBalanceText, StringFormat='Balance : {0}'}"
                                        FontSize="16"
                                        TextColor="#6B7280"/>


                                <!-- RIGHT: Period ComboBox -->
                                <Border
                                    Grid.Column="1"
                                    Grid.Row="1"
                                    Stroke="Gray"
                                    StrokeThickness="0.8"
                                    BackgroundColor="White"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5"/>
                                    </Border.StrokeShape>
                                    <input:SfComboBox
                                        HeightRequest="40"
                                        WidthRequest="170"
                                        DropDownBackground="#FFFFFF"
                                        SelectionTextHighlightColor="#111827"
                                        SelectedDropDownItemBackground="#DBEAFE"
                                        BackgroundColor="#F9FAFB"
                                        ItemsSource="{Binding PeriodOptions}"
                                        SelectedItem="{Binding SelectedAccountPeriod, Mode=TwoWay}"
                                        SelectedIndex="{Binding SelectedAccountPeriodIndex, Mode=TwoWay}"
                                        ShowBorder="False"
                                        IsClearButtonVisible="False"/>
                                </Border>
                            </Grid>
                            <Grid>
                                <chart:SfCartesianChart HeightRequest="350">
                                    <chart:SfCartesianChart.Legend>
                                        <chart:ChartLegend Placement="Bottom"/>
                                    </chart:SfCartesianChart.Legend>
                                    <chart:SfCartesianChart.XAxes>
                                        <chart:CategoryAxis  ShowMajorGridLines="False">
                                            <chart:CategoryAxis.LabelStyle>
                                                <chart:ChartAxisLabelStyle
                                                    FontSize="14"
                                                    FontAttributes="None"
                                                    Margin="0,0,6,0"/>
                                            </chart:CategoryAxis.LabelStyle>

                                        </chart:CategoryAxis>
                                    </chart:SfCartesianChart.XAxes>
                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis Minimum="0"
                                                             ShowMajorGridLines="True"
                                                             LabelCreated="OnYAxisLabelCreated">
                                            <chart:NumericalAxis.LabelStyle>
                                                <chart:ChartAxisLabelStyle
                                                    FontSize="14"
                                                    FontAttributes="None"/>
                                            </chart:NumericalAxis.LabelStyle>
                                            <chart:NumericalAxis.MajorTickStyle>
                                                <chart:ChartAxisTickStyle Stroke="Transparent"
                                                                          StrokeWidth="1"
                                                                          TickSize="10"/>
                                            </chart:NumericalAxis.MajorTickStyle>

                                        </chart:NumericalAxis>
                                    </chart:SfCartesianChart.YAxes>
                                    
                                    <!-- Income spline area (lighter, multi-stop gradient) -->
                                    <chart:SplineAreaSeries
                                        ItemsSource="{Binding MonthlyTrends}"
                                        XBindingPath="Month"
                                        YBindingPath="Income"
                                        Label="Income"
                                        EnableAnimation="True"
                                        StrokeWidth="2"
                                        Stroke="#2485FA">
                                        <chart:SplineAreaSeries.Fill>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="0,1">
                                                <GradientStop Color="#802485FA"
                                                              Offset="0.25"/>
                                                <GradientStop Color="#662485FA"
                                                              Offset="0.50"/>
                                                <GradientStop Color="#332485FA"
                                                              Offset="0.75"/>
                                                <GradientStop Color="#002485FA"
                                                              Offset="1.00"/>
                                            </LinearGradientBrush>
                                        </chart:SplineAreaSeries.Fill>
                                    </chart:SplineAreaSeries>

                                    <!-- Expense spline area (lighter, multi-stop gradient) -->
                                    <chart:SplineAreaSeries
                                        ItemsSource="{Binding MonthlyTrends}"
                                        XBindingPath="Month"
                                        YBindingPath="Expense"
                                        Label="Expense"
                                        EnableAnimation="True"
                                        StrokeWidth="2"
                                        Stroke="#CC4AE0">
                                        <chart:SplineAreaSeries.Fill>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="0,1">
                                                <GradientStop Color="#80CC4AE0"
                                                              Offset="0.25"/>
                                                <GradientStop Color="#66CC4AE0"
                                                              Offset="0.50"/>
                                                <GradientStop Color="#33CC4AE0"
                                                              Offset="0.75"/>
                                                <GradientStop Color="#00CC4AE0"
                                                              Offset="1.00"/>
                                            </LinearGradientBrush>
                                        </chart:SplineAreaSeries.Fill>
                                    </chart:SplineAreaSeries>
                                </chart:SfCartesianChart>
                                <Label
                                    Text="No Records Found"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding MonthlyTrends.Count,
                                                        Converter={StaticResource IntToBoolConverter},
                                                        ConverterParameter=Invert}"/>
                            </Grid>
                            <!-- Add Transaction button moved to header -->
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ================= MOBILE FAB : ADD TRANSACTION ================= -->
        <Border
            IsVisible="{OnPlatform WinUI=False, Android=True, iOS=True, MacCatalyst=False}"
            BackgroundColor="#2F6D86"
            WidthRequest="56"
            HeightRequest="56"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28"/>
            </Border.StrokeShape>

            <Border.GestureRecognizers>
                <!-- SAME COMMAND AS DESKTOP -->
                <TapGestureRecognizer Command="{Binding NavigateToAddCommand}"/>
            </Border.GestureRecognizers>

            <!-- FAB ICON -->
            <Label
                Text="+"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Border>

        <!-- Desktop Add Transaction Popup (WinUI only). ContentTemplate is set from code-behind -->
        <popups:SfPopup
            x:Name="AddTransactionPopup"
            IsOpen="False"
            IsVisible="{OnPlatform WinUI=True, Android=False, iOS=False, MacCatalyst=True}"
            ShowHeader="False"
            ShowFooter="False"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            HeightRequest="590"
            WidthRequest="450">
        </popups:SfPopup>

    </Grid>
</ContentView>
