<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:pager="clr-namespace:Syncfusion.Maui.DataPager;assembly=Syncfusion.Maui.DataPager"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:input="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:syncfusion="http://schemas.syncfusion.com/maui"
             xmlns:converters="clr-namespace:SmartExpense;assembly=SmartExpense"
             xmlns:popups="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             x:Class="SmartExpense.TransactionsPage_Mobile">
    <ContentView.Resources>
        <Style TargetType="syncfusion:DataGridHeaderCell">
            <!-- No colored header background per reference -->
            <Setter Property="Background"
                 Value="Transparent"/>
            <Setter Property="TextColor"
                 Value="Black"/>
            <Setter Property="FontAttributes"
                 Value="Bold"/>
            <Setter Property="FontSize"
                 Value="14"/>
            <Setter Property="FontFamily"
                 Value="Aptos"/>
        </Style>
        <converters:IntEqualsConverter x:Key="IntEqualsConverter"/>
        <!-- Ensure row cell font family, size and vertical centering match design -->
        <Style TargetType="syncfusion:DataGridCell">
            <Setter Property="FontFamily"
                 Value="Aptos"/>
            <Setter Property="FontSize"
                 Value="14"/>
        </Style>
        <Style x:Key="ActionButtonStyle"
            TargetType="Button">
            <!-- Disabled state -->
            <Setter Property="BackgroundColor"
                 Value="#D3D3D3"/>
            <Setter Property="TextColor"
                 Value="White"/>
            <Setter Property="CornerRadius"
                 Value="12"/>
            <Setter Property="Padding"
                 Value="16,8"/>
            <Setter Property="WidthRequest"
                 Value="80"/>
            <Setter Property="HeightRequest"
                 Value="30"/>

            <Style.Triggers>
                <Trigger TargetType="Button"
                      Property="IsEnabled"
                      Value="True">
                    <!-- Enabled (blue) -->
                    <Setter Property="BackgroundColor"
                         Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="buttons:SfCheckBox">
            <Setter Property="CheckedColor"
                 Value="#2F6D86"/>
            <Setter Property="UncheckedColor"
                 Value="#9CA3AF"/>
            <Setter Property="TickColor"
                 Value="White"/>
        </Style>

        <!-- Cell template: income = light green pill, expense = light pink pill -->
        <DataTemplate x:Key="TypeCellTemplate">
            <Border Padding="8,4"
                 HorizontalOptions="Center"
                 VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Border BackgroundColor="{Binding Type, Converter={StaticResource TypeToColorConverter}}"
                     Stroke="#AAAAAA"
                     StrokeThickness="0.5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Label Text="{Binding Type}"
                        FontSize="12"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="8,2"/>
                </Border>
            </Border>
        </DataTemplate>
    </ContentView.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*" BackgroundColor="#E4E9FF" >

            <!-- ================= APP BAR ================= -->
            
            <Border Grid.Row="0"
                 BackgroundColor="#F9FAFB"
                 Padding="20,18"
                 Margin="0,0,0,0">
                <Grid>
                    <Grid ColumnDefinitions="*,Auto"
                       VerticalOptions="Center">
                        <!-- LEFT: APP TITLE -->
                        <Label
                         Text="Transaction"
                         FontSize="18"
                         FontAttributes="Bold"
                         TextColor="Black"
                         VerticalTextAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= Action Toolbar + Datagrid ================= -->
            <Grid Grid.Row="1"
               RowDefinitions="*"
               Padding="10">
                <Border Padding="20"
                     Grid.Row="1"
                     BackgroundColor="#F9FAFB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>
                    <Grid RowDefinitions="Auto,*,Auto"
                       ColumnDefinitions="*"
                       RowSpacing="12">
                        <Grid Grid.Row="0"  RowDefinitions="Auto,*"  
                               RowSpacing="12">
                            <buttons:SfSegmentedControl HorizontalOptions="Start"
                                                         IsVisible="{Binding ShowToolbar}"
                                                         Grid.Column="0"
                                                         SegmentWidth="{OnPlatform Android=97, iOS=112}"
                                                         WidthRequest="{OnPlatform iOS=360}"
                                                         HeightRequest="47"
                                                         SelectedIndex="{Binding SelectedSegmentIndex, Mode=TwoWay}"
                                                         Stroke="#2F6D86">
                                <buttons:SfSegmentedControl.SelectionIndicatorSettings>
                                    <buttons:SelectionIndicatorSettings SelectionIndicatorPlacement="Fill"
                                                                         Background="#2F6D86"
                                                                         TextColor="White"/>
                                </buttons:SfSegmentedControl.SelectionIndicatorSettings>
                                <buttons:SfSegmentedControl.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>All</x:String>
                                        <x:String>Income</x:String>
                                        <x:String>Expense</x:String>
                                    </x:Array>
                                </buttons:SfSegmentedControl.ItemsSource>
                            </buttons:SfSegmentedControl>

                            <Border IsVisible="{Binding HasSelection}"
                                     HeightRequest="47"
                                     Grid.Column="0"
                                     BackgroundColor="#F3F4F6">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="19"/>
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="Auto,Auto,*"
                                       ColumnSpacing="24"
                                       VerticalOptions="Center">

                                    <!--Close / clear selection-->
                                    <buttons:SfButton
                                         Text="✕"
                                         FontSize="14"
                                         BackgroundColor="Transparent"
                                         Background="Transparent"
                                         HeightRequest="32"
                                         WidthRequest="32"
                                         CornerRadius="25"
                                         TextColor="#374151"
                                         Command="{Binding ClearSelectionCommand}">
                                    </buttons:SfButton>

                                    <!--Selected count-->
                                    <Label
                                         Grid.Column="1"
                                         Text="{Binding SelectedCount, StringFormat='{}{0} Selected'}"
                                         FontSize="14"
                                         TextColor="#111827"
                                         VerticalOptions="Center"/>

                                    <!--Action icons-->
                                    <HorizontalStackLayout
                                         Grid.Column="2"
                                         Spacing="20"
                                         HorizontalOptions="End">
                                        <!--Mobile Edit (icon)-->
                                        <buttons:SfButton
                                             x:Name="EditButton_Mobile_Icon"
                                             Text="edit"
                                             FontFamily="MaterialIcons"
                                             FontSize="14"
                                             BackgroundColor="Transparent"
                                             Background="Transparent"
                                             HeightRequest="32"
                                             WidthRequest="32"
                                             CornerRadius="25"
                                             Clicked="OnEditClicked"
                                             TextColor="Black"
                                             IsVisible="{Binding SelectedCount, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"/>

                                        <!--Delete-->
                                        <buttons:SfButton
                                             Text="delete"
                                             FontFamily="MaterialIcons"
                                             FontSize="14"
                                             BackgroundColor="Transparent"
                                             Background="Transparent"
                                             HeightRequest="32"
                                             WidthRequest="32"
                                             CornerRadius="25"
                                             TextColor="Black"
                                             Command="{Binding DeleteSelectedMultipleCommand}">

                                        </buttons:SfButton>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" HorizontalOptions="Start" WidthRequest="33" >

                                <Label
                                    Text="&#xE72B;"
                                    FontFamily="ExpenseTrackerIcons"
                                    FontSize="33"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    TextColor="#5F6368"/>

                                <input:SfComboBox HorizontalOptions="Start"
                                        VerticalOptions="Fill"
                                        Opacity="0.01"
                                        DropdownWidth="120"
                                        BackgroundColor="#F9FAFB"
                                        DropDownBackground="#FFFFFF"
                                        SelectionTextHighlightColor="#111827"
                                        SelectedDropDownItemBackground="#DBEAFE"
                                        ItemsSource="{Binding PeriodOptions}"
                                        SelectedItem="{Binding SelectedFinancialPeriod, Mode=TwoWay}"
                                        SelectedIndex="{Binding SelectedAccountPeriodIndex, Mode=TwoWay}"
                                        ShowBorder="False"
                                        IsClearButtonVisible="False"/>
                            </Grid>

                            <!--<Grid Grid.Row="1"
                                  Padding="8,0,0,0"
                                  >

                                --><!-- ICON --><!--
                                <Label
                                    Text="&#xE72B;"
                                    FontFamily="ExpenseTrackerIcons"
                                    FontSize="33"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    TextColor="Black"/>

                                <input:SfComboBox HorizontalOptions="Start"
                                                   VerticalOptions="Fill"
                                                   Opacity="0.01"
                                                   DropdownWidth="120"
                                                   BackgroundColor="#F9FAFB"
                                                   DropDownBackground="#FFFFFF"
                                                   SelectionTextHighlightColor="#111827"
                                                   SelectedDropDownItemBackground="#DBEAFE"
                                                   ItemsSource="{Binding PeriodOptions}"
                                                   SelectedItem="{Binding SelectedFinancialPeriod, Mode=TwoWay}"
                                                   SelectedIndex="{Binding SelectedAccountPeriodIndex, Mode=TwoWay}"
                                                   ShowBorder="False"
                                                   IsClearButtonVisible="False"/>
                            </Grid>-->
                            <!-- Selection action bar (visible when items selected) -->
                        </Grid>
                        <Border Grid.Row="1"
                             Padding="0"
                             BackgroundColor="Transparent">
                            <Grid>

                                <!-- Styled Syncfusion DataGrid matching image layout -->
                                <datagrid:SfDataGrid Grid.Row="1"
                                                  x:Name="dataGrid"
                                                  ItemsSource="{Binding Source={x:Reference dataPager}, Path=PagedSource}"
                                                  SelectionMode="Multiple"
                                                  SelectedIndex="{Binding SelectedIndex}"
                                                  SelectedRow="{Binding SelectedTransaction}"
                                                  AutoGenerateColumnsMode="None"
                                                  RowHeight="62"
                                                  HeaderRowHeight="48"
                                                  GridLinesVisibility="Horizontal"
                                                  AllowEditing="True"
                                                  EnableDataVirtualization="True"
                                                  SelectionChanged="OnDataGridSelectionChanged"
                                                  CellValueChanged="OnDataGridCellValueChanged">

                                    <datagrid:SfDataGrid.DefaultStyle>
                                        <datagrid:DataGridStyle
                                         SelectionBackground="#D9E8F7"
                                         RowHoveredBackground="#EDF4FC"
                                         CurrentCellBorderColor="Transparent"/>
                                    </datagrid:SfDataGrid.DefaultStyle>

                                    <datagrid:SfDataGrid.Columns>
                                        <!-- Left checkbox column: header checkbox binds to ViewModel.AllVisibleSelected -->
                                        <datagrid:DataGridTemplateColumn Width="50"
                                                                      MappingName="IsSelected">
                                            <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <buttons:SfCheckBox IsChecked="{Binding BindingContext.AllVisibleSelected, Source={x:Reference dataGrid}, Mode=TwoWay}"/>
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                            <datagrid:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <buttons:SfCheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.CellTemplate>
                                        </datagrid:DataGridTemplateColumn>

                                        <datagrid:DataGridTextColumn HeaderText="Date"
                                                                  MappingName="Date"
                                                                  Format="dd-MMM-yyyy" Width="150"/>


                                        <!-- Combined Name column: primary title with category/subcategory beneath -->
                                        <datagrid:DataGridTemplateColumn HeaderText="Name" Width="150">
                                            <!-- Ensure header text is left-aligned to match design -->
                                            <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <Label Text="Name"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="Black"
                                                        HorizontalTextAlignment="Start"
                                                        VerticalTextAlignment="Center"
                                                        Margin="0,0"/>
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                            <datagrid:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <VerticalStackLayout Padding="0,4"
                                                                      Spacing="2">
                                                        <Label Text="{Binding Category}"
                                                            FontSize="14"
                                                            FontAttributes="None"
                                                            TextColor="#111827"/>
                                                        <Label Text="{Binding Title}"
                                                            FontSize="12"
                                                            TextColor="#6B7280"/>
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.CellTemplate>
                                        </datagrid:DataGridTemplateColumn>

                                        <datagrid:DataGridTemplateColumn HeaderText="Type" Width="100"
                                                                     >
                                            <datagrid:DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <Label Text="Type"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="Black"
                                                       HorizontalTextAlignment="Start"
                                                       VerticalTextAlignment="Center"
                                                       Margin="5,0"/>
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.HeaderTemplate>
                                            <datagrid:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border  HorizontalOptions="Start"
                                                          Stroke="Transparent"
                                                          VerticalOptions="Center" >
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="8"/>
                                                        </Border.StrokeShape>
                                                        <Border HorizontalOptions="Start" Stroke="#BBBBBB"
                                                              StrokeThickness="0.5">
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border"
                                                                          Binding="{Binding Type}"
                                                                          Value="Income">
                                                                    <Setter Property="BackgroundColor"
                                                                         Value="#D9FECF"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Border"
                                                                          Binding="{Binding Type}"
                                                                          Value="Expense">
                                                                    <Setter Property="BackgroundColor"
                                                                         Value="#FFD6D0"/>
                                                                </DataTrigger>
                                                            </Border.Triggers>

                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="4"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding Type}"
                                                                FontSize="14"
                                                                HorizontalTextAlignment="Start"
                                                                VerticalTextAlignment="Center"
                                                                Margin="8,2,8,4">
                                                                <Label.Triggers>
                                                                    <!-- ✅ Income text color -->
                                                                    <DataTrigger TargetType="Label"
                                                                              Binding="{Binding Type}"
                                                                              Value="Income">
                                                                        <Setter Property="TextColor"
                                                                             Value="#1F7A1F"/>
                                                                    </DataTrigger>
                                                                    <!-- ✅ Expense text color -->
                                                                    <DataTrigger TargetType="Label"
                                                                              Binding="{Binding Type}"
                                                                              Value="Expense">
                                                                        <Setter Property="TextColor"
                                                                             Value="#C62828"/>
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>
                                                        </Border>
                                                    </Border>
                                                </DataTemplate>
                                            </datagrid:DataGridTemplateColumn.CellTemplate>
                                        </datagrid:DataGridTemplateColumn>

                                        <datagrid:DataGridNumericColumn HeaderText="Amount"
                                                                     MappingName="Amount"
                                                                     Width="100"
                                                                     Format="C">
                                            <datagrid:DataGridNumericColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <Label Text="Amount"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="Black"
                                                       HorizontalTextAlignment="Start"
                                                       VerticalTextAlignment="Center"
                                                       Margin="0,0"/>
                                                </DataTemplate>
                                            </datagrid:DataGridNumericColumn.HeaderTemplate>
                                            <datagrid:DataGridNumericColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Label Text="{Binding Amount}"
                                                        VerticalTextAlignment="Center"
                                                        HorizontalTextAlignment="Start"
                                                         FontSize="14"
                                                         FontAttributes="None"
                                                         TextColor="#111827"/>
                                                </DataTemplate>
                                            </datagrid:DataGridNumericColumn.CellTemplate>
                                        </datagrid:DataGridNumericColumn>

                                        <!-- Remarks column: maps to `Notes` on the transaction model -->
                                        <datagrid:DataGridTextColumn HeaderText="Remarks"
                                                                 >
                                            <datagrid:DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <Label Text="Remarks"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="Black"
                                                        HorizontalTextAlignment="Start"
                                                        VerticalTextAlignment="Center"
                                                        Margin="0,0"/>
                                                </DataTemplate>
                                            </datagrid:DataGridTextColumn.HeaderTemplate>
                                            <datagrid:DataGridTextColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Label Text="{Binding Notes}"
                                                        VerticalTextAlignment="Center"
                                                        HorizontalTextAlignment="Start"
                                                         FontSize="14"
                                                         FontAttributes="None"
                                                         TextColor="#111827"/>
                                                </DataTemplate>
                                            </datagrid:DataGridTextColumn.CellTemplate>
                                        </datagrid:DataGridTextColumn>
                                    </datagrid:SfDataGrid.Columns>
                                </datagrid:SfDataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                             Padding="10">
                            <Grid  Padding="12">

                                <pager:SfDataPager
                                 x:Name="dataPager"
                                 PageSize="8"
                                 PageIndex="{Binding CurrentPageIndex, Mode=TwoWay}"
                                 NumericButtonsGenerateMode="Auto">
                                    <pager:SfDataPager.DefaultStyle>
                                        <pager:DataPagerStyle NumericButtonSelectionTextColor="White"
                                                           NumericButtonSelectionBackgroundColor="#2F6D86">
                                        </pager:DataPagerStyle>
                                    </pager:SfDataPager.DefaultStyle>
                                </pager:SfDataPager>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
        <Grid
         IsVisible="{Binding IsBusy}"
         BackgroundColor="#80000000"
         InputTransparent="False">

            <VerticalStackLayout
             HorizontalOptions="Center"
             VerticalOptions="Center"
             Spacing="12">

                <ActivityIndicator
                 IsRunning="True"
                 Color="White"
                 WidthRequest="40"
                 HeightRequest="40"/>

                <Label
                 Text="Loading transactions..."
                 TextColor="White"
                 FontSize="14"/>

            </VerticalStackLayout>
        </Grid>
        <!-- ================= MOBILE FAB : ADD TRANSACTION ================= -->
        <Border
            IsVisible="{OnPlatform WinUI=False, Android=True, iOS=True, MacCatalyst=False}"
            BackgroundColor="#2F6D86"
            WidthRequest="56"
            HeightRequest="56"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28"/>
            </Border.StrokeShape>

            <Border.GestureRecognizers>
                <!-- ✅ SAME COMMAND AS DESKTOP -->
                <TapGestureRecognizer Command="{Binding NavigateToAddCommand}"/>
            </Border.GestureRecognizers>

            <!-- FAB ICON -->
            <Label
                Text="+"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Border>
    </Grid>
</ContentView>
