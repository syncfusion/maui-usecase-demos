<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.EditNote.ViewModels"
             xmlns:syncfusionCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="Todo.Features.EditNote.Views.EditNotePage"
             x:DataType="vm:EditNoteViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalNotAnimated"
             BackgroundColor="#80000000">

    <Grid Padding="32"
          VerticalOptions="Center"
          HorizontalOptions="Center">

        <Border MaximumWidthRequest="480"
            WidthRequest="{OnIdiom Phone=340, Default=440}"
            MaximumHeightRequest="720"
                BackgroundColor="{StaticResource SurfaceColor}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="24">
            <Border.Shadow>
                <Shadow Brush="#33000000"
                        Radius="8"
                        Offset="0,4"
                        Opacity="0.20" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="12">

                <!-- Dialog title -->
                <Label Text="{Binding DialogTitle}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimaryColor}" />

                <!-- Title input -->
                <syncfusionCore:SfTextInputLayout Hint="Note title"
                                                  ContainerType="Outlined"
                                                  ShowHint="True">
                    <Entry Text="{Binding Title, Mode=TwoWay}"
                           FontSize="14"
                           TextColor="{StaticResource TextPrimaryColor}"
                           ReturnType="Done" />
                </syncfusionCore:SfTextInputLayout>

                <ScrollView MaximumHeightRequest="440">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="Due date" VerticalOptions="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding HasDueDate, Mode=TwoWay}" />
                        </Grid>
                        <DatePicker Date="{Binding DueDateSelection, Mode=TwoWay}"
                                    IsVisible="{Binding HasDueDate}"
                                    Format="dddd, MMMM d, yyyy" />

                        <Label Text="Repeat" FontAttributes="Bold" />
                        <Picker ItemsSource="{Binding RepeatOptions}"
                                SelectedItem="{Binding RepeatFrequency, Mode=TwoWay}"
                                Title="Select repeat frequency" />

                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="Reminder" VerticalOptions="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding HasReminder, Mode=TwoWay}" />
                        </Grid>
                        <DatePicker Date="{Binding ReminderDateSelection, Mode=TwoWay}"
                                    IsVisible="{Binding HasReminder}"
                                    Format="dddd, MMMM d, yyyy" />
                        <TimePicker Time="{Binding ReminderTimeSelection, Mode=TwoWay}"
                                    IsVisible="{Binding HasReminder}" />
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Action buttons -->
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="12"
                      HorizontalOptions="End"
                      Margin="0,8,0,0">
                        <buttons:SfButton Grid.Column="1"
                            Text="Cancel"
                            Style="{StaticResource TextButtonStyle}"
                            Command="{Binding CancelCommand}"
                            MinimumWidthRequest="96" />
                    <buttons:SfButton Grid.Column="2"
                            Text="{Binding PrimaryButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}"
                            MinimumWidthRequest="96" />
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
