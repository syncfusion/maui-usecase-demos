<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.EditNote.ViewModels"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
             xmlns:syncfusionCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="Todo.Features.EditNote.Views.EditNotePage"
             x:DataType="vm:EditNoteViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalNotAnimated"
             BackgroundColor="#80000000">

    <Grid Padding="24" VerticalOptions="Center" HorizontalOptions="Center">
        <Border WidthRequest="372"
                MaximumHeightRequest="560"
                BackgroundColor="{AppThemeBinding Light={StaticResource PopupSurfaceColor}, Dark={StaticResource PopupSurfaceDarkColor}}"
                Stroke="{AppThemeBinding Light={StaticResource PopupStrokeColor}, Dark={StaticResource PopupStrokeDarkColor}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 27"
                Padding="20">
            <Border.Shadow>
                <Shadow Brush="#40000000" Radius="16" Offset="0,8" Opacity="0.18" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,1,*,1,Auto">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="{Binding DialogTitle}"
                           FontFamily="{StaticResource FontFamilySemibold}"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light=#49454F, Dark=#E6E1E5}"
                           VerticalOptions="Center" />
                    <buttons:SfButton Grid.Column="1"
                                      Text="&#xe5cd;"
                                      FontFamily="MaterialIconRegular"
                                      WidthRequest="40"
                                      HeightRequest="40"
                                      Padding="0"
                                      BackgroundColor="Transparent"
                                      TextColor="White"
                                      FontSize="18"
                                      Command="{Binding CancelCommand}" />
                </Grid>

                <BoxView Grid.Row="1"
                         HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource PopupDividerColor}, Dark={StaticResource PopupDividerDarkColor}}"
                         Margin="0,10" />

                <ScrollView Grid.Row="2" Margin="0" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="44,*,40" ColumnSpacing="10" VerticalOptions="Center">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding HasDueDate, Mode=TwoWay}"
                                      Color="{StaticResource PrimaryColor}"
                                      VerticalOptions="Center"
                                      HorizontalOptions="Center" />
                            <Border Grid.Column="1"
                                    Padding="0"
                                    StrokeThickness="0"
                                    BackgroundColor="Transparent">
                                <Entry Text="{Binding Title, Mode=TwoWay}"
                                       FontSize="16"
                                       FontFamily="{StaticResource FontFamilySemibold}"
                                       BackgroundColor="Transparent"
                                       VerticalTextAlignment="Center"
                                       Margin="0"
                                       TextColor="{AppThemeBinding Light=#49454F, Dark=#E6E1E5}" />
                            </Border>
                            <buttons:SfButton Grid.Column="2"
                                              Text="★"
                                              WidthRequest="40"
                                              HeightRequest="40"
                                              Padding="0"
                                              Background="Transparent"
                                              FontSize="18"
                                              TextColor="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryLightColor}}"
                                              Command="{Binding ToggleImportantCommand}" />
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Border Padding="0"
                                    StrokeThickness="0"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleDueDatePickerCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Text="&#xe24f;" FontFamily="MaterialIconRegular" FontSize="18" TextColor="{StaticResource PrimaryColor}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" WidthRequest="18" HeightRequest="18" />
                                    <Border Grid.Column="1"
                                            Padding="12,8"
                                            Stroke="{StaticResource ChipStrokeColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{StaticResource ChipBackgroundColor}">
                                        <Label Text="{Binding DueDateSelection, Converter={StaticResource DateTimeFormatConverter}, ConverterParameter=date}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light=#49454F, Dark=#E6E1E5}"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <picker:SfDateTimePicker IsVisible="{Binding IsDueDatePickerVisible}"
                                                 SelectedDate="{Binding DueDateSelection, Mode=TwoWay}"
                                                 DateFormat="dd_MMM_yyyy"
                                                 HeightRequest="220" />

                            <Border Padding="0"
                                    StrokeThickness="0"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleRepeatPickerCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Text="&#xe040;" FontFamily="MaterialIconRegular" FontSize="18" TextColor="{StaticResource PrimaryColor}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" WidthRequest="18" HeightRequest="18" />
                                    <Border Grid.Column="1"
                                            Padding="12,8"
                                            Stroke="{StaticResource ChipStrokeColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{StaticResource ChipBackgroundColor}">
                                        <Label Text="{Binding RepeatFrequency, Converter={StaticResource EnumDisplayNameConverter}}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light=#49454F, Dark=#E6E1E5}"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Picker IsVisible="{Binding IsRepeatPickerVisible}"
                                    ItemsSource="{Binding RepeatOptions}"
                                    SelectedItem="{Binding RepeatFrequency, Mode=TwoWay}"
                                    HeightRequest="44"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2B2B2B}"
                                    TextColor="{AppThemeBinding Light=#49454F, Dark=#E6E1E5}" />

                            <Border Padding="0"
                                    StrokeThickness="0"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleReminderPickerCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Text="&#xe7f5;" FontFamily="MaterialIconRegular" FontSize="18" TextColor="{StaticResource PrimaryColor}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" WidthRequest="18" HeightRequest="18" />
                                    <Border Grid.Column="1"
                                            Padding="12,8"
                                            Stroke="{StaticResource ChipStrokeColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{StaticResource ChipBackgroundColor}">
                                        <Label Text="{Binding ReminderDateSelection, Converter={StaticResource DateTimeFormatConverter}, ConverterParameter=datetime}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light=#49454F, Dark=#E6E1E5}"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <VerticalStackLayout IsVisible="{Binding IsReminderPickerVisible}" Spacing="6">
                                <picker:SfDateTimePicker SelectedDate="{Binding ReminderDateSelection, Mode=TwoWay}" DateFormat="dd_MMM_yyyy" HeightRequest="220" />
                                <TimePicker Time="{Binding ReminderTimeSelection, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light=#49454F, Dark=#E6E1E5}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <BoxView Grid.Row="3"
                         HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource PopupDividerColor}, Dark={StaticResource PopupDividerDarkColor}}"
                         Margin="0,10" />

                <Grid Grid.Row="4" Margin="0,10,0,0"  ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    
                    <Label Grid.Column="0"
                           Text="{Binding CreatedAgeText}"
                           IsVisible="{Binding HasCreatedInfo}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource PopupTextSecondaryColor}, Dark={StaticResource PopupTextSecondaryDarkColor}}"
                           VerticalOptions="Center" />
                    <buttons:SfButton Grid.Column="1"
                                      Text="Cancel"
                                      BackgroundColor="Transparent"
                                      TextColor="White"
                                      HeightRequest="36"
                                      MinimumWidthRequest="72"
                                      CornerRadius="8"
                                      Command="{Binding CancelCommand}" />
                    <buttons:SfButton Grid.Column="3"
                                      Text="{Binding PrimaryButtonText}"
                                      BackgroundColor="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}"
                                      TextColor="White"
                                      HeightRequest="36"
                                      MinimumWidthRequest="72"
                                      CornerRadius="8"
                                      Command="{Binding SaveCommand}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="White" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#7633DA, Dark=#8D4CF5}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </buttons:SfButton>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>