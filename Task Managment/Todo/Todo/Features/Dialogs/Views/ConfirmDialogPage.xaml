<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Dialogs.ViewModels"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="Todo.Features.Dialogs.Views.ConfirmDialogPage"
             x:DataType="vm:ConfirmDialogViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalNotAnimated"
             BackgroundColor="#80000000">

    <Grid Padding="24" VerticalOptions="Center" HorizontalOptions="Center">
        <Border WidthRequest="{OnIdiom Phone=300, Default=320}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PopupSurfaceColor}, Dark={StaticResource PopupSurfaceDarkColor}}"
                Stroke="{AppThemeBinding Light={StaticResource PopupStrokeColor}, Dark={StaticResource PopupStrokeDarkColor}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 27"
                Padding="20">
            <Border.Shadow>
                <Shadow Brush="#4D000000" Radius="6" Offset="0,2" Opacity="1" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="14">
                <Label Text="{Binding Title}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light={StaticResource PopupTextPrimaryColor}, Dark={StaticResource PopupTextPrimaryDarkColor}}" />

                <Label Text="{Binding Message}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource PopupTextSecondaryColor}, Dark={StaticResource PopupTextSecondaryDarkColor}}" />

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" HorizontalOptions="End" Margin="0,8,0,0">
                    <buttons:SfButton Grid.Column="1"
                                      Text="{Binding CancelText}"
                                      Background="Transparent"
                                      TextColor="#6750A4"
                                      HeightRequest="36"
                                      MinimumWidthRequest="72"
                                      CornerRadius="8"
                                      Command="{Binding CancelCommand}" />
                    <buttons:SfButton Grid.Column="2"
                                      Text="{Binding ConfirmText}"
                                      Background="Transparent"
                                      TextColor="#6750A4"
                                      HeightRequest="36"
                                      MinimumWidthRequest="72"
                                      CornerRadius="8"
                                      Command="{Binding ConfirmCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>