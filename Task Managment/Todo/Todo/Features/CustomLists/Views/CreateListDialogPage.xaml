<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Todo.Features.CustomLists.Models"
             xmlns:vm="clr-namespace:Todo.Features.CustomLists.ViewModels"
             xmlns:syncfusionCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="Todo.Features.CustomLists.Views.CreateListDialogPage"
             x:DataType="vm:CreateListDialogViewModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalNotAnimated"
             BackgroundColor="#80000000">

    <Grid Padding="32"
          VerticalOptions="Center"
          HorizontalOptions="Center">

        <Border MaximumWidthRequest="420"
                WidthRequest="{OnIdiom Phone=320, Default=380}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PopupSurfaceColor}, Dark={StaticResource PopupSurfaceDarkColor}}"
                Stroke="{AppThemeBinding Light={StaticResource PopupStrokeColor}, Dark={StaticResource PopupStrokeDarkColor}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 27"
                Padding="20">
            <Border.Shadow>
                <Shadow Brush="#4D000000"
                        Radius="6"
                        Offset="0,2"
                        Opacity="1" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="16">
                <Label Text="{Binding DialogTitle}"
                       FontSize="22"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColor}, Dark={StaticResource TextPrimaryDarkColor}}" />

                <!-- Selected icon preview + name input -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                            VerticalOptions="Center"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{AppThemeBinding Light=#ECE6F0, Dark=#36343B}"
                            SemanticProperties.Description="Choose list icon">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleIconPickerCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Label Text="{Binding SelectedIcon}" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding HasSelectedIcon}" />
                            <Image Source="notesicon.png" WidthRequest="20" HeightRequest="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding HasNoSelectedIcon}" />
                        </Grid>
                    </Border>
                    <syncfusionCore:SfTextInputLayout Grid.Column="1"
                                                      Hint="List name"
                                                      ContainerType="Outlined"
                                                      ContainerBackground="Transparent"
                                                      OutlineCornerRadius="4"
                                                      FocusedStrokeThickness="1"
                                                      UnfocusedStrokeThickness="1"
                                                      ReserveSpaceForAssistiveLabels="False"
                                                      InputViewPadding="12,0"
                                                      EnableFloating="False"
                                                      ShowHelperText="False"
                                                      ShowHint="True"
                                                      HorizontalOptions="Fill">
                        <Entry Text="{Binding ListName, Mode=TwoWay}"
                               Placeholder=""
                               FontFamily="{StaticResource FontFamilyRegular}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColor}, Dark={StaticResource TextPrimaryDarkColor}}"
                               VerticalTextAlignment="Center"
                               HeightRequest="44"
                               BackgroundColor="Transparent" />
                    </syncfusionCore:SfTextInputLayout>
                </Grid>

                <!-- Icon picker -->
                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignContent="Start" AlignItems="Start"
                            IsVisible="{Binding IsIconPickerOpen}"
                            BindableLayout.ItemsSource="{Binding Icons}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ListIconOption">
                            <Grid WidthRequest="48" HeightRequest="48" Margin="0,0,2,2">
                            <Border WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                    BackgroundColor="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#D0BCFF, Dark=#5A5470}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8DEF8, Dark=#4A4458}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateListDialogViewModel}}, Path=SelectIconCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Glyph}" FontSize="20"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="{Binding ErrorMessage}"
                       FontSize="12"
                       TextColor="{StaticResource ErrorColor}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBoolConverter}}" />

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,8,0,0">
                    <buttons:SfButton Grid.Column="1" Text="Cancel" Background="Transparent" TextColor="#6750A4"
                                      Command="{Binding CancelCommand}" HeightRequest="36" MinimumWidthRequest="72" CornerRadius="8" />
                    <buttons:SfButton Grid.Column="2" Text="{Binding PrimaryButtonText}" Background="Transparent" TextColor="#6750A4"
                                      Command="{Binding CreateCommand}" HeightRequest="36" MinimumWidthRequest="72" CornerRadius="8" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>