<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:views="clr-namespace:Todo.Features.Notes.Views"
             x:Class="Todo.Features.Notes.Views.MainLayoutView"
             x:DataType="vm:NotesListViewModel">

    <Grid x:Name="RootGrid"
          Margin="{OnIdiom Phone=0, Default='0,10,0,0'}"
          RowDefinitions="{OnIdiom Phone='56,*', Default='60,*'}"
          ColumnDefinitions="{OnIdiom Phone='0,*', Default='220,*'}"
          Background="{AppThemeBinding Light=#F7F2FB, Dark={StaticResource BackgroundDarkColor}}">

        <Border x:Name="PageBackgroundHost"
                Grid.Row="{OnIdiom Phone=0, Default=1}"
                Grid.RowSpan="{OnIdiom Phone=2, Default=1}"
                Grid.Column="{OnIdiom Phone=0, Default=1}"
                Grid.ColumnSpan="{OnIdiom Phone=2, Default=1}"
                Margin="{OnIdiom Phone=0, Default='12'}"
                Padding="0"
                StrokeThickness="0"
                StrokeShape="{OnIdiom Phone='RoundRectangle 0', Default='RoundRectangle 14'}"
                IsVisible="{Binding Source={x:Reference PageBackgroundImage}, Path=IsVisible}"
                InputTransparent="True">
            <Image x:Name="PageBackgroundImage"
                   Source="{Binding BackgroundImage}"
                   IsVisible="False"
                   Aspect="AspectFill"
                   InputTransparent="True" />
        </Border>

        <!-- Shared application header (spans both columns) -->
        <views:HeaderView x:Name="Header"
                          Grid.Row="0"
                          Grid.ColumnSpan="2"
                          ZIndex="{OnIdiom Phone=0, Default=10}" />

        <BoxView x:Name="HeaderDivider"
                 Grid.Row="0"
                 Grid.ColumnSpan="2"
                 HeightRequest="1"
                 ZIndex="20"
                 InputTransparent="True"
                 VerticalOptions="End"
                 Color="#CAC4D0" />

        <!-- Sidebar (hides on Phone per collapsed.png) -->
        <views:SidebarView x:Name="Sidebar"
                           Grid.Row="1"
                           Grid.Column="0" />

        <!-- Main content area (consumes the freed space when sidebar collapses) -->
        <ContentView x:Name="MainContent"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="{OnIdiom Phone=0, Default='12'}" />

    </Grid>

</ContentView>
