<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:views="clr-namespace:Todo.Features.Notes.Views"
             x:Class="Todo.Features.Notes.Views.MainLayoutView"
             x:DataType="vm:NotesListViewModel">

    <Grid x:Name="RootGrid"
          Margin="{OnIdiom Phone=0, Default='0,10,0,0'}"
          RowDefinitions="{OnIdiom Phone='56,*', Default='60,*'}"
          ColumnDefinitions="{OnIdiom Phone='0,*', Default='220,*'}"
          Background="{OnIdiom Phone={AppThemeBinding Light=White, Dark={StaticResource BackgroundDarkColor}}, Default={AppThemeBinding Light=#F7F2FB, Dark={StaticResource BackgroundDarkColor}}}">

        <!-- Shared application header (spans both columns) -->
        <views:HeaderView x:Name="Header"
                          Grid.Row="0"
                          Grid.ColumnSpan="2" />

        <BoxView x:Name="HeaderDivider"
                 Grid.Row="0"
                 Grid.ColumnSpan="2"
                 HeightRequest="1"
                 VerticalOptions="End"
                 Color="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerDarkColor}}" />

        <!-- Sidebar (hides on Phone per collapsed.png) -->
        <views:SidebarView x:Name="Sidebar"
                           Grid.Row="1"
                           Grid.Column="0" />

        <!-- Main content area (consumes the freed space when sidebar collapses) -->
        <ContentView x:Name="MainContent"
                     Grid.Row="1"
                     Grid.Column="1" />

    </Grid>

</ContentView>
