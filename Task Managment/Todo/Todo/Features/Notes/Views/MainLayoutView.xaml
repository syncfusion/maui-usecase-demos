<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:views="clr-namespace:Todo.Features.Notes.Views"
             x:Class="Todo.Features.Notes.Views.MainLayoutView"
             x:DataType="vm:NotesListViewModel">

    <!--
        Module-08 task 8-1 (responsive layout pass):
        - The grid has TWO columns: the sidebar on the left and the
          main content on the right. The sidebar column collapses to
          0 on Phone (matches collapsed.png) and stays at 220 on
          Tablet/Desktop (matches the expanded sidebar in
          mynotes.png). The hamburger button in the header can still
          toggle the column manually on any device.
    -->
    <Grid x:Name="RootGrid"
          Margin="0,10,0,0"
          RowDefinitions="50,*"
          ColumnDefinitions="{OnIdiom Phone='0,*', Default='220,*'}"
          BackgroundColor="{StaticResource BackgroundColor}">

        <!-- Shared application header (spans both columns) -->
        <views:HeaderView Grid.Row="0"
                          Grid.ColumnSpan="2" />

        <!-- Sidebar (hides on Phone per collapsed.png) -->
        <views:SidebarView x:Name="Sidebar"
                           Grid.Row="1"
                           Grid.Column="0" />

        <!-- Main content area (consumes the freed space when sidebar collapses) -->
        <ContentView x:Name="MainContent"
                     Grid.Row="1"
                     Grid.Column="1" />

        <Border Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          IsVisible="{Binding IsToastVisible}"
          Padding="16,10"
          Margin="16,0,16,20"
          HorizontalOptions="Center"
          VerticalOptions="End"
          BackgroundColor="{StaticResource TextPrimaryColor}"
          StrokeThickness="0"
          StrokeShape="RoundRectangle 8">
            <Label Text="{Binding ToastMessage}"
             TextColor="{StaticResource SurfaceColor}"
             FontAttributes="Bold" />
        </Border>
    </Grid>

</ContentView>
