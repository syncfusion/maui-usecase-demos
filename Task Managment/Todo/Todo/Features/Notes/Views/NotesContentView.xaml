<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:models="clr-namespace:Todo.Features.Notes.Models"
             xmlns:common="clr-namespace:Todo.Common"
             xmlns:conv="clr-namespace:Todo.Converters"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
             xmlns:syncfusionCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:noteViews="clr-namespace:Todo.Features.Notes.Views"
             x:Class="Todo.Features.Notes.Views.NotesContentView"
             x:Name="NotesContentRoot"
             x:DataType="vm:NotesListViewModel"
             Padding="16">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- Module-07 converters used by the drag-and-drop visuals. -->
            <conv:MultiplyByConverter x:Key="MultiplyByConverter" />
            <conv:DragStateColorConverter x:Key="DragStateColorConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border BackgroundColor="{Binding ListBackgroundColor}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 14">
        <Grid RowDefinitions="Auto,*,Auto">

            <Image Grid.RowSpan="3"
                   Source="{Binding BackgroundImage}"
                   IsVisible="{Binding HasBackgroundImage}"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   InputTransparent="True" />
            <!-- Page title bar inside the content area -->
            <Grid Grid.Row="0"
                  Padding="20,14"
                  ColumnDefinitions="Auto,*,Auto">
                <HorizontalStackLayout Grid.Column="0"
                                       Spacing="10"
                                       VerticalOptions="Center">
                    <Image WidthRequest="20" HeightRequest="20" Aspect="AspectFit"
                           VerticalOptions="Center">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.MyNotes}">
                                <Setter Property="Source" Value="profileiconmain.png" />
                            </DataTrigger>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Important}">
                                <Setter Property="Source" Value="importanticon.png" />
                            </DataTrigger>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Reminder}">
                                <Setter Property="Source" Value="belliconsidebar.png" />
                            </DataTrigger>
                            <DataTrigger TargetType="Image" Binding="{Binding SelectedCategory}" Value="{x:Static common:NotesListCategory.Bin}">
                                <Setter Property="Source" Value="binicon.png" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <Label Text="{Binding HeaderTitle}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{Binding HeaderForegroundColor}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RenameSelectedListCommand}" />
                        </Label.GestureRecognizers>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Disabled" />
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Opacity" Value="0.78" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Label>
                </HorizontalStackLayout>
                <buttons:SfButton Grid.Column="2"
                        Text="&#8943;"
                        FontSize="22"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0" Rotation="90"
                        Background="Transparent"
                        TextColor="{Binding HeaderForegroundColor}"
                        Clicked="OnListOptionsClicked"
                        SemanticProperties.Description="More list options" />
            </Grid>

            <!-- Notes list / empty state -->
            <Grid Grid.Row="1">

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding ShowEmptyNotesState}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12">
                    <Image Source="notesicon.png"
                           WidthRequest="56"
                           HeightRequest="56"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding EmptyStateTitle}"
                           Style="{StaticResource EmptyStateMessageStyle}"
                           TextColor="{Binding HeaderForegroundColor}"
                           HorizontalTextAlignment="Center">
                    </Label>
                    <Label Text="{Binding EmptyStateMessage}"
                           Style="{StaticResource EmptyStateMessageStyle}"
                           TextColor="{Binding HeaderForegroundColor}"
                           HorizontalTextAlignment="Center">
                    </Label>
                </VerticalStackLayout>

                <!-- Module-07 task 7-1: gap-highlight bar that appears
                     at the in-list drop position while the user is
                     dragging (draganddrop.png shows the gap below the
                     lifted card). The bar is positioned via a
                     TranslateY that follows DropGapIndex. -->
                <BoxView IsVisible="{Binding IsDragging}"
                         HeightRequest="3"
                         Margin="16,0"
                         Color="{StaticResource PrimaryColor}"
                         VerticalOptions="Start"
                         HorizontalOptions="Fill"
                         TranslationY="{Binding DropGapIndex, Converter={StaticResource MultiplyByConverter}, ConverterParameter=70}">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView"
                                     Binding="{Binding DropGapIndex}"
                                     Value="-1">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>

                <!-- Module-07 task 7-2: drag-mode hint banner that
                     explains where the user can drop the card. -->
                <Border IsVisible="{Binding IsDragging}"
                        Margin="16,8"
                        Padding="10,6"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        HorizontalOptions="Fill"
                        VerticalOptions="Start">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="&#9776;"
                               FontSize="14"
                               TextColor="{StaticResource OnPrimaryColor}"
                               VerticalOptions="Center" />
                        <Label Text="Dragging — drop on a list to move, or release here to reorder"
                               FontSize="12"
                               TextColor="{StaticResource OnPrimaryColor}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Notes list (Syncfusion SfListView) -->
                    <Grid RowDefinitions="*,Auto"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                    <syncfusion:SfListView Grid.Row="0" ItemsSource="{Binding ActiveNotes}"
                                   IsVisible="{Binding HasActiveNotes}"
                                   ItemSpacing="0" ItemSize="76"
                                   BackgroundColor="Transparent"
                                   SelectionMode="SingleDeselect"
                                   ItemDragging="OnItemDragging">
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Note">
                            <Border Margin="16,6"
                                    Padding="14,10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceDarkColor}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Shadow="{StaticResource Elevation1}">
                                <!-- Module-07 task 7-1 (draganddrop.png):
                                     when this card is the one being
                                     dragged, apply a stronger tint to
                                     give the "lifted" affordance the
                                     design shows. The MultiBinding
                                     combines the note's Id with the
                                     parent ViewModel's DraggingNoteId
                                     and a DragStateColorConverter to
                                     pick the right color. -->
                                <Border.GestureRecognizers>
                                    <!-- Tap on the card body opens the
                                         EditNote dialog. The inner
                                         CheckBox / Star / more button
                                         handle their own gestures and
                                         don't bubble up. -->
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference NotesContentRoot}, Path=BindingContext.EditNoteCommand}"
                                        CommandParameter="{Binding .}" />
                                    <TapGestureRecognizer Buttons="Secondary"
                                                          Tapped="OnNoteSecondaryTapped" />
                                    <!-- Module-07 task 7-2: a long-press
                                         starts a MAUI drag so the card can
                                         be dropped on a sidebar entry to
                                         move it to another list. -->
                                    <DragGestureRecognizer
                                        CanDrag="True"
                                        DragStarting="OnNoteDragStarting"
                                        DropCompleted="OnNoteDropCompleted" />
                                </Border.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="Opacity" Value="0.88" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="40,*,40,40"
                                      ColumnSpacing="8"
                                      VerticalOptions="Center">
                                    <BoxView Grid.ColumnSpan="4"
                                             InputTransparent="True">
                                        <BoxView.Color>
                                            <MultiBinding Converter="{StaticResource DragStateColorConverter}"
                                                          ConverterParameter="#00000000|#EEEAFB|#00000000|#383442">
                                                <Binding Path="Id" />
                                                <Binding Source="{x:Reference NotesContentRoot}"
                                                         Path="BindingContext.DraggingNoteId" />
                                            </MultiBinding>
                                        </BoxView.Color>
                                    </BoxView>

                                    <!--
                                        Complete / checkbox. IsChecked is
                                        OneWay (model is source of truth)
                                        and the toggle runs through the
                                        ViewModel via the CheckedChanged
                                        event (PR #37 review issue #7).
                                    -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              CheckedChanged="OnCheckChanged"
                                              Color="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryLightColor}}"
                                              VerticalOptions="Center"
                                              HorizontalOptions="Center" />

                                    <!-- Title + metadata -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4"
                                                         VerticalOptions="Center"
                                                         Margin="0,0,0,1">
                                        <Label Text="{Binding Title}"
                                               Style="{StaticResource NoteTitleStyle}"
                                               FontSize="16"
                                               VerticalTextAlignment="Center"
                                               MaxLines="1"
                                               TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationConverter}}" />
                                        <HorizontalStackLayout Spacing="8"
                                                               VerticalOptions="Center"
                                                               Margin="0,1,0,0">
                                            <Border IsVisible="{Binding DueDate, Converter={StaticResource NotNullToBoolConverter}}"
                                                    Padding="8,4"
                                                    Stroke="{StaticResource ChipStrokeColor}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{StaticResource ChipBackgroundColor}">
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center"><Image Source="calendaricon.png" WidthRequest="12" HeightRequest="12" /><Label Text="{Binding DueDate, Converter={StaticResource DateTimeFormatConverter}}" FontSize="10" TextColor="#66616F" VerticalTextAlignment="Center" /></HorizontalStackLayout>
                                            </Border>
                                            <Border IsVisible="{Binding HasRepeat}"
                                                    Padding="8,4"
                                                    Stroke="{StaticResource ChipStrokeColor}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{StaticResource ChipBackgroundColor}">
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center"><Image Source="dateicon.png" WidthRequest="12" HeightRequest="12" /><Label Text="{Binding RepeatFrequency}" FontSize="10" TextColor="#66616F" VerticalTextAlignment="Center" /></HorizontalStackLayout>
                                            </Border>
                                            <Border IsVisible="{Binding ReminderDate, Converter={StaticResource NotNullToBoolConverter}}"
                                                    Padding="8,4"
                                                    Stroke="{StaticResource ChipStrokeColor}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{StaticResource ChipBackgroundColor}">
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center"><Image Source="bellicon.png" WidthRequest="12" HeightRequest="12" /><Label Text="{Binding ReminderDate, Converter={StaticResource DateTimeFormatConverter}}" FontSize="10" TextColor="#66616F" VerticalTextAlignment="Center" /></HorizontalStackLayout>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Star (Important) -->
                                    <buttons:SfButton Grid.Column="2"
                                            Text="{Binding IsImportant, Converter={StaticResource BoolToStarGlyphConverter}}"
                                            TextColor="{Binding IsImportant, Converter={StaticResource BoolToStarColorConverter}}"
                                            FontSize="20"
                                            Background="Transparent"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            VerticalOptions="Center"
                                            Padding="0"
                                            Command="{Binding Source={x:Reference NotesContentRoot}, Path=BindingContext.ToggleImportantCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Toggle important" />

                                    <!-- More menu (three-dot) -->
                                    <buttons:SfButton Grid.Column="3"
                                            Text="&#8943;"
                                            FontSize="22"
                                            Rotation="90"
                                            Background="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColor}, Dark={StaticResource TextSecondaryDarkColor}}"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            VerticalOptions="Center"
                                            Padding="0"
                                            Clicked="OnNoteMenuClicked"
                                            SemanticProperties.Description="More note options" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>

                <expander:SfExpander Grid.Row="1"
                                     IsVisible="{Binding HasCompletedNotes}"
                                     IsExpanded="{Binding IsCompletedExpanded, Mode=TwoWay}"
                                     AnimationDuration="180">
                    <expander:SfExpander.Header>
                        <Grid Padding="20,12" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                            <Label Text="&#10003;" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColor}, Dark={StaticResource TextSecondaryDarkColor}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding CompletedCount, StringFormat='Completed ({0})'}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColor}, Dark={StaticResource TextSecondaryDarkColor}}"
                                   FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="&#9662;"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColor}, Dark={StaticResource TextSecondaryDarkColor}}"
                                   HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                    </expander:SfExpander.Header>
                    <expander:SfExpander.Content>
                        <syncfusion:SfListView ItemsSource="{Binding CompletedNotes}"
                                               ItemSpacing="0" ItemSize="80"
                                               BackgroundColor="Transparent"
                                               SelectionMode="SingleDeselect">
                            <syncfusion:SfListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Note">
                                    <Border Margin="16,6" Padding="14,10"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceDarkColor}}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                            Shadow="{StaticResource Elevation1}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Buttons="Secondary"
                                                                  Tapped="OnNoteSecondaryTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="44,*,40,40" ColumnSpacing="8">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                      CheckedChanged="OnCheckChanged"
                                                      VerticalOptions="Start" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource NoteTitleStyle}"
                                                       MaxLines="1"
                                                       TextDecorations="Strikethrough"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColor}, Dark={StaticResource TextSecondaryDarkColor}}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference NotesContentRoot}, Path=BindingContext.EditNoteCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Border IsVisible="{Binding DueDate, Converter={StaticResource NotNullToBoolConverter}}" Padding="7,3" Stroke="#E1DDED" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FAF9FC">
                                                        <HorizontalStackLayout Spacing="4"><Image Source="calendaricon.png" WidthRequest="12" HeightRequest="12" /><Label Text="{Binding DueDate, Converter={StaticResource DateTimeFormatConverter}}" FontSize="10" TextColor="#66616F" /></HorizontalStackLayout>
                                                    </Border>
                                                    <Border IsVisible="{Binding HasRepeat}" Padding="7,3" Stroke="#E1DDED" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FAF9FC">
                                                        <HorizontalStackLayout Spacing="4"><Image Source="dateicon.png" WidthRequest="12" HeightRequest="12" /><Label Text="{Binding RepeatFrequency}" FontSize="10" TextColor="#66616F" /></HorizontalStackLayout>
                                                    </Border>
                                                    <Border IsVisible="{Binding ReminderDate, Converter={StaticResource NotNullToBoolConverter}}" Padding="7,3" Stroke="#E1DDED" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FAF9FC">
                                                        <HorizontalStackLayout Spacing="4"><Image Source="bellicon.png" WidthRequest="12" HeightRequest="12" /><Label Text="{Binding ReminderDate, Converter={StaticResource DateTimeFormatConverter}}" FontSize="10" TextColor="#66616F" /></HorizontalStackLayout>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <buttons:SfButton Grid.Column="2"
                                                              Text="{Binding IsImportant, Converter={StaticResource BoolToStarGlyphConverter}}"
                                                              TextColor="{Binding IsImportant, Converter={StaticResource BoolToStarColorConverter}}"
                                                              Background="Transparent" FontSize="20" Padding="0"
                                                              WidthRequest="40" HeightRequest="40"
                                                              VerticalOptions="Center"
                                                              Command="{Binding Source={x:Reference NotesContentRoot}, Path=BindingContext.ToggleImportantCommand}"
                                                              CommandParameter="{Binding .}" />
                                            <buttons:SfButton Grid.Column="3" Text="&#8943;" Rotation="90"
                                                              Background="Transparent" Padding="0"
                                                              FontSize="22" WidthRequest="40" HeightRequest="40"
                                                              VerticalOptions="Center"
                                                              Clicked="OnNoteMenuClicked"
                                                              SemanticProperties.Description="More note options" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </syncfusion:SfListView.ItemTemplate>
                        </syncfusion:SfListView>
                    </expander:SfExpander.Content>
                </expander:SfExpander>
                </Grid>
            </Grid>

            <!-- Bottom input bar -->
            <Border Grid.Row="2"
                    Margin="16,12,16,16"
                    Padding="8"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12">
                <Grid RowDefinitions="Auto" ColumnDefinitions="*" VerticalOptions="Center"> 
                    <syncfusionCore:SfTextInputLayout Grid.Row="1" Grid.Column="0"
                                                     Hint="Add a note"
                                                     ContainerType="Outlined"
                                                     OutlineCornerRadius="28"
                                                     FocusedStrokeThickness="1"
                                                     Background="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceDarkColor}}"
                                                     UnfocusedStrokeThickness="1"
                                                     ShowHint="True"
                                                     Stroke="Transparent"
                                                     EnableFloating="False"
                                                     ReserveSpaceForAssistiveLabels="False"
                                                     InputViewPadding="14,0,150,0"
                                                     VerticalOptions="Center">
                        <syncfusionCore:SfTextInputLayout.HintLabelStyle>
                            <syncfusionCore:LabelStyle FontSize="14"
                                                       FontFamily="{StaticResource FontFamilyRegular}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColor}, Dark={StaticResource TextSecondaryDarkColor}}" />
                        </syncfusionCore:SfTextInputLayout.HintLabelStyle>
                        <syncfusionCore:SfTextInputLayout.TrailingView>
                            <Grid ColumnDefinitions="36,36,36,36" VerticalOptions="Center" HorizontalOptions="Fill" WidthRequest="150" Margin="0,8,0,0">
                                <buttons:SfButton Grid.Column="0" WidthRequest="36" HeightRequest="36" Padding="0"
                                                  Background="Transparent" Clicked="OnDueDateClicked"
                                                  SemanticProperties.Description="Set due date">
                                    <buttons:SfButton.Content><DataTemplate><Image Source="calendaricon.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" /></DataTemplate></buttons:SfButton.Content>
                                </buttons:SfButton>
                                <buttons:SfButton Grid.Column="1" WidthRequest="36" HeightRequest="36" Padding="0"
                                                  Background="Transparent" Clicked="OnRepeatClicked"
                                                  SemanticProperties.Description="Set repeat frequency">
                                    <buttons:SfButton.Content><DataTemplate><Image Source="dateicon.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" /></DataTemplate></buttons:SfButton.Content>
                                </buttons:SfButton>
                                <buttons:SfButton Grid.Column="2" WidthRequest="36" HeightRequest="36" Padding="0"
                                                  Background="Transparent" Clicked="OnReminderClicked"
                                                  SemanticProperties.Description="Set reminder date and time">
                                    <buttons:SfButton.Content><DataTemplate><Image Source="bellicon.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" /></DataTemplate></buttons:SfButton.Content>
                                </buttons:SfButton>
                                <buttons:SfButton Grid.Column="3" WidthRequest="36" HeightRequest="36" Padding="0"
                                                  Background="Transparent" Command="{Binding AddNoteCommand}"
                                                  SemanticProperties.Description="Save note">
                                    <buttons:SfButton.Content><DataTemplate><Image Source="tickicon.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" /></DataTemplate></buttons:SfButton.Content>
                                </buttons:SfButton>
                            </Grid>
                        </syncfusionCore:SfTextInputLayout.TrailingView>
                        <Entry Text="{Binding NewNoteTitle, Mode=TwoWay}"
                               Style="{StaticResource InputPillEntryStyle}"
                               BackgroundColor="Transparent"
                               Margin="0"
                               ReturnCommand="{Binding AddNoteCommand}" />
                    </syncfusionCore:SfTextInputLayout>
                </Grid>
            </Border>
            <noteViews:TaskSchedulingFlyout x:Name="SchedulingFlyout"
                                            Grid.RowSpan="3"
                                            WidthRequest="0"
                                            HeightRequest="0"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            ZIndex="999" />
            <noteViews:NoteActionFlyout x:Name="ActionFlyout"
                                        Grid.RowSpan="3"
                                        WidthRequest="0"
                                        HeightRequest="0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        ZIndex="1000" />
            <noteViews:ListOptionsFlyout x:Name="ListOptionsFlyout"
                                         Grid.RowSpan="3"
                                         WidthRequest="0"
                                         HeightRequest="0"
                                         HorizontalOptions="Start"
                                         VerticalOptions="Start"
                                         ZIndex="1001" />
        </Grid>
    </Border>

</ContentView>
