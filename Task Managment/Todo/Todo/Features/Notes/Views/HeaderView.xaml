<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Todo.Features.Notes.ViewModels"
             xmlns:syncfusionCore="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="Todo.Features.Notes.Views.HeaderView"
             x:DataType="vm:NotesListViewModel">

    <Grid HeightRequest="{StaticResource HeaderHeight}"
          Padding="8,0,16,0"
          ColumnDefinitions="Auto,*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceDarkColor}}">
        <Grid.Shadow>
            <Shadow Brush="#10000000" Radius="4" Offset="0,1" Opacity="0.10" />
        </Grid.Shadow>

        <HorizontalStackLayout Grid.Column="0"
                               Spacing="4"
                               VerticalOptions="Center">
            <!-- Hamburger menu: collapses / expands the sidebar.
                 Module-08 task 8-2: 48x48 touch target per the spec. -->
            <buttons:SfButton  
                    WidthRequest="18" 
                    HeightRequest="18" Margin="10,0" CornerRadius="0"
                    Padding="0" ImageSource="humburger.png" Background="Transparent"    
                    Command="{Binding ToggleSidebarCommand}"
                    SemanticProperties.Description="Toggle navigation menu">
                <buttons:SfButton.Content>
                    <DataTemplate>
                        <Image Source="humburger.png"/>
                    </DataTemplate>
                </buttons:SfButton.Content>
            </buttons:SfButton>
            <Label Text="To Do List"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColor}, Dark={StaticResource TextPrimaryDarkColor}}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Search pill -->
        <Border Grid.Column="1"
                WidthRequest="{OnIdiom Phone=180, Default=460}"
                HeightRequest="44"
                Margin="0"
                Padding="0"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22">
            <syncfusionCore:SfTextInputLayout ContainerType="Outlined"
                                              Hint="Search"
                                              ContainerBackground="{AppThemeBinding Light=#F7F2FB, Dark={StaticResource InputPillBackgroundDarkColor}}"
                                              OutlineCornerRadius="22"
                                              FocusedStrokeThickness="1"
                                              UnfocusedStrokeThickness="1"
                                              ReserveSpaceForAssistiveLabels="False"
                                              InputViewPadding="16,0,16,0"
                                              EnableFloating="False"
                                              Margin="0"
                                              ShowHelperText="False"
                                              ShowHint="True"
                                              Stroke="Transparent"
                                              HeightRequest="44"
                                              VerticalOptions="Center">
                <syncfusionCore:SfTextInputLayout.HintLabelStyle>
                    <syncfusionCore:LabelStyle FontSize="14"
                                               FontFamily="{StaticResource FontFamilyRegular}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryColor}, Dark={StaticResource TextSecondaryDarkColor}}" />
                </syncfusionCore:SfTextInputLayout.HintLabelStyle>
                <syncfusionCore:SfTextInputLayout.TrailingView>
                    <Image Source="search.png"
                           WidthRequest="18"
                           HeightRequest="18"
                           Margin="0,0,12,0"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Search notes" />
                </syncfusionCore:SfTextInputLayout.TrailingView>

                <Entry Text="{Binding SearchViewModel.Query, Mode=TwoWay}"
                       FontFamily="{StaticResource FontFamilyRegular}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryColor}, Dark={StaticResource TextPrimaryDarkColor}}"
                       Placeholder=""
                       HorizontalTextAlignment="Start"
                       VerticalTextAlignment="Center"
                       Focused="OnSearchEntryFocused"
                       HeightRequest="44"
                       BackgroundColor="Transparent"
                       Margin="0" />
            </syncfusionCore:SfTextInputLayout>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenSearchCommand}" />
            </Border.GestureRecognizers>
        </Border>

        <Border Grid.Column="2"
                WidthRequest="34"
                HeightRequest="34"
                Padding="0"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 17"
                VerticalOptions="Center">
            <Image Source="profile.png"
                   Aspect="AspectFill"
                   SemanticProperties.Description="Open theme settings" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
            </Border.GestureRecognizers>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.78" />
                            <Setter Property="Scale" Value="1.06" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </Grid>

</ContentView>
