<maui:MauiWinUIApplication
    x:Class="Todo.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:Todo.WinUI">

    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="ToolTipBackground" Color="#322F35" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#322F35" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ToolTipBackground" Color="#322F35" />
                    <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#322F35" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ToolTipBackground" Color="#322F35" />
                    <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#322F35" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>

</maui:MauiWinUIApplication>
