<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VisitorPass.ViewModels;assembly=VisitorPass"
             xmlns:controls="clr-namespace:VisitorPass.Controls;assembly=VisitorPass"
             xmlns:models="clr-namespace:VisitorPass.Models;assembly=VisitorPass"
             xmlns:barcode="clr-namespace:Syncfusion.Maui.Barcode;assembly=Syncfusion.Maui.Barcode"
             xmlns:listview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:button="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:progressbar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
             x:Class="VisitorPass.Views.VisitorDetailsPage"
             x:DataType="vm:VisitorDetailsViewModel"
             Title="Digital Visitor Pass"
             BackgroundColor="{StaticResource Surface}">

    <Grid ColumnDefinitions="{OnIdiom Desktop='232,*', Phone='0,*'}"
          ColumnSpacing="0">

        <!-- Sidebar (desktop / tablet only) -->
        <controls:SideNavigation Grid.Column="0"
                                 ActiveRoute="dashboard"
                                 IsVisible="{OnIdiom Phone=False, Default=True}" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="{OnIdiom Desktop='28,20,28,28', Phone='14,8,14,14'}"
                                 Spacing="18">

                <!-- =======================================================
                     Header — breadcrumb + headline + live pill + subtitle
                     ======================================================= -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Start">
                                <Label Text="OPERATIONS" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                <Label Text="›" FontSize="11" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                <Label Text="VISITOR DIRECTORY" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                <Label Text="›" FontSize="11" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                <Label Text="PASS DOSSIER" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding Visitor.PassId, StringFormat='› {0}'}" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource Primary}" />
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="Digital Visitor Pass"
                                       FontFamily="OpenSansSemibold" FontSize="26"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Border Grid.Column="1" BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                        Padding="9,4" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="6" Color="{StaticResource StatusCheckedIn}" VerticalOptions="Center">
                                            <BoxView.GestureRecognizers>
                                                <TapGestureRecognizer />
                                            </BoxView.GestureRecognizers>
                                        </BoxView>
                                        <Label Text="{Binding SyncPill}" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <Label Text="Active enterprise visitor credential, journey telemetry, and security access status."
                                   FontFamily="OpenSansRegular" FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" MaxLines="2" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- =======================================================
                     Body — 2-column grid. Stacks on phone.
                     ======================================================= -->
                <Grid IsVisible="{Binding HasVisitor}"
                      ColumnDefinitions="{OnIdiom Desktop='5*,7*', Phone='*'}"
                      RowDefinitions="{OnIdiom Desktop='Auto,Auto,Auto', Phone='Auto,Auto,Auto,Auto,Auto'}"
                      ColumnSpacing="18">

                    <!-- ===============================================
                         LEFT COLUMN — credential card + identity card
                         =============================================== -->

                    <!-- Credential card (facility + clearance + pass id) -->
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Border Style="{StaticResource PanelCard}"
                                Padding="20,18">
                            <VerticalStackLayout Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Start">
                                        <Border Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                                WidthRequest="26" HeightRequest="26" VerticalOptions="Start">
                                            <Image Source="shield.png" HeightRequest="14" WidthRequest="14"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                                            <Label Text="Central Facility" Style="{StaticResource SectionEyebrow}" />
                                            <Label Text="{Binding ClearanceTier}"
                                                   FontFamily="OpenSansSemibold" FontSize="13"
                                                   TextColor="{StaticResource TextPrimary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Border Grid.Column="1" BackgroundColor="{StaticResource PrimaryLight}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                            Padding="10,5" VerticalOptions="Start" HorizontalOptions="End">
                                        <Label Text="{Binding Visitor.PassId}" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource Primary}" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="0">
                                    <!-- Identity photo tile -->
                                    <Grid Grid.Column="0" WidthRequest="72" HeightRequest="72" VerticalOptions="Start">
                                        <Border BackgroundColor="{StaticResource PrimaryLight}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                            <Label Text="{Binding Visitor.Initials}"
                                                   FontFamily="OpenSansSemibold" FontSize="24"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Border BackgroundColor="{StaticResource Primary}"
                                                Stroke="White" StrokeThickness="2"
                                                StrokeShape="RoundRectangle 11"
                                                WidthRequest="22" HeightRequest="22"
                                                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,3,3">
                                            <Label Text="{x:Static controls:IconKeys.Check}"
                                                   FontFamily="MauiMaterialAssets" FontSize="12"
                                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="{Binding Visitor.VisitorName}"
                                                   FontFamily="OpenSansSemibold" FontSize="16"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   LineBreakMode="TailTruncation" />
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding Visitor.Status, Converter={StaticResource VisitorStatusToBackgroundConverter}}"
                                                    StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                    Padding="8,4" VerticalOptions="Start">
                                                <HorizontalStackLayout Spacing="4">
                                                    <BoxView WidthRequest="6" HeightRequest="6"
                                                             Color="{Binding Visitor.Status, Converter={StaticResource VisitorStatusToBrushConverter}}"
                                                             VerticalOptions="Center" />
                                                    <Label Text="{Binding Visitor.StatusDisplayLabel}"
                                                           FontFamily="OpenSansSemibold" FontSize="10"
                                                           TextColor="{Binding Visitor.Status, Converter={StaticResource VisitorStatusToBrushConverter}}" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding VisitorRole}" FontFamily="OpenSansRegular" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                            <Label Text="{x:Static controls:IconKeys.Person}" FontFamily="MauiMaterialAssets" FontSize="12" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                            <Label Text="{Binding HostOrganization}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="{StaticResource SurfaceAlt}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Visitor Category" Style="{StaticResource SectionEyebrow}" />
                                            <Label Text="{Binding VisitorCategory}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="{StaticResource SurfaceAlt}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Badge Protocol" Style="{StaticResource SectionEyebrow}" />
                                            <Label Text="{Binding BadgeProtocol}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Identity / visit-details card -->
                        <Border Grid.Column="{OnIdiom Desktop=0, Phone=0}"
                                Grid.Row="{OnIdiom Desktop=1, Phone=1}"
                                Style="{StaticResource PanelCard}"
                                Padding="20,18">
                            <VerticalStackLayout Spacing="16">

                                <!-- Visit purpose -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="Visit Purpose" Style="{StaticResource SectionEyebrow}" />
                                        <Label Text="{Binding Visitor.Purpose}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="{StaticResource PrimaryLight}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                            Padding="9,5" VerticalOptions="Start" HorizontalOptions="End">
                                        <HorizontalStackLayout Spacing="5">
                                            <Image Source="business.png" HeightRequest="8" WidthRequest="8" />
                                            <Label Text="{Binding Visitor.Purpose}" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource Border}" />

                                <!-- Authorized window + expected duration -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="Authorized Window" Style="{StaticResource SectionEyebrow}" />
                                        <Label Text="{Binding AuthorizedWindow}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="{Binding AuthorizedWindowDate}" FontFamily="OpenSansRegular" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Expected Duration" Style="{StaticResource SectionEyebrow}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{x:Static controls:IconKeys.Clock}" FontFamily="MauiMaterialAssets" FontSize="13" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                            <Label Text="{Binding ExpectedDurationDisplay}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="Standard Executive Cap" FontFamily="OpenSansRegular" FontSize="10" TextColor="{StaticResource StatusCheckedIn}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource Border}" />

                                <!-- Zone permissions -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Zone Permissions" Style="{StaticResource SectionEyebrow}" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="6" Color="{StaticResource Primary}" VerticalOptions="Center" />
                                            <Label Text="Building A" FontFamily="OpenSansRegular" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="6" Color="{StaticResource Primary}" VerticalOptions="Center" />
                                            <Label Text="North Tower Floor 4" FontFamily="OpenSansRegular" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="6" Color="{StaticResource Primary}" VerticalOptions="Center" />
                                            <Label Text="Exec Conference B" FontFamily="OpenSansRegular" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <BoxView HeightRequest="1" Color="{StaticResource Border}" />

                                <!-- Designated host block -->
                                <Border BackgroundColor="{StaticResource SurfaceAlt}"
                                        StrokeShape="RoundRectangle 14" Padding="16,14">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryLight}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                            <Label Text="{Binding HostInitials}" FontFamily="OpenSansSemibold" FontSize="16"
                                                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="Designated Host" Style="{StaticResource SectionEyebrow}" />
                                            <Label Text="{Binding Visitor.Host}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding HostDepartment}" FontFamily="OpenSansRegular" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="Extension" FontFamily="OpenSansRegular" FontSize="10" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding HostExtension}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="Phone" FontFamily="OpenSansRegular" FontSize="10" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding HostPhone}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <!-- Barcode + identifier -->
                                <Border BackgroundColor="{StaticResource SurfaceAlt}"
                                        StrokeShape="RoundRectangle 14" Padding="16,14">
                                    <VerticalStackLayout Spacing="10">
                                        <barcode:SfBarcodeGenerator Value="{Binding BarcodeValue}"
                                                                     BackgroundColor="{StaticResource SurfaceAlt}"
                                                                     ForegroundColor="{StaticResource TextPrimary}"
                                                                     ShowText="False"
                                                                     HeightRequest="64"
                                                                     HorizontalOptions="Center">
                                            <barcode:SfBarcodeGenerator.Symbology>
                                                <barcode:Code128 />
                                            </barcode:SfBarcodeGenerator.Symbology>
                                        </barcode:SfBarcodeGenerator>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0" Text="Visitor Pass Identifier:" FontFamily="OpenSansRegular" FontSize="11" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding PassIdentifier}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- NFC + SHA line -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                        <Image Source="nfc.png" WidthRequest="14" HeightRequest="14" />
                                        <Label Text="{Binding NfcLine}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                        <Label Text="{x:Static controls:IconKeys.Lock}" FontFamily="MauiMaterialAssets" FontSize="14" TextColor="{StaticResource StatusCheckedIn}" VerticalOptions="Center" />
                                        <Label Text="SHA-256 Validated" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Escort policy notice -->
                                <Border BackgroundColor="{StaticResource SurfaceAlt}"
                                        StrokeShape="RoundRectangle 14" Padding="16,14">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryLight}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                                WidthRequest="22" HeightRequest="22" VerticalOptions="Start">
                                            <Label Text="{x:Static controls:IconKeys.Info}" FontFamily="MauiMaterialAssets" FontSize="12" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="Escort Policy Notice" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding EscortNotice}" FontFamily="OpenSansRegular" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                    <!-- ===============================================
                         RIGHT COLUMN — journey + telemetry + controls
                         =============================================== -->

                    <!-- Visit Journey Progression -->
                    <VerticalStackLayout Grid.Column="{OnIdiom Desktop=1, Phone=0}"
                                         Grid.Row="{OnIdiom Desktop=0, Phone=2}"
                                         Spacing="25">
                        <Border Style="{StaticResource PanelCard}"
                                Padding="20,18">
                            <VerticalStackLayout Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Grid>
                                            <Label Text="Visit Journey Progression"
                                                   FontFamily="OpenSansSemibold" FontSize="16"
                                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="Real-time checkpoint telemetry across security gates and ingress lanes."
                                               FontFamily="OpenSansRegular" FontSize="11"
                                               TextColor="{StaticResource TextMuted}" MaxLines="1" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="{StaticResource SurfaceAlt}"
                                            StrokeShape="RoundRectangle 12" Padding="12,8"
                                            VerticalOptions="Start" HorizontalOptions="End">
                                        <HorizontalStackLayout Spacing="8">
                                            <Border BackgroundColor="{StaticResource StatusCheckedInBg}"
                                                    StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                    WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                                <Label Text="{x:Static controls:IconKeys.CheckCircle}" FontFamily="MauiMaterialAssets" FontSize="12" TextColor="{StaticResource StatusCheckedIn}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Spacing="0">
                                                <Label Text="{Binding CheckpointsCleared, StringFormat='{0} Checkpoints'}" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="Cleared" FontFamily="OpenSansRegular" FontSize="9" TextColor="{StaticResource TextMuted}" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                                <!-- Step spine (SfStepProgressBar) — uses the
                                     StepProgressBarItem-mirror collection; the
                                     rich checkpoint cards render in a separate
                                     CollectionView below, so both lists stay in
                                     lockstep with the visitor's status. -->
                                <Grid ColumnDefinitions="Auto, *">
                                <progressbar:SfStepProgressBar ItemsSource="{Binding JourneySteps}"
                                                               Orientation="Vertical"
                                                               LabelPosition="End"
                                                               ShowToolTip="False"
                                                               ProgressAnimationDuration="0"
                                                               ProgressBarBackground="{StaticResource Border}"
                                                               HorizontalOptions="Fill"
                                                               VerticalOptions="Start">
                                        <progressbar:SfStepProgressBar.InProgressStepSettings>
                                            <progressbar:StepSettings Background="{StaticResource Primary}" ContentType="Dot" ShapeType="Circle" ProgressColor="{StaticResource Primary}" ContentFillColor="White" Stroke="{StaticResource Primary}">
                                                <progressbar:StepSettings.TextStyle>
                                                    <progressbar:StepTextStyle TextColor="CadetBlue" FontAttributes="Bold"/>
                                                </progressbar:StepSettings.TextStyle>
                                            </progressbar:StepSettings>
                                        </progressbar:SfStepProgressBar.InProgressStepSettings>
                                        <progressbar:SfStepProgressBar.CompletedStepSettings>
                                            <progressbar:StepSettings Background="{StaticResource Primary}" ContentType="Tick" ShapeType="Circle" ProgressColor="{StaticResource Primary}" ContentFillColor="White">
                                                <progressbar:StepSettings.TextStyle>
                                                    <progressbar:StepTextStyle TextColor="CadetBlue" FontAttributes="Bold"/>
                                                </progressbar:StepSettings.TextStyle>
                                            </progressbar:StepSettings>
                                        </progressbar:SfStepProgressBar.CompletedStepSettings>
                                        <progressbar:SfStepProgressBar.NotStartedStepSettings>
                                            <progressbar:StepSettings Background="{StaticResource PrimaryLight}" ContentType="Cross" ShapeType="Circle" ProgressColor="{StaticResource Primary}" ContentFillColor="White">
                                                <progressbar:StepSettings.TextStyle>
                                                    <progressbar:StepTextStyle TextColor="CadetBlue" FontAttributes="Bold"/>
                                                </progressbar:StepSettings.TextStyle>
                                            </progressbar:StepSettings>
                                        </progressbar:SfStepProgressBar.NotStartedStepSettings>
                                 </progressbar:SfStepProgressBar>

                                        <!-- Rich checkpoint cards (one per Journey entry).
                                     Decoupled from SfStepProgressBar so the
                                     control receives the strongly-typed items
                                     it expects. -->
                                    <listview:SfListView ItemsSource="{Binding Journey}"
                                                         Grid.Column="1"
                                                         AutoFitMode="DynamicHeight"
                                                         SelectionMode="None"
                                                         IsScrollingEnabled="False"
                                                         ItemSpacing="0,0,0,14"
                                                         ScrollBarVisibility="Never">
                                    <listview:SfListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:JourneyCheckpoint">
                                            <Border BackgroundColor="{StaticResource SurfaceAlt}"
                                                    Stroke="{StaticResource Border}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 14"
                                                    Padding="16,14"
                                                    Margin="0,0,0,14">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding Status}"
                                                                 Value="InProgress">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusCheckedInBg}" />
                                                        <Setter Property="Stroke" Value="{StaticResource StatusCheckedIn}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <VerticalStackLayout Spacing="6">
                                                    <!-- title + current stage + timestamp -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Label Grid.Column="0"
                                                               Text="{Binding Label, StringFormat='{0}'}"
                                                               FontFamily="OpenSansSemibold" FontSize="13"
                                                               TextColor="{StaticResource TextPrimary}"
                                                               VerticalOptions="Center" />
                                                            <Border Grid.Column="1"
                                                                IsVisible="{Binding IsCurrent}"
                                                                BackgroundColor="{StaticResource StatusCheckedInBg}"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 8"
                                                                Padding="8,3"
                                                                HorizontalOptions="Start"
                                                                Margin="8,0,0,0">
                                                                <Label Text="CURRENT STAGE"
                                                                   FontFamily="OpenSansSemibold" FontSize="8"
                                                                   CharacterSpacing="1"
                                                                   TextColor="{StaticResource StatusCheckedIn}" />
                                                            </Border>
                                                            <Label Grid.Column="2"
                                                               Text="{Binding Timestamp}"
                                                               FontFamily="OpenSansRegular" FontSize="10"
                                                               TextColor="{StaticResource TextMuted}"
                                                               HorizontalOptions="End"
                                                               VerticalOptions="Center" />
                                                        </Grid>

                                                        <!-- meta chips -->
                                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="18">
                                                        <HorizontalStackLayout Grid.Column="0" Spacing="5">
                                                            <Label Text="{x:Static controls:IconKeys.Assessment}" FontFamily="MauiMaterialAssets" FontSize="12" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                                            <Label Text="{Binding MetaLeft}" FontFamily="OpenSansRegular" FontSize="10" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                        <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                                            <Label Text="{x:Static controls:IconKeys.QrCode}" FontFamily="MauiMaterialAssets" FontSize="12" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                                            <Label Text="{Binding MetaRight}" FontFamily="OpenSansRegular" FontSize="10" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </listview:SfListView.ItemTemplate>
                                </listview:SfListView>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Visit Summary & Telemetry -->
                        <Border Grid.Column="{OnIdiom Desktop=1, Phone=0}"
                                Grid.Row="{OnIdiom Desktop=1, Phone=3}"
                                Style="{StaticResource PanelCard}"
                                Padding="10,9">
                            <VerticalStackLayout Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                        <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryLight}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                            <Image Source="summary.png" HeightRequest="10" WidthRequest="10" />
                                        </Border>
                                        <Label Grid.Column="1" Text="Visit Summary &amp; Telemetry"
                                               FontFamily="OpenSansSemibold" FontSize="16"
                                               TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                    </Grid>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Start">
                                        <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="6" Color="{StaticResource StatusCheckedIn}" VerticalOptions="Center" />
                                        <Label Text="Active Session" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource StatusCheckedIn}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- 5 metric tiles -->
                                <Grid ColumnDefinitions="{OnIdiom Default='*,*,*,*,*', Phone='*,*,*,*'}"
                                      ColumnSpacing="10">
                                    <Border Grid.Column="0" Style="{StaticResource TelemetryTile}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Scheduled" Style="{StaticResource SectionEyebrow}" FontSize="{OnIdiom Default=12, Phone=9}"/>
                                            <Label Text="{Binding ScheduledDisplay}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="Standard Slot" FontFamily="OpenSansRegular" FontSize="9" TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource TelemetryTile}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Arrival Time" Style="{StaticResource SectionEyebrow}" FontSize="{OnIdiom Default=12, Phone=9}"/>
                                            <Label Text="{Binding ArrivalDisplay}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding ArrivalCaption}" FontFamily="OpenSansSemibold" FontSize="9" TextColor="{StaticResource StatusCheckedIn}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource TelemetryTile}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Departure Est." Style="{StaticResource SectionEyebrow}" FontSize="{OnIdiom Default=12, Phone=9}"/>
                                            <Label Text="{Binding DepartureDisplay}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource TelemetryTile}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Duration" Style="{StaticResource SectionEyebrow}" FontSize="{OnIdiom Default=12, Phone=9}"/>
                                            <Label Text="{Binding DurationDisplay}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding ElapsedDisplay}" FontFamily="OpenSansRegular" FontSize="9" TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource TelemetryTile}" IsVisible="{OnIdiom Default=true, Phone=false}">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Current Zone" Style="{StaticResource SectionEyebrow}" FontSize="{OnIdiom Default=12, Phone=9}"/>
                                            <Label Text="{Binding CurrentZone}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Primary}" />
                                            <Label Text="{Binding CurrentZoneCaption}" FontFamily="OpenSansRegular" FontSize="9" TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- 3 info chips -->
                                <Grid ColumnDefinitions="{OnIdiom Default='*,*,*', Phone='*,*'}"
                                      ColumnSpacing="10">
                                    <Border Grid.Column="0" Style="{StaticResource InfoChip}">
                                        <HorizontalStackLayout Spacing="9">
                                            <Border BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="24" HeightRequest="24">
                                                <Label Text="{x:Static controls:IconKeys.Person}" FontFamily="MauiMaterialAssets" FontSize="13" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Escort Status" FontFamily="OpenSansRegular" FontSize="9" TextColor="{StaticResource TextMuted}" />
                                                <Label Text="{Binding EscortStatus}" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource TextPrimary}" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource InfoChip}">
                                        <HorizontalStackLayout Spacing="9">
                                            <Border BackgroundColor="{StaticResource StatusCheckedInBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="24" HeightRequest="24">
                                                <Image Source="wifi.png" HeightRequest="12" WidthRequest="12"/>
                                            </Border>
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Wi-Fi Guest Token" FontFamily="OpenSansRegular" FontSize="9" TextColor="{StaticResource TextMuted}" />
                                                <Label Text="{Binding WifiToken}" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource TextPrimary}" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource InfoChip}">
                                        <HorizontalStackLayout Spacing="9">
                                            <Border BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 8" WidthRequest="24" HeightRequest="24">
                                                <Image Source="parking.png" HeightRequest="10" WidthRequest="10" />
                                            </Border>
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Parking Bay" FontFamily="OpenSansRegular" FontSize="9" TextColor="{StaticResource TextMuted}" />
                                                <Label Text="{Binding ParkingBay}" FontFamily="OpenSansSemibold" FontSize="10" TextColor="{StaticResource TextPrimary}" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Operational Controls & Status Actions -->
                        <Border Grid.Column="{OnIdiom Desktop=1, Phone=0}"
                            Grid.Row="{OnIdiom Desktop=2, Phone=4}"
                            Style="{StaticResource PanelCard}"
                            Padding="20,18">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryLight}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                            WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                        <Label Text="{x:Static controls:IconKeys.Assessment}" FontFamily="MauiMaterialAssets" FontSize="12" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="Operational Controls &amp; Status Actions"
                                           FontFamily="OpenSansSemibold" FontSize="16"
                                           TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                </Grid>
                                <Label Grid.Column="1" Text="Operator Level 3 Access" FontFamily="OpenSansRegular" FontSize="10" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            </Grid>

                            <!-- Primary action row -->
                                <Grid ColumnDefinitions="*,*,*"
                                      Margin="0,10,0,0"
                                      ColumnSpacing="12">
                                    <!-- Check In / Completed -->
                                    <button:SfButton Grid.Column="0" HeightRequest="50" IsEnabled="{Binding IsCheckInVisible}" CornerRadius="12" Stroke="{StaticResource Border}" Padding="14,12,14,12" StrokeThickness="1" Clicked="OnCheckIn">
                                        <button:SfButton.Triggers>
                                            <Trigger TargetType="button:SfButton"
                                                     Property="IsEnabled"
                                                     Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource StatusCheckedInBg}" />
                                            </Trigger>
                                        </button:SfButton.Triggers>
                                        <button:SfButton.Content>
                                            <DataTemplate>
                                                <HorizontalStackLayout Spacing="{OnIdiom Default=9, Phone=4}" HorizontalOptions="Center">
                                            <Border BackgroundColor="{StaticResource StatusCheckedInBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="26" HeightRequest="26">
                                                <Label Text="{x:Static controls:IconKeys.CheckCircle}" FontFamily="MauiMaterialAssets" FontSize="14" TextColor="{StaticResource StatusCheckedIn}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                <Label Text="Check In" FontFamily="OpenSansRegular" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                                <Label Text="Completed" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource TextPrimary}" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                            </DataTemplate>
                                        </button:SfButton.Content>
                                    </button:SfButton>

                                    <!-- Record Departure / Check Out -->
                                    <button:SfButton Grid.Column="1" IsEnabled="{Binding IsCheckOutVisible}" CornerRadius="12" Stroke="{StaticResource Border}" Padding="14,12,14,12" StrokeThickness="1" Clicked="OnCheckOut">
                                        <button:SfButton.Triggers>
                                            <Trigger TargetType="button:SfButton"
                                                     Property="IsEnabled"
                                                     Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource Primary}" />
                                            </Trigger>
                                        </button:SfButton.Triggers>
                                        <button:SfButton.Content>
                                            <DataTemplate>
                                                <HorizontalStackLayout Spacing="{OnIdiom Default=9, Phone=4}" HorizontalOptions="Center">
                                            <Image Source="exit_white.png" HeightRequest="12" WidthRequest="12" />
                                            <Label Text="Check out" FontFamily="OpenSansSemibold" FontSize="12" TextColor="White" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                            </DataTemplate>
                                        </button:SfButton.Content>
                                    </button:SfButton>

                                    <!-- Cancel Visit / Revoke Badge -->
                                    <button:SfButton Grid.Column="2" IsEnabled="{Binding IsCancelVisible}" CornerRadius="12" Stroke="{StaticResource Border}" Padding="14,12,14,12" StrokeThickness="1" Clicked="OnCancelVisit">
                                        <button:SfButton.Triggers>
                                            <Trigger TargetType="button:SfButton"
                                                     Property="IsEnabled"
                                                     Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource StatusCancelledBg}" />
                                            </Trigger>
                                        </button:SfButton.Triggers>
                                        <button:SfButton.Content>
                                            <DataTemplate>
                                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                                    <Border BackgroundColor="{StaticResource StatusCancelledBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="26" HeightRequest="26">
                                                        <Label Text="{x:Static controls:IconKeys.Block}" FontFamily="MauiMaterialAssets" FontSize="14" TextColor="{StaticResource StatusCancelled}" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>
                                                    <Label Text="Cancel Visit" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource StatusCancelled}" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                                                </HorizontalStackLayout>
                                            </DataTemplate>
                                        </button:SfButton.Content>
                                    </button:SfButton>
                                </Grid>
                            </VerticalStackLayout>
                    </Border>
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>