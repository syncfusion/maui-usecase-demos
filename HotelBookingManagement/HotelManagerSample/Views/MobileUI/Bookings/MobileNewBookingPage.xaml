<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:chips="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:calendar="clr-namespace:Syncfusion.Maui.Calendar;assembly=Syncfusion.Maui.Calendar"
             xmlns:vm="clr-namespace:HotelManagerSample.Bookings;assembly=HotelManagerSample"
             xmlns:models="clr-namespace:HotelManagerSample;assembly=HotelManagerSample"
             xmlns:conv="clr-namespace:HotelManagerSample.Converters;assembly=HotelManagerSample"
             x:Class="HotelManagerSample.Bookings.MobileNewBookingPage"
             x:DataType="vm:MobileNewBookingViewModel"
             Style="{StaticResource MobilePage}"
             BackgroundColor="{StaticResource MobileSurface}"
             Title="New Booking">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            
            <!-- Inline header band in the success/info expander -->
            <Color x:Key="ExpanderSavedColor">#15803D</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============= HEADER STRIP ============= -->
        <Grid Grid.Row="0"
              ColumnDefinitions="42,*,Auto"
              Padding="14,16,14,8"
              ColumnSpacing="12"
              BackgroundColor="{StaticResource MobileCardColor}">
            <Border Grid.Column="0"
                    BackgroundColor="{StaticResource MobilePrimaryLight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    WidthRequest="42" HeightRequest="42">
                <Image Source="calender.png" HeightRequest="16" WidthRequest="16" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="-2" VerticalOptions="Center">
                <Label FontFamily="OpenSansSemibold"
                       FontSize="20"
                       TextColor="{StaticResource MobileText}"
                       Text="New Booking" />
            </VerticalStackLayout>
            <Border Grid.Column="2"
                    WidthRequest="32" HeightRequest="32"
                    StrokeThickness="0"
                    BackgroundColor="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#xe5cd;"
                       FontFamily="MaterialAssets"
                       FontSize="20"
                       TextColor="{StaticResource MobileTextMuted}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
        </Grid>

        <!-- ============= BODY ============= -->
        <ScrollView Grid.Row="1" Padding="14,12,14,12">
            <VerticalStackLayout Spacing="14">

                <!-- STEP 1: GUEST INFORMATION -->
                <expander:SfExpander x:Name="GuestExpander"
                                     IsExpanded="True"
                                     HeaderBackground="{StaticResource MobileCard}"
                                     Style="Rotator"
                                     HeaderIconColor="#4B41E1">
                    <expander:SfExpander.Header>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,0">
                            <Border Grid.Column="0"
                                    Style="{StaticResource MobileIconTile}">
                                <Label Text="&#xe71b;"
                                       FontFamily="MaterialAssets"
                                       FontSize="18"
                                       TextColor="#4B41E1"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="-2" VerticalOptions="Center">
                                <Label FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{StaticResource MobileText}"
                                       Text="Guest Information" />
                                <Label Style="{StaticResource MobileKpiCaption}"
                                       Text="Primary contact &amp; occupancy" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="&#xe5c5;"
                                   FontFamily="MaterialAssets"
                                   FontSize="14"
                                   TextColor="{StaticResource MobileTextMuted}"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </expander:SfExpander.Header>

                    <expander:SfExpander.Content>
                        <VerticalStackLayout Padding="0,20,0,0">

                            <!-- Full Name -->
                            <inputLayout:SfTextInputLayout ContainerType="Outlined"
                                                            ContainerBackground="White"
                                                           HeightRequest="80"
                                                            Stroke="#E6EAF3"
                                                            Focused="#4F46E5"
                                                            Hint="Full Name"
                                                            Grid.Column="0"
                                                            ReserveSpaceForAssistiveLabels="True">
                                <Entry x:Name="FullNameEntry"
                                       Text="{Binding GuestName, Mode=TwoWay}"
                                       Placeholder="Liam Vance"
                                       FontFamily="OpenSansRegular"
                                       FontSize="12"
                                       TextColor="#0F172A"
                                       BackgroundColor="Transparent" />
                            </inputLayout:SfTextInputLayout>

                            <!-- Email -->
                            <inputLayout:SfTextInputLayout ContainerType="Outlined"
                                                            ContainerBackground="White"
                                                           HeightRequest="80"
                                                            Stroke="#E6EAF3"
                                                            Focused="#4F46E5"
                                                            Hint="Email Address"
                                                            ReserveSpaceForAssistiveLabels="True">
                                <Entry x:Name="EmailEntry"
                                       Text="{Binding GuestEmail, Mode=TwoWay}"
                                       Placeholder="l.vance@example.com"
                                       Keyboard="Email"
                                       FontFamily="OpenSansRegular"
                                       FontSize="12"
                                       TextColor="#0F172A"
                                       BackgroundColor="Transparent" />
                            </inputLayout:SfTextInputLayout>

                            <!-- Mobile -->
                            <inputLayout:SfTextInputLayout ContainerType="Outlined"
                                                            ContainerBackground="White"
                                                           HeightRequest="80"
                                                            Stroke="#E6EAF3"
                                                            Focused="#4F46E5"
                                                            Hint="Mobile Phone"
                                                            ReserveSpaceForAssistiveLabels="True">
                                <Entry x:Name="PhoneEntry"
                                       Text="{Binding Phone, Mode=TwoWay}"
                                       Placeholder="555 749 2104"
                                       Keyboard="Telephone"
                                       MaxLength="10"
                                       FontFamily="OpenSansRegular"
                                       FontSize="13"
                                       TextColor="#0F172A"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnPhoneTextChanged" />
                            </inputLayout:SfTextInputLayout>

                            <!-- Adults / Children steppers -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource MobileKpiCaption}"
                                           FontAttributes="Bold"
                                           Text="Adults (18+)" />
                                    <Border Style="{StaticResource MobileInputField}"
                                            Padding="0"
                                            StrokeThickness="0">
                                        <Grid ColumnDefinitions="36,*,36">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{StaticResource MobilePrimaryLight}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    WidthRequest="32" HeightRequest="32"
                                                    VerticalOptions="Center">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnAdultMinusTapped" />
                                                </Border.GestureRecognizers>
                                                <Label Text="&#xe72b;"
                                                       FontFamily="MaterialAssets"
                                                       FontSize="16"
                                                       TextColor="{StaticResource MobilePrimary}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Border>
                                            <Label Grid.Column="1"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource MobileText}"
                                                   Text="{Binding Adults}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{StaticResource MobilePrimary}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    WidthRequest="32" HeightRequest="32"
                                                    VerticalOptions="Center">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnAdultPlusTapped" />
                                                </Border.GestureRecognizers>
                                                <Label Text="&#xe70d;"
                                                       FontFamily="MaterialAssets"
                                                       FontSize="16"
                                                       TextColor="White"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Style="{StaticResource MobileKpiCaption}"
                                           FontAttributes="Bold"
                                           Text="Children" />
                                    <Border Style="{StaticResource MobileInputField}"
                                            Padding="0"
                                            StrokeThickness="0">
                                        <Grid ColumnDefinitions="36,*,36">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{StaticResource MobilePrimaryLight}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    WidthRequest="32" HeightRequest="32"
                                                    VerticalOptions="Center">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnChildMinusTapped" />
                                                </Border.GestureRecognizers>
                                                <Label Text="&#xe72b;"
                                                       FontFamily="MaterialAssets"
                                                       FontSize="16"
                                                       TextColor="{StaticResource MobilePrimary}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Border>
                                            <Label Grid.Column="1"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource MobileText}"
                                                   Text="{Binding Children}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{StaticResource MobilePrimary}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    WidthRequest="32" HeightRequest="32"
                                                    VerticalOptions="Center">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnChildPlusTapped" />
                                                </Border.GestureRecognizers>
                                                <Label Text="&#xe70d;"
                                                       FontFamily="MaterialAssets"
                                                       FontSize="16"
                                                       TextColor="White"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </expander:SfExpander.Content>
                </expander:SfExpander>

                <!-- STEP 2: STAY & ROOM ASSIGNMENT -->
                <expander:SfExpander x:Name="StayExpander"
                                     IsExpanded="True"
                                     HeaderBackground="{StaticResource MobileCard}"
                                     Style="Rotator"
                                     HeaderIconColor="{StaticResource MobilePrimary}">
                    <expander:SfExpander.Header>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,0">
                            <Border Grid.Column="0"
                                    Style="{StaticResource MobileIconTile}">
                                <Image Source="stay.png" HeightRequest="16" WidthRequest="16"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="-2" VerticalOptions="Center">
                                <Label FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{StaticResource MobileText}"
                                       Text="Stay &amp; Room Assignment" />
                                <Label Style="{StaticResource MobileKpiCaption}"
                                       Text="Dates, category &amp; door unit" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="&#xe5c5;"
                                   FontFamily="MaterialAssets"
                                   FontSize="14"
                                   TextColor="{StaticResource MobileTextMuted}"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </expander:SfExpander.Header>
                    <expander:SfExpander.Content>
                        <VerticalStackLayout Spacing="14" Padding="0,12,0,0">

                            <!-- Stay Timeline Date Selector -->
                            <Border
    BackgroundColor="{StaticResource MobilePrimaryLight}"
    StrokeThickness="0"
    StrokeShape="RoundRectangle 12"
    Padding="14,10">

                                <Grid ColumnDefinitions="*,Auto,*"
          VerticalOptions="Center">

                                    <!-- Check-In -->
                                    <Grid Grid.Column="0">

                                        <VerticalStackLayout
                Spacing="-2"
                HorizontalOptions="Start">

                                            <Label
                    Style="{StaticResource MobileKpiCaption}"
                    Text="Check-In" />

                                            <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="13"
                    TextColor="{StaticResource MobileText}"
                    Text="{Binding CheckIn, StringFormat='{0:MMM dd, yyyy}'}" />
                                        </VerticalStackLayout>

                                        <!-- Invisible DatePicker -->
                                        <DatePicker
                Date="{Binding CheckIn, Mode=TwoWay}"
                Opacity="0.01"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="Transparent"
                TextColor="Transparent" />
                                    </Grid>

                                    <!-- Nights Badge -->
                                    <Border
            Grid.Column="1"
            BackgroundColor="{StaticResource MobilePrimary}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 14"
            Padding="12,5"
            VerticalOptions="Center">

                                        <Label
                FontFamily="OpenSansSemibold"
                FontSize="11"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Text="{Binding Nights, StringFormat='{0} Nights'}" />
                                    </Border>

                                    <!-- Check-Out -->
                                    <Grid
            Grid.Column="2"
            HorizontalOptions="End">

                                        <VerticalStackLayout
                Spacing="-2"
                HorizontalOptions="End">

                                            <Label
                    Style="{StaticResource MobileKpiCaption}"
                    Text="Check-Out" />

                                            <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="13"
                    TextColor="{StaticResource MobileText}"
                    Text="{Binding CheckOut, StringFormat='{0:MMM dd, yyyy}'}" />
                                        </VerticalStackLayout>

                                        <!-- Invisible DatePicker -->
                                        <DatePicker
                Date="{Binding CheckOut, Mode=TwoWay}"
                Opacity="0.01"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="Transparent"
                TextColor="Transparent" />
                                    </Grid>

                                </Grid>
                            </Border>

                            <!-- Floor selector -->
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MobileKpiCaption}"
                                       TextColor="{StaticResource PrimaryDarkText}"
                                       FontSize="16"
                                       Text="Floor" />
                                <chips:SfChipGroup ItemsSource="{Binding FloorOptions}"
                                                   DisplayMemberPath="Display"
                                                   ChipType="Choice"
                                                   ChipStrokeThickness="2"
                                                   ChoiceMode="Single"
                                                   ChipTextSize="14"
                                                   ChipFontFamily="OpenSansSemibold"
                                                   ItemHeight="32"
                                                   SelectionChanged="OnFloorChipSelectionChanged" />
                            </VerticalStackLayout>

                            <!-- Inventory class dropdown -->
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MobileKpiCaption}"
                                       FontSize="16"
                                       TextColor="{StaticResource PrimaryDarkText}"
                                       Text="Select Room" />
                                <inputs:SfComboBox x:Name="RoomTypeComboBox"
                                                   ItemsSource="{Binding AvailableRooms}"
                                                   SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                                                   DisplayMemberPath="DisplayLabel"
                                                   TextMemberPath="DisplayLabel"
                                                   Placeholder="Choose an available room"
                                                   TextColor="{StaticResource MobileText}"
                                                   DropDownBackground="White"
                                                   BackgroundColor="#F4F6FB"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="16"
                                                   HeightRequest="46" />
                                <Label Style="{StaticResource MobileKpiCaption}"
                                       TextColor="{StaticResource MobileWarning}"
                                       Text="No rooms available on this floor - try another floor."
                                       IsVisible="{Binding HasNoAvailableRooms}" />
                            </VerticalStackLayout>

                            <!-- Inventory card summary -->
                            <Border IsVisible="{Binding HasSelectedRoom}"
                                    BackgroundColor="{StaticResource MobileCardColor}"
                                    Stroke="{StaticResource MobileDivider}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14,12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{StaticResource MobilePrimaryLight}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                WidthRequest="38" HeightRequest="38">
                                            <Image Source="stay.png" HeightRequest="16" WidthRequest="16"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="-1" VerticalOptions="Center">
                                            <Label FontFamily="OpenSansSemibold"
                                                   FontSize="13"
                                                   TextColor="{StaticResource MobileText}"
                                                   Text="{Binding SelectedRoom.Number, StringFormat='Room {0}'}" />
                                            <Label Style="{StaticResource MobileKpiCaption}"
                                                   Text="{Binding SelectedRoom.Type}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                BackgroundColor="{StaticResource MobilePrimaryLight}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="8,3"
                                                VerticalOptions="Center">
                                            <Label Style="{StaticResource MobilePillLabel}"
                                                   FontSize="9"
                                                   Text="Housekeeping: Clean" />
                                        </Border>
                                    </Grid>
                                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                        <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding SelectedRoomAmenityChips}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border BackgroundColor="{StaticResource MobilePrimaryLight}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 10"
                                                            Padding="9,4">
                                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                            <Label FontFamily="OpenSansRegular"
                                                                   FontSize="10"
                                                                   TextColor="{StaticResource MobilePrimary}"
                                                                   Text="{Binding .}" />
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </ScrollView>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </expander:SfExpander.Content>
                </expander:SfExpander>

                <!-- ============= ERROR RIBBON ============= -->
                <Border IsVisible="{Binding HasErrorMessage}"
                        BackgroundColor="#FEE2E2"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Padding="14,10"
                        Margin="0,4,0,0">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="&#xe002;"
                               FontFamily="MaterialAssets"
                               FontSize="14"
                               TextColor="{StaticResource MobileDanger}"
                               VerticalTextAlignment="Center" />
                        <Label Style="{StaticResource MobileBodyMuted}"
                               TextColor="{StaticResource MobileDangerText}"
                               Text="{Binding ErrorMessage}"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ============= FOOTER ============= -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*"
              Padding="14,12,14,16"
              BackgroundColor="{StaticResource MobileCardColor}">
            <VerticalStackLayout Grid.Column="0" Spacing="-2" VerticalOptions="Center">
                <Label Style="{StaticResource MobileKpiCaption}"
                       Text="Total Amount" />
                <Label FontFamily="OpenSansSemibold"
                       FontSize="20"
                       TextColor="{StaticResource MobileText}"
                       Text="{Binding ComputedTotal, StringFormat='${0:N0}.00'}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Margin="14,0,0,0"
                    Text="Create Booking"
                    Style="{StaticResource MobilePrimaryButton}"
                    IsEnabled="{Binding CanSubmit}"
                    Clicked="OnCreateBookingClicked">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding CanSubmit}"
                                 Value="False">
                        <Setter Property="BackgroundColor" Value="#94A3B8" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Grid>
</ContentPage>