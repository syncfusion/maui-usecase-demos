<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ==== Page shell ==== -->
    <Style TargetType="ContentPage" x:Key="MobilePage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource MobileSurface}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ==== Mobile top header card (white rounded card on the page bg) ==== -->
    <Style TargetType="Border" x:Key="MobileTopHeaderCard">
        <Setter Property="BackgroundColor" Value="{StaticResource MobileCardColor}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style TargetType="Label" x:Key="MobileHotelName">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource MobileText}" />
    </Style>
    <Style TargetType="Label" x:Key="MobileHotelSubtitle">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="TextColor" Value="{StaticResource MobileTextMuted}" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <Style TargetType="Label" x:Key="MobilePageTitle">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{StaticResource MobileText}" />
    </Style>
    <Style TargetType="Label" x:Key="MobilePageSubtitle">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource MobileTextMuted}" />
    </Style>
    <Style TargetType="Label" x:Key="MobileEyebrow">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource MobileText}" />
    </Style>

    <!-- ==== KPI tile ==== -->
    <Style TargetType="Border" x:Key="MobileKpiCard">
        <Setter Property="BackgroundColor" Value="{StaticResource MobileCardColor}" />
        <Setter Property="Stroke" Value="{StaticResource MobileDivider}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style TargetType="Label" x:Key="MobileKpiValue">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{StaticResource MobileText}" />
    </Style>
    <Style TargetType="Label" x:Key="MobileKpiCaption">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource MobileTextMuted}" />
    </Style>
    <Style TargetType="Label" x:Key="MobileKpiTrend">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource MobilePrimary}" />
    </Style>

    <!-- ==== Generic content card ==== -->
    <Style TargetType="Border" x:Key="MobileCard">
        <Setter Property="BackgroundColor" Value="{StaticResource MobileCardColor}" />
        <Setter Property="Stroke" Value="{StaticResource MobileDivider}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- ==== Pill (active / "LIVE" / status) ==== -->
    <Style TargetType="Border" x:Key="MobilePill">
        <Setter Property="BackgroundColor" Value="{StaticResource MobileChipBg}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style TargetType="Border" x:Key="MobilePillPrimary">
        <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimaryLight}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style TargetType="Label" x:Key="MobilePillLabel">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource MobilePrimary}" />
    </Style>

    <!-- ==== Tint icon tile (32×32 used by Kpi cards, expander headers) ==== -->
    <Style TargetType="Border" x:Key="MobileIconTile">
        <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimaryLight}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <!-- ==== Outline button (used on Booking card CTAs in "outline" state) ==== -->
    <Style TargetType="Button" x:Key="MobileOutlineButton">
        <Setter Property="BackgroundColor" Value="{StaticResource MobileCardColor}" />
        <Setter Property="TextColor" Value="{StaticResource MobilePrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource MobileBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <!-- ==== Primary button (e.g. New Booking FAB, Create Booking) ==== -->
    <Style TargetType="Button" x:Key="MobilePrimaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimary}" />
        <Setter Property="TextColor" Value="{StaticResource MobileTextOnPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <!-- ==== Dashboard selector / mobile listitem row ==== -->
    <Style TargetType="Grid" x:Key="MobileRow">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="Padding" Value="0,6" />
    </Style>

    <!-- ==== App-wide body typography ==== -->
    <Style TargetType="Label" x:Key="MobileBody">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource MobileText}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style TargetType="Label" x:Key="MobileBodyMuted">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource MobileTextMuted}" />
    </Style>

    <!-- ==== Floating action button (the big primary button on Dashboard) ==== -->
    <Style TargetType="Button" x:Key="MobileFab">
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="14">
        </Setter>
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <!-- ==== Syncfusion SfEntry wrapper-style (a flat borderless entry) ==== -->
    <Style TargetType="Border" x:Key="MobileInputField">
        <Setter Property="BackgroundColor" Value="#F1F4FA" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- ==== Section heading used in the middle of pages ==== -->
    <Style TargetType="Label" x:Key="MobileSectionHeading">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource MobileText}" />
    </Style>

    <!-- ==== List-grid title eyebrow (e.g. "SHIFT TURNOVER MATRIX") ==== -->
    <Style TargetType="Label" x:Key="MobileSectionEyebrow">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource MobileText}" />
    </Style>
</ResourceDictionary>