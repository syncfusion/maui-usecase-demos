<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- 
    Healthcare Patient Management System - Design System
    Color Palette aligned with Medical & Healthcare Branding
    -->

    <!-- PRIMARY COLORS -->
    <Color x:Key="Primary">#087F73</Color>
    <Color x:Key="PrimaryLight">#D1E7E4</Color>
    <Color x:Key="Secondary">#2563EB</Color>
    <Color x:Key="SecondaryLight">#DBEAFE</Color>
    <Color x:Key="Tertiary">#14213D</Color>
    <Color x:Key="Neutral">#64748B</Color>

    <!-- BACKGROUND COLORS -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="BackgroundColorDark">#101827</Color>
    <Color x:Key="SurfaceColor">#F4F7FC</Color>
    <Color x:Key="SurfaceColorDark">#182536</Color>
    <Color x:Key="BorderColor">#DCE4F2</Color>
    <Color x:Key="BorderColorDark">#334155</Color>

    <!-- STATUS COLORS -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>

    <!-- TEXT COLORS -->
    <Color x:Key="DarkText">#14213D</Color>
    <Color x:Key="DarkTextDark">#F8FAFC</Color>
    <Color x:Key="MutedText">#64748B</Color>
    <Color x:Key="MutedTextDark">#CBD5E1</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>