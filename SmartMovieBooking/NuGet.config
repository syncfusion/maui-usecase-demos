<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <config>
    <!-- Force NuGet to restore ALL TFMs declared in the csproj's <TargetFrameworks>,
         not just the active one. Without this, NuGet 6.x+ skips TFMs whose SDK
         or workload isn't installed on the machine and writes a partial
         project.assets.json that only references the active TFM - which then
         causes the NETSDK1041 errors the user is seeing. -->
    <add key="RestoreUseStaticGraphEvaluation" value="true" />
    <add key="RestoreUseSkipNonexistentTargets" value="false" />
  </config>
</configuration>
