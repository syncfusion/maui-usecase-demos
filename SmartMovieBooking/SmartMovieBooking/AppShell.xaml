<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SmartMovieBooking.Views"
       x:Class="SmartMovieBooking.AppShell"
       Title="Smart Movie Ticket Booking"
       Shell.NavBarIsVisible="False">

    <ShellContent Route="home"
                  Title="Movies"
                  ContentTemplate="{DataTemplate views:MovieHomeView}" />

    <ShellContent Route="theaters"
                  Title="Theaters"
                  ContentTemplate="{DataTemplate views:TheatersView}" />

    <ShellContent Route="bookings"
                  Title="Bookings"
                  ContentTemplate="{DataTemplate views:BookingsView}" />
</Shell>