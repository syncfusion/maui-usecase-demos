<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             xmlns:controls="clr-namespace:SmartMovieBooking.Views"
             xmlns:behaviors="clr-namespace:SmartMovieBooking.Behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="SmartMovieBooking.Views.TheatersView"
             x:DataType="vm:TheatersViewModel"
             Title="Theaters">

    <Grid RowDefinitions="{OnIdiom Default='*,Auto', Phone='*,72'}"
          ColumnDefinitions="{OnIdiom Default='200,*', Phone='*'}">
        <controls:AppSideBar Grid.Row="{OnIdiom Default=0, Phone=1}"
                             ActiveTab="Theaters" />

        <Grid MaximumWidthRequest="1200"
              Grid.Row="{OnIdiom Default=0, Phone=0}"
              Grid.Column="{OnIdiom Default='1', Phone='0'}"
              RowDefinitions="Auto,*"
              Padding="{OnIdiom Default='24', Phone='12'}"
              RowSpacing="16">
            <Border Grid.Row="0" Background="#FFFFFF" Stroke="#E6EAF9" StrokeThickness="1" StrokeShape="RoundRectangle 26" Padding="18">
                <Border.Shadow>
                    <Shadow Brush="#1A235218" Offset="0,8" Radius="20" Opacity="0.16" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
					<Border Background="#F7F9FF"
							Stroke="#E3E8FF"
							StrokeThickness="1"
							StrokeShape="RoundRectangle 22"
							Padding="16">
						<Grid ColumnDefinitions="84,*,Auto"
							  ColumnSpacing="16">
							<Border WidthRequest="84"
									HeightRequest="120"
									StrokeThickness="0"
									StrokeShape="RoundRectangle 18">
								<Border.Background>
									<LinearGradientBrush StartPoint="0,0"
														 EndPoint="1,1">
										<GradientStop Color="#27315D"
													  Offset="0" />
										<GradientStop Color="#171F3F"
													  Offset="1" />
									</LinearGradientBrush>
								</Border.Background>
								<VerticalStackLayout HorizontalOptions="Center"
													 VerticalOptions="Center"
													 Spacing="10">
									<Label Text="🎬"
										   FontSize="30"
										   HorizontalTextAlignment="Center"
										   TextColor="#F0F3FF" />
								</VerticalStackLayout>
							</Border>
							<VerticalStackLayout Grid.Column="1"
												 Spacing="6"
												 VerticalOptions="Center">
								<Label Text="{Binding MovieTitle, FallbackValue='Choose a movie'}"
									   FontFamily="OpenSansSemibold"
									   FontSize="26"
									   FontAttributes="Bold"
									   TextColor="#111827" />
								<Label Text="{Binding MovieTagline}"
									   FontSize="13"
									   TextColor="#4B5563"
									   LineBreakMode="WordWrap" />
								<Label Text="{Binding MovieSynopsis, FallbackValue=''}"
									   FontSize="12"
									   TextColor="#6B7280"
									   LineBreakMode="WordWrap" />
								<HorizontalStackLayout Spacing="8">
									<Border Background="#EEF2FF"
											StrokeThickness="0"
											StrokeShape="RoundRectangle 999"
											Padding="10,6">
										<Label Text="{Binding MovieCertificateText, FallbackValue='UA'}"
											   FontSize="10"
											   TextColor="#4338CA" />
									</Border>
									<Border Background="#EEF2FF"
											StrokeThickness="0"
											StrokeShape="RoundRectangle 999"
											Padding="10,6">
										<Label Text="{Binding MovieDurationText, FallbackValue='2h 30m'}"
											   FontSize="10"
											   TextColor="#4338CA" />
									</Border>
									<Border Background="#EEF2FF"
											StrokeThickness="0"
											StrokeShape="RoundRectangle 999"
											Padding="10,6">
										<Label Text="{Binding MovieGenresText}"
											   FontSize="10"
											   TextColor="#4338CA" />
									</Border>
								</HorizontalStackLayout>
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="2"
												 Spacing="6"
												 VerticalOptions="Center"
												 HorizontalOptions="End">
								<Label Text="{Binding MovieRatingText}"
									   FontFamily="OpenSansSemibold"
									   FontSize="24"
									   FontAttributes="Bold"
									   TextColor="#3525CD"
									   HorizontalTextAlignment="End" />
								<Label Text="Rating"
									   FontSize="11"
									   TextColor="#7A7B8C"
									   HorizontalTextAlignment="End" />
							</VerticalStackLayout>
						</Grid>
					</Border>

					<Border Stroke="#CAC7D0"
						StrokeShape="RoundRectangle 18"
						Padding="12">
					<syncfusion:SfListView x:Name="DateList"
										   ItemsSource="{Binding Dates}"
										   ItemSpacing="{OnIdiom Default=10, Phone=2}"
										   AutoFitMode="DynamicHeight"
										   BackgroundColor="Transparent"
                                           Orientation="Horizontal"
                                           ScrollBarVisibility="Never"
										   SelectionBackground="Transparent"
										   HeightRequest="{OnIdiom Default=104, Phone=74}"
										   SelectionMode="None">
						<syncfusion:SfListView.ItemsLayout>
							<syncfusion:GridLayout SpanCount="1" />
						</syncfusion:SfListView.ItemsLayout>
						<syncfusion:SfListView.ItemTemplate>
							<DataTemplate x:DataType="models:SelectableDate">
								<Border StrokeThickness="1"
										Stroke="#D7D8E6"
										BackgroundColor="#FFFFFF"
										Padding="{OnIdiom Default='10,8', Phone='8,6'}"
										HeightRequest="68"
										WidthRequest="84"
										StrokeShape="RoundRectangle 14">
									<Border.Triggers>
										<DataTrigger TargetType="Border"
													 Binding="{Binding IsSelected}"
													 Value="True">
											<Setter Property="BackgroundColor" Value="#3525CD" />
											<Setter Property="Stroke" Value="#3525CD" />
										</DataTrigger>
									</Border.Triggers>
									<Border.GestureRecognizers>
										<TapGestureRecognizer Tapped="OnDateTapped"
															  CommandParameter="{Binding Date}" />
									</Border.GestureRecognizers>
									<Border.Behaviors>
										<behaviors:HoverAnimationBehavior />
									</Border.Behaviors>
									<Grid RowDefinitions="Auto,Auto,Auto"
										  RowSpacing="0">
										<Label Text="{Binding Date, Converter={StaticResource DateLabelConverter}, ConverterParameter=labelonly}"
											   FontFamily="OpenSansSemibold"
											   FontSize="9"
											   TextColor="#49454F"
											   HorizontalTextAlignment="Center">
											<Label.Triggers>
												<DataTrigger TargetType="Label"
															 Binding="{Binding IsSelected}"
															 Value="True">
													<Setter Property="TextColor" Value="#C7C4F5" />
												</DataTrigger>
											</Label.Triggers>
										</Label>
										<Label Grid.Row="1"
											   Text="{Binding Date, StringFormat='{0:dd}'}"
											   FontFamily="OpenSansSemibold"
											   FontAttributes="Bold"
											   FontSize="15"
											   TextColor="#1A1A2E"
											   HorizontalTextAlignment="Center">
											<Label.Triggers>
												<DataTrigger TargetType="Label"
															 Binding="{Binding IsSelected}"
															 Value="True">
													<Setter Property="TextColor" Value="#FFFFFF" />
												</DataTrigger>
											</Label.Triggers>
										</Label>
										<Label Grid.Row="2"
											   Text="{Binding Date, StringFormat='{0:ddd MMM}'}"
											   FontFamily="OpenSansSemibold"
											   FontSize="9"
											   TextColor="#49454F"
											   HorizontalTextAlignment="Center">
											<Label.Triggers>
												<DataTrigger TargetType="Label"
															 Binding="{Binding IsSelected}"
															 Value="True">
													<Setter Property="TextColor" Value="#C7C4F5" />
												</DataTrigger>
											</Label.Triggers>
										</Label>
									</Grid>
								</Border>
							</DataTemplate>
						</syncfusion:SfListView.ItemTemplate>
					</syncfusion:SfListView>
				</Border>
                </VerticalStackLayout>
            </Border>

			<ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16">
					<syncfusion:SfListView Grid.Row="1"
											ItemsSource="{Binding Theaters}"
                                           ItemSpacing="{OnIdiom Default=12, Phone=10}"
                                           AutoFitMode="DynamicHeight"
										   IsScrollingEnabled="False"
										   ScrollBarVisibility="Never"
                                           BackgroundColor="Transparent"
                                           SelectionMode="None">
                        <syncfusion:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Theater">
								<Grid RowDefinitions="{OnIdiom Default=230, Phone=185}">
                                    <syncfusionCards:SfCardView CornerRadius="16"
                                                                BackgroundColor="#FFFFFF"
                                                                Padding="{OnIdiom Default=20, Phone=14}">
                                        <VerticalStackLayout Spacing="14">
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="12">
                                                <Border Grid.Column="0"
                                                        WidthRequest="48"
                                                        HeightRequest="48"
                                                        StrokeShape="RoundRectangle 12"
                                                        BackgroundColor="#F1F2F8">
                                                    <Label Text="{Binding Icon, FallbackValue='🎬'}"
                                                           FontSize="22"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1"
                                                                     Spacing="2"
                                                                     VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontAttributes="Bold"
                                                           FontSize="15"
                                                           TextColor="#1A1A2E" />
                                                    <Label Text="{Binding Location}"
                                                           FontSize="11"
                                                           TextColor="#49454F" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2"
                                                                     HorizontalOptions="End">
                                                    <Label Text="{Binding PriceFrom, StringFormat='From {0}'}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontAttributes="Bold"
                                                           FontSize="13"
                                                           TextColor="#3525CD"
                                                           HorizontalTextAlignment="End" />
                                                    <Label Text="{Binding AvailableSeats, StringFormat='{0} seats'}"
                                                           FontSize="10"
                                                           TextColor="#7A7B8C"
                                                           HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <Label Text="SELECT SCREENING TIME"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="10"
                                                   TextColor="#7A7B8C" />

											<syncfusion:SfListView ItemsSource="{Binding Showtimes}"
																   ItemSpacing="{OnIdiom Default='8', Phone='4'}"
																   BackgroundColor="Transparent"
																   Orientation="Horizontal"
																   HeightRequest="{OnIdiom Default='76', Phone='62'}"
																   ScrollBarVisibility="Never"
																   AutoFitMode="DynamicHeight"
																   SelectionMode="None">
												<syncfusion:SfListView.ItemsLayout>
													<syncfusion:GridLayout SpanCount="1" />
												</syncfusion:SfListView.ItemsLayout>
												<syncfusion:SfListView.ItemTemplate>
													<DataTemplate x:DataType="models:Showtime">
														<syncfusionCards:SfCardView CornerRadius="14"
																					BackgroundColor="#F1F2F8"
																					Padding="{OnIdiom Default='12,8', Phone='10,8'}">
															<syncfusionCards:SfCardView.GestureRecognizers>
																<TapGestureRecognizer Tapped="OnShowtimeTapped"
																					  CommandParameter="{Binding .}" />
															</syncfusionCards:SfCardView.GestureRecognizers>
															<syncfusionCards:SfCardView.Behaviors>
																<behaviors:HoverAnimationBehavior />
															</syncfusionCards:SfCardView.Behaviors>
															<HorizontalStackLayout>
																<VerticalStackLayout Spacing="2"
																					 WidthRequest="80">
																	<Label Text="{Binding StartTime}"
																		   FontFamily="OpenSansSemibold"
																		   FontAttributes="Bold"
																		   FontSize="13"
																		   TextColor="#1A1A2E" />
																	<Label Text="{Binding Format}"
																		   FontFamily="OpenSansSemibold"
																		   FontSize="9"
																		   TextColor="#3525CD" />
																</VerticalStackLayout>
																<VerticalStackLayout Spacing="2"
																					 WidthRequest="80">
																	<Label Text="{Binding Price, StringFormat='${0:F2}'}"
																		   HorizontalOptions="End"
																		   FontFamily="OpenSansSemibold"
																		   FontAttributes="Bold"
																		   FontSize="13"
																		   TextColor="#3525CD" />
																	<Label Text="{Binding Status, Converter={StaticResource ShowtimeStatusLabelConverter}}"
																		   HorizontalOptions="End"
																		   FontFamily="OpenSansSemibold"
																		   FontSize="9"
																		   TextColor="{Binding Status, Converter={StaticResource ShowtimeStatusColorConverter}}" />
																</VerticalStackLayout>
															</HorizontalStackLayout>
														</syncfusionCards:SfCardView>
													</DataTemplate>
												</syncfusion:SfListView.ItemTemplate>
											</syncfusion:SfListView>
										</VerticalStackLayout>
                                    </syncfusionCards:SfCardView>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:SfListView.ItemTemplate>
                    </syncfusion:SfListView>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>