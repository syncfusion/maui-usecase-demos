<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
			 xmlns:rotator="clr-namespace:Syncfusion.Maui.Rotator;assembly=Syncfusion.Maui.Rotator"
			 xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             xmlns:controls="clr-namespace:SmartMovieBooking.Views"
             xmlns:behaviors="clr-namespace:SmartMovieBooking.Behaviors"
             x:Class="SmartMovieBooking.Views.MovieHomeView"
             x:DataType="vm:HomeViewModel"
             Title="Movie Home">

    <Grid RowDefinitions="{OnIdiom Default='*,Auto', Phone='*,72'}"
          ColumnDefinitions="{OnIdiom Default='200,*', Phone='*'}"
          BackgroundColor="#F6F7FC">

        <controls:AppSideBar Grid.Row="{OnIdiom Default=0, Phone=1}"
                             ActiveTab="Movies" />

        <Grid Grid.Row="{OnIdiom Default=0, Phone=0}"
              Grid.Column="{OnIdiom Default='1', Phone='0'}"
              MaximumWidthRequest="1200"
              RowDefinitions="*"
              Padding="{OnIdiom Default='24', Phone='12,12,12,0'}">

            <ScrollView Grid.Row="0"
            VerticalScrollBarVisibility="Never"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="24">
                    <Border Stroke="#E6EAF9"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Background="#FFFFFF"
                            Padding="{OnIdiom Default='14,10', Phone='10,8'}">
                        <Border.Shadow>
                            <Shadow Brush="#1A235220"
                                    Offset="0,6"
                                    Radius="16"
                                    Opacity="0.14" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Border Background="#EEF0FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="8">
                                    <Label Text="📍"
                                           FontSize="18"
                                           VerticalTextAlignment="Center"
                                           HorizontalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="New York, NY"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13"
                                           TextColor="#17182B" />
                                    <Label Text="10 movies in catalog"
                                           FontSize="11"
                                           TextColor="#5C5F76" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Border Grid.Column="1"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    Background="#EEF1FF"
                                    VerticalOptions="Center">
                                <Label Text="👤"
                                       FontSize="18"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView WidthRequest="8"
                                             HeightRequest="20"
                                             CornerRadius="4"
                                             Color="#4A3DE0"
                                             VerticalOptions="Center" />
                                    <Label Text="Featured"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#17182B" />
                                </HorizontalStackLayout>
                                <Label Text="Top picks and biggest releases this week"
                                       FontSize="13"
                                       TextColor="#5C5F76" />
                            </VerticalStackLayout>
                        </Grid>

						<rotator:SfRotator ItemsSource="{Binding FeaturedMovies}"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill">
                            <rotator:SfRotator.ItemTemplate>
                                <DataTemplate x:DataType="models:Movie">
									<Border Margin="0,0,12,0"
											Stroke="#E9EBF5"
											StrokeThickness="1"
											StrokeShape="RoundRectangle 28"
											Background="White">
										<Grid ColumnDefinitions="{OnIdiom Default='1.2*,0.8*', Phone='1.2*'}"
                                              Padding="22"
                                              BackgroundColor="#1A2352">
                                            <Grid.Background>
                                                <LinearGradientBrush StartPoint="0,0"
                                                                     EndPoint="1,1">
                                                    <GradientStop Color="#1E264F" Offset="0" />
                                                    <GradientStop Color="#2B2F6C" Offset="0.55" />
                                                    <GradientStop Color="#12162B" Offset="1" />
                                                </LinearGradientBrush>
                                            </Grid.Background>

											<VerticalStackLayout Spacing="{OnIdiom Default=14, Phone=6}"
																 VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Border Background="#5663D6"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 999"
                                                            Padding="12,5">
                                                        <Label Text="FEATURED"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="10"
                                                               TextColor="White" />
                                                    </Border>
                                                    <Border Background="#2B356B"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 999"
                                                            Padding="12,5">
                                                        <Label Text="{Binding Format}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="10"
                                                               TextColor="#EDEFFF" />
                                                    </Border>
                                                    <Border Background="#39457B"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 999"
                                                            Padding="12,5">
                                                        <Label Text="{Binding PrimaryGenre}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="10"
                                                               TextColor="#EDEFFF" />
                                                    </Border>
                                                </HorizontalStackLayout>

                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="{Binding Title}"
                                                         FontFamily="OpenSansSemibold"
                                                           FontSize="28"
                                                           FontAttributes="Bold"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2"
                                                           TextColor="White" />
                                                    <Label Text="{Binding Tagline}"
                                                           FontSize="14"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2"
                                                           TextColor="#DCE4FF" />
                                                </VerticalStackLayout>

                                                <HorizontalStackLayout Spacing="10">
													<Border Background="#6A7090"
															StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 12"
                                                            Padding="10,6">
                                                        <Label Text="{Binding Rating, StringFormat='★ {0}'}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="12"
                                                               TextColor="#9ED0FF" />
                                                    </Border>
													<Border Background="#6A7090"
															StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 12"
                                                            Padding="10,6">
                                                        <Label Text="{Binding Duration}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="12"
                                                               TextColor="White" />
                                                    </Border>
													<Border Background="#6A7090"
															StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 12"
                                                            Padding="10,6">
                                                        <Label Text="{Binding Certificate}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="12"
                                                               TextColor="White" />
                                                    </Border>
                                                </HorizontalStackLayout>

                                                <Label Text="{Binding Synopsis}"
                                                       FontSize="13"
                                                       MaxLines="3"
                                                       LineBreakMode="TailTruncation"
                                                         TextColor="#D9DCF4" />

                                                <HorizontalStackLayout Spacing="10">
													<Button Text="Book Now"                                                    
                                                                                Background="#5B4BE3"
                                                                                TextColor="White"
                                                                                CornerRadius="16"
                                                                                HeightRequest="44"
                                                                                FontFamily="OpenSansSemibold"
                                                                                FontSize="13"
                                                                                CommandParameter="{Binding .}"
                                                                                behaviors:AnimateOnTap.IsEnabled="True"
                                                                                Clicked="OnBookNowClicked" />
													<Button Text="Trailer"
																				Background="#6A7090"
																				TextColor="White"
                                                                                CornerRadius="16"
                                                                                HeightRequest="44"
                                                                                FontFamily="OpenSansSemibold"
                                                                                FontSize="13"
                                                                                behaviors:AnimateOnTap.IsEnabled="True" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <Border Grid.Column="1"
													IsVisible="{OnIdiom Default=True, Phone=False}"
													HorizontalOptions="End"
                                                    VerticalOptions="Center"
                                                    WidthRequest="175"
                                                    HeightRequest="256"
                                                    Stroke="#38406F"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 24"
                                                    Background="#1D2754">
                                                <Grid>
                                                    <Grid.Background>
                                                        <LinearGradientBrush StartPoint="0,0"
                                                                             EndPoint="1,1">
                                                            <GradientStop Color="#27315D" Offset="0" />
                                                            <GradientStop Color="#171F3F" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Grid.Background>
                                                    <VerticalStackLayout HorizontalOptions="Center"
                                                                         VerticalOptions="Center"
                                                                         Spacing="10">
														<Label Text="🎬"
															   FontSize="60"
															   HorizontalTextAlignment="Center"
															   TextColor="#F0F3FF" />
													</VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </rotator:SfRotator.ItemTemplate>
                        </rotator:SfRotator>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView WidthRequest="8"
											 HeightRequest="20"
											 CornerRadius="4"
                                             Color="#4A3DE0"
                                             VerticalOptions="Center" />
                                    <Label Text="Now Showing"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#17182B" />
                                </HorizontalStackLayout>
                                <Label Text="Fresh releases and audience favorites"
                                       FontSize="13"
                                       TextColor="#5C5F76" />
                            </VerticalStackLayout>
                        </Grid>

						<syncfusion:SfListView ItemsSource="{Binding PopularMovies}"
											   ItemSpacing="{OnIdiom Default='8', Phone='4'}"
											   BackgroundColor="Transparent"
											   Orientation="Horizontal"
											   HeightRequest="{OnIdiom Default='390', Phone='360'}"
											   ScrollBarVisibility="Never"
											   AutoFitMode="DynamicHeight"
											   SelectionMode="None">
							<syncfusion:SfListView.ItemsLayout>
								<syncfusion:GridLayout SpanCount="1" />
							</syncfusion:SfListView.ItemsLayout>
							<syncfusion:SfListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Movie">
                                    <Border WidthRequest="220"
                                            Stroke="#DDE3F7"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 24"
                                            Background="White"
                                            Padding="10">
                                        <Border.Shadow>
                                            <Shadow Brush="#1A235218"
                                                    Offset="0,8"
                                                    Radius="18"
                                                    Opacity="0.16" />
                                        </Border.Shadow>
										<Border.Behaviors>
											<behaviors:HoverAnimationBehavior />
											<behaviors:TapAnimationBehavior />
										</Border.Behaviors>
										<Border.GestureRecognizers>
											<TapGestureRecognizer Tapped="OnMovieCardTapped"
																  CommandParameter="{Binding .}" />
										</Border.GestureRecognizers>
										<VerticalStackLayout Spacing="10">
                                            <Border HeightRequest="250"
                                                    Stroke="#223260"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 18">
                                                <Border.Shadow>
                                                    <Shadow Brush="#10172B40"
                                                            Offset="0,8"
                                                            Radius="18"
                                                            Opacity="0.22" />
                                                </Border.Shadow>
                                                <Grid RowDefinitions="Auto,*,Auto"
                                                      Padding="16">
                                                    <Grid.Background>
                                                        <LinearGradientBrush StartPoint="0,0"
                                                                             EndPoint="1,1">
                                                            <GradientStop Color="#1A2948" Offset="0" />
                                                            <GradientStop Color="#203A5A" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Grid.Background>
                                                    <HorizontalStackLayout Spacing="8">
                                                        <Border Background="#4F59CF"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 999"
                                                                Padding="10,5">
                                                            <Label Text="NOW SHOWING"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="9"
                                                                   TextColor="#F5F7FF" />
                                                        </Border>
                                                        <Border Background="#33447C"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 999"
                                                                Padding="10,5"
                                                                HorizontalOptions="EndAndExpand">
                                                            <Label Text="{Binding Rating, StringFormat='★ {0}'}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="9"
                                                                   TextColor="#B9D5FF" />
                                                        </Border>
                                                    </HorizontalStackLayout>
                                                    <VerticalStackLayout Grid.Row="1"
                                                                         VerticalOptions="Center"
                                                                         HorizontalOptions="Center"
                                                                         Spacing="10">
                                                        <Label Text="🎬"
                                                               FontSize="52"
                                                               HorizontalTextAlignment="Center"
                                                               TextColor="#EAF0FF" />
                                                        <Label Text="{Binding Title}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="3"
                                                               HorizontalTextAlignment="Center"
                                                               TextColor="#F6F7FC" />
                                                    </VerticalStackLayout>
												</Grid>
                                            </Border>

                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Title}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"
                                                       TextColor="#17182B" />
                                                <Label Text="{Binding Tagline}"
                                                       FontSize="11"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"
                                                       TextColor="#5B5D73" />
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding PrimaryGenre}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="12"
                                                           TextColor="#6A7090" />
                                                    <Label Text="·"
                                                           TextColor="#6A7090" />
                                                    <Label Text="{Binding Duration}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="12"
                                                           TextColor="#6A7090" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </syncfusion:SfListView.ItemTemplate>
                        </syncfusion:SfListView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView WidthRequest="8"
											 HeightRequest="20"
											 CornerRadius="4"
                                             Color="#5663D6"
                                             VerticalOptions="Center" />
                                    <Label Text="Coming Soon"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#17182B" />
                                </HorizontalStackLayout>
                                <Label Text="Upcoming premieres and next-month releases"
                                       FontSize="13"
                                       TextColor="#5C5F76" />
                            </VerticalStackLayout>
                        </Grid>

						<syncfusion:SfListView ItemsSource="{Binding ComingSoonMovies}"
											   ItemSpacing="{OnIdiom Default='8', Phone='4'}"
											   BackgroundColor="Transparent"
											   Orientation="Horizontal"
											   HeightRequest="{OnIdiom Default='390', Phone='360'}"
											   ScrollBarVisibility="Never"
											   AutoFitMode="DynamicHeight"
											   SelectionMode="None">
							<syncfusion:SfListView.ItemsLayout>
								<syncfusion:GridLayout SpanCount="1" />
							</syncfusion:SfListView.ItemsLayout>
							<syncfusion:SfListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Movie">
                                        <Border WidthRequest="220"
                                                Stroke="#ECECF4"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 22"
                                                Background="White"
                                                Padding="10">
                                            <Border.Behaviors>
                                                <behaviors:HoverAnimationBehavior />
                                                <behaviors:TapAnimationBehavior />
                                            </Border.Behaviors>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnMovieCardTapped"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="10">
                                                <Border HeightRequest="250"
                                                        Stroke="#38406F"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 18">
                                                    <Grid Padding="12">
                                                        <Grid.Background>
                                                            <LinearGradientBrush StartPoint="0,0"
                                                                                 EndPoint="1,1">
                                                                <GradientStop Color="#142C45" Offset="0" />
                                                                <GradientStop Color="#203B58" Offset="0.55" />
                                                                <GradientStop Color="#0C1220" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Grid.Background>
													<VerticalStackLayout HorizontalOptions="Center"
																		 VerticalOptions="Center"
																		 Spacing="10">
														<Label Text="🎬"
															   FontSize="60"
															   HorizontalTextAlignment="Center"
															   TextColor="#F0F3FF" />
														<Label Text="{Binding ReleaseDate, StringFormat='RELEASE ON {0}'}"
															   FontFamily="OpenSansSemibold"
															   FontSize="14"
															   HorizontalTextAlignment="Center"
															   TextColor="#F0F3FF" />
													</VerticalStackLayout>
												</Grid>
                                                </Border>

                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="{Binding Title}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2"
                                                           TextColor="#17182B" />
                                                    <Label Text="{Binding Tagline}"
                                                           FontSize="11"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2"
                                                           TextColor="#5B5D73" />
                                                </VerticalStackLayout>

                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding PrimaryGenre}"
                                                           FontSize="11"
                                                           TextColor="#5B5D73" />
                                                    <Label Text="·"
                                                           TextColor="#5B5D73" />
                                                    <Label Text="{Binding Duration}"
                                                           FontSize="11"
                                                           TextColor="#5B5D73" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </syncfusion:SfListView.ItemTemplate>
                            </syncfusion:SfListView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="0"
                  BackgroundColor="#FFFFFFC9"
                  IsVisible="{Binding IsLoading}">
                <ActivityIndicator IsRunning="True"
                                   IsVisible="True"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Color="#4A3DE0" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
