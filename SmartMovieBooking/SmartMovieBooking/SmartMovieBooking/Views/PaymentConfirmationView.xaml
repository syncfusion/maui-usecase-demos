<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:barcode="clr-namespace:Syncfusion.Maui.Barcode;assembly=Syncfusion.Maui.Barcode"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             x:Class="SmartMovieBooking.Views.PaymentConfirmationView"
             x:DataType="vm:PaymentConfirmationViewModel"
             Title="Booking Confirmed"
             BackgroundColor="#0B1020">
    <Grid Padding="20">
        <Border Background="#0B1020" />

        <Border MaximumWidthRequest="720"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Stroke="#DCE3F5"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 28"
                Background="#F7F9FF"
                Padding="24">
            <Border.Shadow>
                <Shadow Brush="#1A235220"
                        Offset="0,14"
                        Radius="30"
                        Opacity="0.24" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="8">
                        <Border Background="#EEF3FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                Padding="12,6"
                                HorizontalOptions="Start">
                            <Label Text="PAYMENT COMPLETE"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="10"
                                   CharacterSpacing="1.6"
                                   TextColor="#4A3DE0" />
                        </Border>

                        <Label Text="Booking Confirmed!"
                               FontFamily="OpenSansSemibold"
                               FontAttributes="Bold"
                               FontSize="28"
                               TextColor="#17182B" />
                        <Label Text="Your tickets have been booked successfully."
                               FontSize="14"
                               TextColor="#5C5F76" />
                    </VerticalStackLayout>

                    <Grid HeightRequest="96"
                          WidthRequest="96"
                          HorizontalOptions="End"
                          VerticalOptions="Start">
                        <Ellipse Fill="#9DEAF6"
                                 WidthRequest="96"
                                 HeightRequest="96" />
                        <Label Text="✓"
                               FontSize="48"
                               FontFamily="OpenSansSemibold"
                               FontAttributes="Bold"
                               TextColor="#062A33"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Grid>

                <syncfusionCards:SfCardView CornerRadius="24"
                                            BackgroundColor="#FFFFFF"
                                            Padding="18">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="BOOKING ID"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="10"
                                   TextColor="#7A7B8C" />
                            <Label Text="{Binding BookingId}"
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#1A1A2E" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="TOTAL PAID"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="10"
                                   TextColor="#7A7B8C" />
                            <Label Text="{Binding FormattedTotal}"
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#3525CD" />
                        </VerticalStackLayout>
                    </Grid>
                </syncfusionCards:SfCardView>

                <syncfusionCards:SfCardView CornerRadius="24"
                                            BackgroundColor="#FFFFFF"
                                            Padding="18">
                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                        <Label Text="TICKET DETAILS"
                               FontFamily="OpenSansSemibold"
                               FontSize="10"
                               TextColor="#7A7B8C" />
                        <Grid Padding="0,12,0,12"
                              Grid.Row="1"
                              Grid.Column="0"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                                <Label Text="{Binding MovieTitle}"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#1A1A2E" />
                                <Label Text="{Binding TheaterName}"
                                       FontSize="12"
                                       TextColor="#49454F" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="8">
                                <Label Text="{Binding ShowtimeLabel}"
                                       FontSize="12"
                                       TextColor="#49454F" />
                                <Label Text="{Binding SeatsDisplay, StringFormat=Seats: {0}}"
                                       FontSize="12"
                                       TextColor="#49454F" />
                            </VerticalStackLayout>
                        </Grid>
                        <barcode:SfBarcodeGenerator Grid.Column="1"
                                                    Grid.RowSpan="2"
                                                    Value="{Binding BookingId}"
                                                    ShowText="False"
                                                    WidthRequest="100"
                                                    HeightRequest="100"
                                                    HorizontalOptions="End">
                            <barcode:SfBarcodeGenerator.Symbology>
                                <barcode:QRCode />
                            </barcode:SfBarcodeGenerator.Symbology>
                        </barcode:SfBarcodeGenerator>
                    </Grid>
                </syncfusionCards:SfCardView>

                <HorizontalStackLayout HorizontalOptions="End"
                                       Spacing="10"
                                       Margin="0,4,0,0">
                    <syncfusionButtons:SfButton Text="Back to Home"
                                               BackgroundColor="#3525CD"
                                               TextColor="#FFFFFF"
                                               CornerRadius="10"
                                               FontFamily="OpenSansSemibold"
                                               HeightRequest="44"
                                               Clicked="OnDoneClicked"
                                               HorizontalOptions="Fill" />
                    <syncfusionButtons:SfButton Text="View Bookings"
                                               BackgroundColor="#EEF1FF"
                                               TextColor="#1A1A2E"
                                               CornerRadius="10"
                                               FontFamily="OpenSansSemibold"
                                               HeightRequest="44"
                                               Clicked="OnViewBookingsClicked"
                                               HorizontalOptions="Fill" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
