<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DiagramBuilder.Views.DiagramDesignerPage"
             xmlns:constants="clr-namespace:DiagramBuilder.Constants"
             xmlns:controls="clr-namespace:DiagramBuilder.Controls;assembly=DiagramBuilder"
             xmlns:behaviors="clr-namespace:DiagramBuilder.Behaviors;assembly=DiagramBuilder"
             xmlns:diagram="clr-namespace:Syncfusion.Maui.Diagram;assembly=Syncfusion.Maui.Diagram"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Name="RootPage"
             Title="{Binding DocumentTitle}"
             BackgroundColor="{DynamicResource WindowBackground}">

    <!--
      3-column designer frame per ui-spec.md §1: Shapes | Canvas | Properties.
      Rows: title / menu / toolbar / content / status; columns: 280 /* / 320.
      Panels collapse to 0 width via WINDOW menu toggles.

      The Shapes panel uses the native Syncfusion SymbolPalette (not the custom
      StencilPanelControl) so drag-and-drop to the canvas works out of the box.
      The SymbolPalette and the SfDiagram live as direct Grid siblings of the
      row-level content Grid (architecture.md §3.3) — that is the
      shape Syncfusion's "SymbolPalette must be a sibling of SfDiagram" rule
      requires.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          ColumnDefinitions="Auto,*,Auto"
          Padding="8"
          ColumnSpacing="8">

        <!-- Row 0: title -->
        <StackLayout Grid.Row="0" Grid.ColumnSpan="3"
                     Orientation="Horizontal" Spacing="8">
            <Label Text="{x:Static constants:AppStrings.AppTitle}"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}"
                   VerticalOptions="Center" />
            <Label Text="{Binding DocumentTitle}"
                   FontSize="13"
                   TextColor="{DynamicResource TextSecondary}"
                   VerticalOptions="Center" />
        </StackLayout>

        <!-- Row 1: menu bar -->
        <controls:MenuBarControl x:Name="MenuBar"
                                  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                  ItemsSource="{Binding MenuBar.Roots}"
                                  MenuCommand="{Binding MenuBar.MenuCommand}" />

        <!-- Row 2: toolbar (collapsible) -->
        <controls:ToolbarControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                 IsVisible="{Binding ShowToolbar}"
                                 ItemsSource="{Binding Toolbar.Items}"
                                 ToolCommand="{Binding Toolbar.ToolCommand}"
                                 HasSingleSelection="{Binding Toolbar.HasSingleSelection}"
                                 CurrentZoom="{Binding Zoom.CurrentZoom}"
                                 ZoomLevels="{Binding Zoom.Levels}"
                                 SetZoomCommand="{Binding Zoom.SetZoomLevelCommand}"
                                 ShowPropertiesCommand="{Binding TogglePropertiesCommand}" />

        <!-- Row 3: content area. The Shapes panel lives in its own Border (left)
             so the SymbolPalette can sit in column 0 of the inner Grid, and the
             SfDiagram can sit in column 1 — they're direct Grid siblings, which
             is what Syncfusion needs for native drag-and-drop. The same Border
             also wraps the diagram so the canvas has the matching rounded edge.
             The whole Row-3 area is hidden when the shapes toggle is off and a
             full-bleed Workspace takes over. -->
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
              ColumnDefinitions="280,*" ColumnSpacing="8"
              IsVisible="{Binding ShowStencil}">
            <Border Grid.Column="0"
                    Stroke="{DynamicResource PanelBorderBrush}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource PanelBackground}">
                <Border.StrokeShape>
                    <shapes:RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,*">
                    <controls:PanelHeaderControl x:Name="ShapesHeader"
                                                 Grid.Row="0"
                                                 Title="Shapes" />
                    <diagram:SymbolPalette x:Name="ShapesPalette"
                                           Grid.Row="1"
                                           VerticalOptions="Fill"
                                           HorizontalOptions="Fill"
                                           Margin="8"
                                           SymbolWidth="64"
                                           SymbolHeight="64"
                                           EnableSearch="True"
                                           ExpandMode="Multiple" />
                </Grid>
            </Border>
            <controls:DiagramWorkspaceControl x:Name="WorkspaceWithShapes"
                                               Grid.Column="1"
                                               Margin="0" />
        </Grid>

        <!-- Full-bleed canvas when shapes panel is hidden (fills columns 0–1). -->
        <controls:DiagramWorkspaceControl x:Name="WorkspaceFullBleed"
                                           Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Margin="0"
                                           IsVisible="{Binding ShowStencil, Converter={StaticResource InvertBoolConverter}}" />

        <!-- Properties (right, 320 px, collapsible) -->
        <controls:PropertyPanelControl x:Name="PropertyPanel"
                                       Grid.Row="3" Grid.Column="2"
                                       BindingContext="{Binding PropertyPanel}"
                                       WidthRequest="320"
                                       IsVisible="{Binding Source={x:Reference RootPage}, Path=BindingContext.ShowProperties}" />

        <!-- Row 4: status bar -->
        <Border Grid.Row="4" Grid.ColumnSpan="3"
                Stroke="{DynamicResource PanelBorderBrush}"
                StrokeThickness="1"
                BackgroundColor="{DynamicResource PanelBackground}"
                HeightRequest="26">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="12,4">
                <Label Grid.Column="0"
                       Text="{Binding Status}"
                       FontSize="11"
                       TextColor="{DynamicResource TextSecondary}"
                       VerticalOptions="Center" />
                <controls:ZoomIndicatorControl Grid.Column="1"
                                                ZoomPercent="{Binding Zoom.CurrentZoomText}"
                                                ShowGrid="{Binding Zoom.ShowGrid}"
                                                SnapToGrid="{Binding Zoom.SnapToGrid}" />
            </Grid>
        </Border>

    </Grid>

    <ContentPage.Behaviors>
        <behaviors:DiagramKeyboardBehavior ShortcutCommand="{Binding MenuBar.MenuCommand}" />
    </ContentPage.Behaviors>
</ContentPage>
