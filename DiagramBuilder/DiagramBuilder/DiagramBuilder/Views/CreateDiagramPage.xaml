<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:constants="clr-namespace:DiagramBuilder.Constants"
             xmlns:models="clr-namespace:DiagramBuilder.Models"
             x:Class="DiagramBuilder.Views.CreateDiagramPage"
             Title="{Binding Title}"
             BackgroundColor="#00000000">

    <Grid Padding="32"
          BackgroundColor="#80000000">
        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="920"
                HeightRequest="590"
                BackgroundColor="{DynamicResource WindowBackground}"
                Stroke="{DynamicResource PanelBorderBrush}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="24,18,18,12"
                      ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Title}"
                           FontSize="24"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Button Grid.Column="1"
                            Text="X"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource TextPrimary}"
                            Clicked="OnCloseClicked" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="220,*">
                    <Border BackgroundColor="{DynamicResource CanvasBackground}"
                            Stroke="{DynamicResource PanelBorderBrush}"
                            StrokeThickness="0,1,1,0">
                        <ScrollView>
                            <VerticalStackLayout Spacing="8" Padding="0,0,0,0">
                                <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border HeightRequest="36"
                                                    Padding="22,0"
                                                    BackgroundColor="Transparent">
                                                <Label Text="{Binding .}"
                                                       VerticalOptions="Center"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Border>

                    <Grid Grid.Column="1" Padding="16,14" RowDefinitions="Auto,*" RowSpacing="14">
                        <CollectionView ItemsSource="{Binding Templates}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical"
                                                 Span="2"
                                                 HorizontalItemSpacing="16"
                                                 VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiagramTemplate">
                                    <VerticalStackLayout WidthRequest="214" Spacing="10">
                                        <Border HeightRequest="202"
                                                BackgroundColor="{DynamicResource CanvasBackground}"
                                                Stroke="{DynamicResource PanelBorderBrush}"
                                                StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0" />
                                            </Border.StrokeShape>
                                            <Grid>
                                                <Label Text="+"
                                                       FontSize="64"
                                                       TextColor="{DynamicResource TextSecondary}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Title}"
                                               FontSize="16"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>