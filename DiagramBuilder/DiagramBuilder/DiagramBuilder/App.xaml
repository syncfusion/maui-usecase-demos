<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DiagramBuilder"
             xmlns:converters="clr-namespace:DiagramBuilder.Converters"
             x:Class="DiagramBuilder.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Templates/StencilItemTemplate.xaml" />
                <ResourceDictionary Source="Templates/PropertyEditorTemplates.xaml" />
                <ResourceDictionary Source="Templates/TemplateCardTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
            <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
            <converters:ZoomToPercentConverter x:Key="ZoomToPercentConverter" />
            <converters:SelectionKindToVisibilityConverter x:Key="SelectionKindToVisibilityConverter" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
            <converters:CategoryAccentConverter x:Key="CategoryAccentConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>