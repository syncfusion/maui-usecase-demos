<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls">

    <!--
        Diagram Builder — base control styles (light theme, desktop-first).
        Palette keys come from Colors.xaml; type scale: Title 20 Sb / Section 14 Sb /
        Body 13 / Caption 11. Spacing: 8 px grid, panel padding 12.
    -->

    <!-- ============ Implicit base styles ============ -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource WindowBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource WindowBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource PanelBorderColor}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource PanelBackground}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="36" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource HoverBackground}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="MinimumWidthRequest" Value="32" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Color" Value="{DynamicResource PanelBorderColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="MinimumWidthRequest" Value="32" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                            <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource PanelBorderColor}" />
        <Setter Property="ThumbColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="MinimumTrackColor" Value="{DynamicResource PanelBorderColor}" />
                            <Setter Property="MaximumTrackColor" Value="{DynamicResource PanelBorderColor}" />
                            <Setter Property="ThumbColor" Value="{DynamicResource PanelBorderColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{DynamicResource PanelBorderColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ============ Named styles (referenced via ResourceKeys) ============ -->

    <!-- 36x36 transparent icon button for the toolbar; hover #EFEFEF, pressed #E0E0E0, disabled 40% opacity. -->
    <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource HoverBackground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#E0E0E0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Active-tool variant: SelectionBlue background, white glyph. -->
    <Style x:Key="ToolbarIconActiveStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource SelectionBlue}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#1E88E5" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#1565C0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Property panel field: 32 px tall, PanelBorderColor border. -->
    <Style x:Key="PropertyEntryStyle" TargetType="Entry">
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CanvasBackground}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- Uppercase 11 px letter-spaced section header (property panel groups). -->
    <Style x:Key="PropertySectionHeaderStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <!-- Two-column row label in the property panel. -->
    <Style x:Key="PropertyLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Flyout menu item row: 32 px tall, hover highlight. -->
    <Style x:Key="MenuFlyoutItemStyle" TargetType="Button">
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource HoverBackground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Panel header title ("Shapes", "Properties"). -->
    <Style x:Key="PanelTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- 11 px helper/hint text. -->
    <Style x:Key="CaptionStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- Panel chrome: PanelBackground surface with 1 px PanelBorderColor border. -->
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource PanelBackground}" />
        <Setter Property="Stroke" Value="{DynamicResource PanelBorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Flyout/popup chrome: white, 8 px radius, 1 px border. -->
    <Style x:Key="FlyoutPopupStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource CanvasBackground}" />
        <Setter Property="Stroke" Value="{DynamicResource PanelBorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="8" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Radius="8" Offset="2,4" Opacity="0.2" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu bar root (File/Edit/View/Arrange/Window). White mixed-case on the blue chrome;
         hover = translucent white; the open root is set to a solid white pill + blue text by
         code-behind (tracked via SfPopup.Opened/Closed, since "active" is not a built-in state). -->
    <Style x:Key="MenuRootStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Margin" Value="2,4" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#1AFFFFFF" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#33FFFFFF" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Open/active root: solid white pill, blue label (set by MenuBarControl). -->
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="White" />
                            <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Active (open) menu root: solid white pill, blue label. Swapped in by code-behind via
         SfPopup.Opened/Closed (the "open root" is not a built-in Button state in .NET 9). -->
    <Style x:Key="MenuRootActiveStyle" TargetType="Button" BasedOn="{StaticResource MenuRootStyle}">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <!-- Menu flyout row: a Grid hosting the check mark / label / shortcut. The row itself has
         no background; its interaction states are painted by the transparent Button that sits
         beneath the labels (see MenuRowHitAreaStyle). -->
    <Style x:Key="MenuFlyoutRowStyle" TargetType="Grid">
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- The interaction + visual-state host for a menu row. A full-width, transparent Button
         under the labels: it is the only element whose visual-state manager reliably fires the
         pressed/touch overlay on Android in this MAUI build, so it supplies the fill for every
         state. Text is empty (the visible text is the labels on top, set InputTransparent).
         States: hover (PointerOver) = light gray, pressed/touch (Pressed) = darker gray,
         keyboard focus (Focused) = subtle blue, selection (Selected) = light blue. -->
    <Style x:Key="MenuRowHitAreaStyle" TargetType="Button">
        <Setter Property="Text" Value="" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <!-- Buttons default to a 44px touch target; zero it out so the row stays the compact
             30px height the design calls for. -->
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#F1F3F4" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#E8EAED" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#E3F2FD" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#E3F2FD" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Menu flyout section header (e.g. ARRANGE "Align Objects"). -->
    <Style x:Key="MenuFlyoutHeaderStyle" TargetType="Grid">
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="ColumnSpacing" Value="8" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <!-- Zoom chip: 28 px pill; active state = PrimaryColor background, white text. -->
    <Style x:Key="ZoomChipStyle" TargetType="Button">
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource HoverBackground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ZoomChipActiveStyle" TargetType="Button" BasedOn="{StaticResource ZoomChipStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <!-- Status bar row text. -->
    <Style x:Key="StatusBarTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

</ResourceDictionary>
