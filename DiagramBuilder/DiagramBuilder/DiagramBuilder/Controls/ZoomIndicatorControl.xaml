<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DiagramBuilder.Controls.ZoomIndicatorControl">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="StatusChipStyle" TargetType="Border">
                <Setter Property="Stroke" Value="{DynamicResource PanelBorderBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="StatusChipTextStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid ColumnDefinitions="Auto,Auto,Auto"
          ColumnSpacing="8"
          HorizontalOptions="End"
          VerticalOptions="Center">

        <Border x:Name="ZoomChip"
                Style="{StaticResource StatusChipStyle}"
                Grid.Column="0">
            <Label x:Name="ZoomLabel"
                   Style="{StaticResource StatusChipTextStyle}" />
        </Border>

        <Border x:Name="GridChip"
                Style="{StaticResource StatusChipStyle}"
                Grid.Column="1">
            <Label x:Name="GridLabel"
                   Style="{StaticResource StatusChipTextStyle}" />
        </Border>

        <Border x:Name="SnapChip"
                Style="{StaticResource StatusChipStyle}"
                Grid.Column="2">
            <Label x:Name="SnapLabel"
                   Style="{StaticResource StatusChipTextStyle}" />
        </Border>
    </Grid>
</ContentView>