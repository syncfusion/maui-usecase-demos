<?xml version="1.0" encoding="utf-8" ?>
<!--
  Color swatch + dropdown trigger. The design shows a small square swatch with a
  chevron button beside it; tapping either opens the SfColorPicker popup.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="DiagramBuilder.Controls.ColorPickerButton">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="ColorPickerSwatchStyle" TargetType="Border">
                <Setter Property="Stroke" Value="{DynamicResource PanelBorderBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="HeightRequest" Value="30" />
                <Setter Property="WidthRequest" Value="30" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>
            <Style x:Key="ColorPickerSwatchFillStyle" TargetType="BoxView">
                <Setter Property="WidthRequest" Value="26" />
                <Setter Property="HeightRequest" Value="26" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <HorizontalStackLayout Spacing="2">
        <Border x:Name="SwatchFrame"
                Style="{StaticResource ColorPickerSwatchStyle}">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>
            <BoxView x:Name="SwatchFill"
                     Style="{StaticResource ColorPickerSwatchFillStyle}"
                     CornerRadius="2" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSwatchTapped" />
            </Border.GestureRecognizers>
        </Border>
    </HorizontalStackLayout>
</ContentView>
