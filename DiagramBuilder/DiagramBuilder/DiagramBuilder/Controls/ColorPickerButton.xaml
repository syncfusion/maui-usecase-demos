<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="DiagramBuilder.Controls.ColorPickerButton">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="ColorPickerSwatchStyle" TargetType="Border">
                <Setter Property="Stroke" Value="{DynamicResource PanelBorderBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="WidthRequest" Value="28" />
                <Setter Property="HeightRequest" Value="28" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style x:Key="ColorPickerSwatchFillStyle" TargetType="BoxView">
                <Setter Property="WidthRequest" Value="22" />
                <Setter Property="HeightRequest" Value="22" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Border x:Name="SwatchFrame"
            Style="{StaticResource ColorPickerSwatchStyle}"
            StrokeShape="RoundRectangle 4">
        <Grid>
            <BoxView x:Name="SwatchFill"
                     Style="{StaticResource ColorPickerSwatchFillStyle}"
                     CornerRadius="2" />
        </Grid>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnSwatchTapped" />
        </Border.GestureRecognizers>
    </Border>

    <ContentView.Flyout>
        <Flyout x:Name="PickerFlyout">
            <inputs:SfColorPicker x:Name="Picker"
                                  ColorChanged="OnColorChanged"
                                  ColorMode="Spectrum"
                                  ShowAlphaSlider="True"
                                  ShowInputArea="True" />
        </Flyout>
    </ContentView.Flyout>
</ContentView>