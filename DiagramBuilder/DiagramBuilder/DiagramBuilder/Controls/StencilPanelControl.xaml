<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:expander="clr-namespace:Syncfusion.Maui.Accordion;assembly=Syncfusion.Maui.Expander"
             xmlns:controls="clr-namespace:DiagramBuilder.Controls;assembly=DiagramBuilder"
             x:Class="DiagramBuilder.Controls.StencilPanelControl">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="StencilGroupHeaderStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1" />
                <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
            </Style>
            <Style x:Key="StencilSearchEntryStyle" TargetType="Entry">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
            <Style x:Key="StencilNoResultsStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,16" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Border Stroke="{DynamicResource PanelBorderBrush}"
            StrokeThickness="1"
            BackgroundColor="{DynamicResource PanelBackground}">
        <Border.StrokeShape>
            <shapes:RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="0">

            <!-- Panel header with collapse chevron -->
            <controls:PanelHeaderControl x:Name="Header"
                                         Grid.Row="0"
                                         Title="{Binding Title}" />

            <!-- Search entry bound to StencilViewModel.FilterText -->
            <Border Grid.Row="1"
                    Stroke="{DynamicResource PanelBorderBrush}"
                    StrokeThickness="1"
                    Margin="12,4,12,8"
                    Padding="8,0">
                <Border.StrokeShape>
                    <shapes:RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <Entry x:Name="SearchEntry"
                       Placeholder="{Binding SearchPlaceholder}"
                       Style="{StaticResource StencilSearchEntryStyle}" />
            </Border>

            <!-- Accordion of categories: one SfExpander per StencilGroup.
                 (SfAccordion has no ItemsSource — its Items collection takes
                 AccordionItem views only, so groups are bound via a DataTemplate.) -->
            <ScrollView Grid.Row="2"
                        VerticalScrollBarVisibility="Never">
                <CollectionView ItemsSource="{Binding VisibleGroups}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <expander:SfExpander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <expander:SfExpander.Header>
                                    <Grid Padding="12,10"
                                          ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Title}"
                                               Style="{StaticResource StencilGroupHeaderStyle}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding ItemCountText}"
                                               Style="{StaticResource StencilGroupHeaderStyle}"
                                               TextColor="{DynamicResource TextSecondary}" />
                                    </Grid>
                                </expander:SfExpander.Header>
                                <expander:SfExpander.Content>
                                    <CollectionView ItemsSource="{Binding Items}">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout ItemSpacing="4"
                                                                Orientation="Vertical" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Stroke="{DynamicResource PanelBorderBrush}"
                                                        StrokeThickness="1"
                                                        Padding="8,6"
                                                        Margin="8,4"
                                                        BackgroundColor="{DynamicResource CanvasBackground}">
                                                    <Border.StrokeShape>
                                                        <shapes:RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <StackLayout Spacing="4">
                                                        <BoxView HeightRequest="36"
                                                                 WidthRequest="36"
                                                                 HorizontalOptions="Center"
                                                                 BackgroundColor="{DynamicResource HoverBackground}" />
                                                        <Label Text="{Binding DisplayName}"
                                                               FontSize="11"
                                                               HorizontalTextAlignment="Center"
                                                               TextColor="{DynamicResource TextPrimary}" />
                                                    </StackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </expander:SfExpander.Content>
                            </expander:SfExpander>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </Grid>
    </Border>
</ContentView>