<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:diagram="clr-namespace:Syncfusion.Maui.Diagram;assembly=Syncfusion.Maui.Diagram"
             xmlns:behaviors="clr-namespace:DiagramBuilder.Behaviors;assembly=DiagramBuilder"
             xmlns:controls="clr-namespace:DiagramBuilder.Controls;assembly=DiagramBuilder"
             x:Class="DiagramBuilder.Controls.DiagramWorkspaceControl">
    <ContentView.Resources>
        <ResourceDictionary />
    </ContentView.Resources>

    <Border Stroke="{DynamicResource PanelBorderBrush}"
            StrokeThickness="1"
            BackgroundColor="{DynamicResource CanvasBackground}">
        <Grid RowDefinitions="*">

            <!-- Canvas grid: SfDiagram alone — the SymbolPalette is rendered as the
                 standalone Shapes panel (StencilPanelControl) to match the design
                 (single column layout: Shapes | Canvas | Properties). -->
            <Grid x:Name="DiagramGrid"
                  Grid.Row="0"
                  ColumnDefinitions="*"
                  ColumnSpacing="0">

                <!-- Kept hidden so the surface-behavior code-behind that walks the
                     symbol palette host (DiagramWorkspaceControl.xaml.cs) continues
                     to compile, but no UI is rendered. -->
                <diagram:SymbolPalette x:Name="Palette"
                                       Grid.Column="0"
                                       IsVisible="False" />

                <diagram:SfDiagram x:Name="Diagram"
                                   Grid.Column="0"
                                   BackgroundColor="{DynamicResource CanvasBackground}">
                    <diagram:SfDiagram.Behaviors>
                        <behaviors:DiagramSurfaceBehavior x:Name="SurfaceBehavior" />
                    </diagram:SfDiagram.Behaviors>
                </diagram:SfDiagram>
            </Grid>
        </Grid>
    </Border>
</ContentView>