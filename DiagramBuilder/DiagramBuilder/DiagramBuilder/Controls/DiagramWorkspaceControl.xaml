<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:diagram="clr-namespace:Syncfusion.Maui.Diagram;assembly=Syncfusion.Maui.Diagram"
             xmlns:behaviors="clr-namespace:DiagramBuilder.Behaviors;assembly=DiagramBuilder"
             xmlns:controls="clr-namespace:DiagramBuilder.Controls;assembly=DiagramBuilder"
             x:Class="DiagramBuilder.Controls.DiagramWorkspaceControl">
    <ContentView.Resources>
        <ResourceDictionary />
    </ContentView.Resources>

    <Border Stroke="{DynamicResource PanelBorderBrush}"
            StrokeThickness="1"
            BackgroundColor="{DynamicResource CanvasBackground}">
        <Grid RowDefinitions="*">

            <!-- Canvas grid: SfDiagram and SymbolPalette MUST be direct Grid siblings
                 (architecture.md §3.3 — sibling discovery walks immediate children only). -->
            <Grid x:Name="DiagramGrid"
                  Grid.Row="0"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="0">

                <!-- Shared SymbolPalette host (rendered if PaletteGroups is set) -->
                <diagram:SymbolPalette x:Name="Palette"
                                       Grid.Column="0"
                                       VerticalOptions="Start"
                                       Margin="8,8,0,8"
                                       SymbolWidth="64"
                                       SymbolHeight="64"
                                       EnableSearch="True"
                                       ExpandMode="Multiple"
                                       IsVisible="False" />

                <diagram:SfDiagram x:Name="Diagram"
                                   Grid.Column="1"
                                   BackgroundColor="{DynamicResource CanvasBackground}">
                    <diagram:SfDiagram.Behaviors>
                        <!-- DiagramSurfaceBehavior exposes bindable Command properties.
                             They cannot be bound from XAML via {x:Reference Workspace}
                             because 'Workspace' is the x:Name in the parent page, not in
                             this file's scope (which only contains DiagramGrid, Palette,
                             Diagram and SurfaceBehavior). Instead, DiagramWorkspaceControl
                             exposes matching BindableProperties (ReadyCommand etc.) with
                             property-changed callbacks that propagate the value into the
                             behavior — see DiagramWorkspaceControl.xaml.cs. -->
                        <behaviors:DiagramSurfaceBehavior x:Name="SurfaceBehavior" />
                    </diagram:SfDiagram.Behaviors>
                </diagram:SfDiagram>
            </Grid>
        </Grid>
    </Border>
</ContentView>