<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DiagramBuilder.Controls;assembly=DiagramBuilder"
             x:Class="DiagramBuilder.Controls.PropertyPanelControl">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="PropertyEmptyTitleStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1" />
                <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>
            <Style x:Key="PropertyEmptyBodyStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,4" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Border Stroke="{DynamicResource PanelBorderBrush}"
            StrokeThickness="1"
            BackgroundColor="{DynamicResource PanelBackground}">
        <Grid RowDefinitions="Auto,*">
            <controls:PanelHeaderControl x:Name="_header"
                                         Grid.Row="0"
                                         Title="{Binding Title}" />

            <!--
              The panel always has content: with a shape selected it shows that
              shape's properties, with nothing selected it shows the drawing-area
              (page) settings. Sections are rebuilt from SectionGroups /
              SectionTitles (AppStrings) in code-behind.
            -->
            <ScrollView x:Name="SectionsScroll"
                        Grid.Row="1">
                <VerticalStackLayout x:Name="SectionsStack"
                                     Spacing="0"
                                     Padding="12,4,12,12" />
            </ScrollView>
        </Grid>
    </Border>
</ContentView>
