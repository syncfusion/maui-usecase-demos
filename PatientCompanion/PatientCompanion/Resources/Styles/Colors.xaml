<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Brand Colors -->

    <Color x:Key="PrimaryColor">#00685F</Color>
    <Color x:Key="PrimaryLightColor">#14B8A6</Color>
    <Color x:Key="AccentColor">#06B6D4</Color>

    <!-- Backgrounds -->

    <Color x:Key="PageBackgroundColor">#F7F9FB</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>

    <!-- Text -->

    <Color x:Key="PrimaryTextColor">#1F2937</Color>
    <Color x:Key="SecondaryTextColor">#6B7280</Color>

    <!-- Status -->

    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>

    <!-- Borders -->

    <Color x:Key="BorderColor">#E5E7EB</Color>
</ResourceDictionary>
