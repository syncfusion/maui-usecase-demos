<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:listview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:vm="clr-namespace:FluentMail.ViewModels"
             x:Class="FluentMail.Views.DeletedItemsPage"
             x:DataType="vm:DeletedItemsViewModel"
             Title="Deleted">
    <ContentPage.BindingContext>
        <vm:DeletedItemsViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <Label Text="Deleted items" FontSize="24" FontAttributes="Bold" />
        <HorizontalStackLayout Grid.Row="1" Spacing="12">
            <Button Text="Restore" Command="{Binding RestoreCommand}" CommandParameter="{Binding Source={x:Reference DeletedList}, Path=SelectedItem}" />
            <Button Text="Empty Trash" Command="{Binding EmptyTrashCommand}" />
        </HorizontalStackLayout>
        <Grid Grid.Row="2">
            <listview:SfListView x:Name="DeletedList" ItemsSource="{Binding DeletedItems}" SelectionMode="Single">
                <listview:SfListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Stroke="{AppThemeBinding Light=#D8DEE9, Dark=#2A2F3A}" StrokeThickness="1" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Sender}" FontAttributes="Bold" />
                                <Label Text="{Binding Subject}" />
                                <Label Text="{Binding Preview}" FontSize="12" TextColor="{AppThemeBinding Light=#5C5C5C, Dark=#B7BDC8}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </listview:SfListView.ItemTemplate>
            </listview:SfListView>
            <Border IsVisible="{Binding IsEmpty}" BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#1A1D23}" Padding="20">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="No deleted items" HorizontalTextAlignment="Center" />
                    <Label Text="Messages automatically removed after 30 days." HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
