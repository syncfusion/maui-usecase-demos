<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:listview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:vm="clr-namespace:FluentMail.ViewModels"
             x:Class="FluentMail.Views.ArchivePage"
             x:DataType="vm:ArchiveViewModel"
             Title="Archive">
    <ContentPage.BindingContext>
        <vm:ArchiveViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Archive" FontSize="24" FontAttributes="Bold" />
                <Label Text="Work messages preserved for reference" TextColor="{AppThemeBinding Light=#5C5C5C, Dark=#B7BDC8}" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <Label FontFamily="MauiMaterialAssets" Text="&#xE5D4;" FontSize="18" TextColor="{AppThemeBinding Light=#0F6CBD, Dark=#4DA3FF}" />
                <Label Text="Filter" TextColor="{AppThemeBinding Light=#0F6CBD, Dark=#4DA3FF}" />
            </HorizontalStackLayout>
        </Grid>
        <ScrollView Grid.Row="1" Orientation="Horizontal">
            <HorizontalStackLayout Spacing="8">
                <Border BackgroundColor="{AppThemeBinding Light=#EAF2FF, Dark=#20324D}" Padding="10,6" StrokeThickness="0">
                    <Label Text="All" />
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#1A1D23}" Padding="10,6" StrokeThickness="0">
                    <Label Text="Has Files" />
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#1A1D23}" Padding="10,6" StrokeThickness="0">
                    <Label Text="This Year" />
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#1A1D23}" Padding="10,6" StrokeThickness="0">
                    <Label Text="Flagged" />
                </Border>
            </HorizontalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#1A1D23}" Padding="12">
            <VerticalStackLayout>
                <Label Text="Archive storage" FontAttributes="Bold" />
                <Label Text="Used Space: 3.4 GB" />
                <Label Text="Remaining Space: 18.6 GB" />
                <Label Text="Sync Status: Local sample data" />
            </VerticalStackLayout>
        </Border>
        <Grid Grid.Row="3">
            <listview:SfListView ItemsSource="{Binding VisibleItems}" SelectionMode="Single">
                <listview:SfListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Stroke="{AppThemeBinding Light=#D8DEE9, Dark=#2A2F3A}" StrokeThickness="1" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Sender}" FontAttributes="Bold" />
                                <Label Text="{Binding Subject}" />
                                <Label Text="{Binding Preview}" FontSize="12" TextColor="{AppThemeBinding Light=#5C5C5C, Dark=#B7BDC8}" />
                                <Label Text="{Binding ArchivedOn, StringFormat='Archived {0:d}'}" FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </listview:SfListView.ItemTemplate>
            </listview:SfListView>
            <Border IsVisible="{Binding IsEmpty}" BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#1A1D23}" Padding="20">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="No archived items found" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
