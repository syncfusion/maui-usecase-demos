<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.TreeView;assembly=Syncfusion.Maui.TreeView"
             xmlns:listview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:vm="clr-namespace:FluentMail.ViewModels"
             xmlns:richtext="clr-namespace:Syncfusion.Maui.RichTextEditor;assembly=Syncfusion.Maui.RichTextEditor"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:controls="clr-namespace:FluentMail.Views.Controls"
             x:Class="FluentMail.Views.MailWorkspacePage"
             x:Name="MailWorkspaceRoot"
             x:DataType="vm:MailWorkspaceViewModel"
             Title="Mail"
             BackgroundColor="{AppThemeBinding Light=#F3F3F3, Dark=#1E1E1E}">
    <ContentPage.BindingContext>
        <vm:MailWorkspaceViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="56,1,*" ColumnDefinitions="300,380,1,*" Padding="0" BackgroundColor="White">
        
        <Grid HeightRequest="64"
              Grid.ColumnSpan="4"
              Padding="16,10"
              ColumnDefinitions="Auto,*,Auto">

            <!-- New Mail -->
            <buttons:SfButton Grid.Column="0"
                              Command="{Binding NewMailCommand}"
                              Background="#106EBE"
                              CornerRadius="6"
                              HeightRequest="44"
                              WidthRequest="120"
                              HorizontalTextAlignment="Center"
                              Padding="16,6">

                <buttons:SfButton.Content>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                         <!--Compose Icon--> 
                        <Label FontFamily="MauiMaterialAssets"
                               Text="&#xE756;"
                               FontSize="18"
                               TextColor="White"
                               VerticalOptions="Center" />

                         <!--Text--> 
                        <Label Text="New Mail"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </buttons:SfButton.Content>

            </buttons:SfButton>

            <!-- Search -->
            <Border Grid.Column="1"
                    Margin="24,0"
                    BackgroundColor="White"
                    Stroke="#D9D9D9"
                    StrokeShape="RoundRectangle 6"
                    HeightRequest="44"
                    VerticalOptions="Center">

                <Grid ColumnDefinitions="Auto,*"
                      Padding="12,0">

                    <Label Grid.Column="0"
                           Text="&#xE715;"
                           FontFamily="MauiMaterialAssets"
                           FontSize="20"
                           TextColor="#605E5C"
                           VerticalOptions="Center"/>

                    <controls:SfEntry Grid.Column="1"
                                       Text="{Binding SearchQuery}"
                                       Placeholder="Search Mail and People"
                                       BackgroundColor="Transparent"
                                       Margin="8,0"
                                       VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- User Profile -->
            <HorizontalStackLayout Grid.Column="2"
                           Spacing="10"
                           VerticalOptions="Center">

                <VerticalStackLayout IsVisible="{OnIdiom Default=true, Phone=false}">
                    <Label Text="Kerry Best"
                           FontSize="15"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>

                    <Label Text="kerry.best@contoso.com"
                           FontSize="13"
                           VerticalOptions="Center"/>
                </VerticalStackLayout>
                
                <Border WidthRequest="36"
                        HeightRequest="36"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 26">

                    <Image Source="profile.png"
                           Aspect="AspectFill"/>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <BoxView Grid.Row="1"
                 Grid.ColumnSpan="4"
                 HeightRequest="1"
                 BackgroundColor="#E1DFDD"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill" />

        <Border Grid.Row="2" BackgroundColor="#F4F4F4" StrokeThickness="1">
            <syncfusion:SfTreeView ItemsSource="{Binding Folders}"
                                   VerticalScrollBarVisibility="Never"
                                   ChildPropertyName="Children"
                                   AutoExpandMode="AllNodesExpanded"
                                   ExpandActionTarget="Node"
                                   ItemTemplateContextType="Item"
                                   SelectionBackground="#D7E8FB"
                                   SelectionMode="Single"
                                   ItemHeight="34"
                                   SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
                <syncfusion:SfTreeView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,0,8,0" ColumnDefinitions="*,Auto,Auto" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <PointerGestureRecognizer PointerEnteredCommand="{Binding Source={x:Reference MailWorkspaceRoot}, Path=BindingContext.SetFolderHoverCommand}" PointerEnteredCommandParameter="{Binding .}"
                                                          PointerExitedCommand="{Binding Source={x:Reference MailWorkspaceRoot}, Path=BindingContext.ClearFolderHoverCommand}" PointerExitedCommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding Name}" FontSize="16" VerticalOptions="Center" />
                            <Image Grid.Column="1"
                                   IsVisible="{Binding ShowStar}"
                                   Source="star.png"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   InputTransparent="False">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference MailWorkspaceRoot}, Path=BindingContext.ToggleFolderFavouriteCommand}" CommandParameter="{Binding .}" />
                                </Image.GestureRecognizers>
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding IsFavourite}" Value="True">
                                        <Setter Property="Source" Value="star_filled.png" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <Label Grid.Column="2" Text="{Binding Count}" FontSize="16" VerticalOptions="Center" TextColor="{StaticResource PrimaryLight}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Count}" Value="0">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfTreeView.ItemTemplate>
            </syncfusion:SfTreeView>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" BackgroundColor="White" StrokeThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="40,16,20,8" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding SelectedFolder.Name}" FontSize="22" VerticalOptions="Center" />
                    <inputs:SfComboBox
                            WidthRequest="100"
                            Grid.Column="2"
                            ItemsSource="{Binding FilterOptions}"
                            SelectedItem="{Binding SelectedFilter}"
                            IsDropDownShadowVisible="True"
                            ShowBorder="False"
                            TextColor="#0A6BD6"
                            IsClearButtonVisible="False"
                            DropDownBackground="Transparent" />
                </Grid>
                <Grid Grid.Row="1">
                    <listview:SfListView ItemsSource="{Binding VisibleMessages}" SelectionMode="Single" ScrollBarVisibility="Never" AutoFitMode="DynamicHeight" SelectionBackground="#D7E8FB" ItemSpacing="0" SelectedItem="{Binding SelectedMessage, Mode=TwoWay}" BackgroundColor="White">
                        <listview:SfListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,10" ColumnDefinitions="5,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="0" RowSpacing="6">
                                    <Grid.GestureRecognizers>
                                        <PointerGestureRecognizer PointerEnteredCommand="{Binding Source={x:Reference MailWorkspaceRoot}, Path=BindingContext.SetHoverCommand}" PointerEnteredCommandParameter="{Binding .}"
                                                                  PointerExitedCommand="{Binding Source={x:Reference MailWorkspaceRoot}, Path=BindingContext.ClearHoverCommand}" PointerExitedCommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <BoxView Grid.RowSpan="3" WidthRequest="5" Color="Transparent" Margin="0,-10">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsRead}" Value="False">
                                                <Setter Property="Color" Value="#3B9DE8" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                    <HorizontalStackLayout Grid.Column="2" Margin="0,0,10,0" Spacing="4" IsVisible="{Binding IsHovered}" VerticalOptions="Center" HorizontalOptions="End">
                                        <Image Source="unread.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference MailWorkspaceRoot}, Path=BindingContext.ToggleReadCommand}" CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image" Binding="{Binding IsRead}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                        <Image Source="flag.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference MailWorkspaceRoot}, Path=BindingContext.ToggleFlagCommand}" CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image" Binding="{Binding IsFlagged}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                        <Image Source="archieve.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference MailWorkspaceRoot}, Path=BindingContext.ArchiveMessageCommand}" CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="1" Grid.ColumnSpan="2" Margin="35,0,10,0" Text="{Binding Sender}" FontSize="16" TextColor="#222222" />
                                    <Label Grid.Row="1" Grid.Column="1" Margin="35,0,0,0" Text="{Binding Subject}" FontSize="14" TextColor="#2F8FE0" LineBreakMode="TailTruncation">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsRead}" Value="True">
                                                <Setter Property="TextColor" Value="#222222" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="2" Margin="0,0,10,0" Spacing="6" HorizontalOptions="End">
                                        <Label Text="{Binding ReceivedOn, StringFormat='{0:h:mm tt}'}" FontSize="14" TextColor="#2F8FE0" VerticalOptions="Center" />
                                        <Grid WidthRequest="26" HeightRequest="20" IsVisible="{Binding IsHovered}" BackgroundColor="Transparent">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference MailWorkspaceRoot}, Path=BindingContext.DeleteMessageCommand}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label FontFamily="MauiMaterialAssets" Text="&#xE70F;" FontSize="16" TextColor="#555555" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                                        </Grid>
                                    </HorizontalStackLayout>
                                    <Label Grid.Row="2" Grid.Column="1" Margin="35,0,0,0" Text="{Binding Preview}" FontSize="14" TextColor="#777777" LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </listview:SfListView.ItemTemplate>
                    </listview:SfListView>
                    <controls:StateView IsVisible="{Binding IsEmptyFolder}" />
                </Grid>
            </Grid>
        </Border>

        <BoxView Grid.Row="2"
                 Grid.Column="2"
                 WidthRequest="1"
                 BackgroundColor="#E1DFDD"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill" />

        <Grid Grid.Row="2" Grid.Column="3" BackgroundColor="White">
            <Grid IsVisible="{Binding IsComposing}"
                    Padding="10"
                    RowDefinitions="Auto,Auto,Auto,*,Auto"
                    RowSpacing="8"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                <!-- To -->
                <Label Grid.Row="0"
                       Text="To"
                       FontSize="14"
                       BackgroundColor="#EEEEEE"
                       HeightRequest="36"
                       WidthRequest="40"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

                <inputLayout:SfTextInputLayout Grid.Row="0"
                                               Grid.Column="1"
                                               HeightRequest="60"
                                               Margin="0,10,0,0"
                                               InputViewPadding="8,0,15,0"
                                               ErrorText="{Binding ToErrorText}"
                                               HasError="{Binding HasToError}"
                                               ContainerType="Outlined">

                    <Entry Text="{Binding Composer.To, Mode=TwoWay}"
                           Keyboard="Email" />
                </inputLayout:SfTextInputLayout>

                <!-- Cc -->
                <Label Grid.Row="1"
                       Text="Cc"
                       FontSize="14"
                       BackgroundColor="#EEEEEE"
                       HeightRequest="36"
                       WidthRequest="40"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

                <inputLayout:SfTextInputLayout Grid.Row="1"
                                               HeightRequest="60"
                                               Margin="0,10,0,0"
                                               InputViewPadding="8,0,15,0"
                                               Grid.Column="1"
                                               ContainerType="Outlined">

                    <Entry Text="{Binding Composer.Cc, Mode=TwoWay}"
                           Keyboard="Email" />
                </inputLayout:SfTextInputLayout>

                <!-- Subject -->
                <inputLayout:SfTextInputLayout Grid.Row="2"
                               Grid.ColumnSpan="2"
                                               HeightRequest="60"
                                               InputViewPadding="8,0,15,0"
                               ContainerType="Outlined">

                    <controls:SfEntry Text="{Binding Composer.Subject, Mode=TwoWay}" Placeholder="Add a Subject"/>
                </inputLayout:SfTextInputLayout>

                <!-- Editor -->
                <richtext:SfRichTextEditor Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           ShowToolbar="True"
                                           HtmlText="{Binding Composer.Body, Mode=TwoWay}" >
                    <richtext:SfRichTextEditor.ToolbarItems>
                        <!-- Define a custom set of toolbar items -->
                        <richtext:RichTextToolbarItem Type="Bold" />
                        <richtext:RichTextToolbarItem Type="Underline" />
                        <richtext:RichTextToolbarItem Type="Separator" />
                        <richtext:RichTextToolbarItem Type="NumberList" />
                        <richtext:RichTextToolbarItem Type="BulletList" />
                        <richtext:RichTextToolbarItem Type="FontFamily" />
                        <richtext:RichTextToolbarItem Type="FontSize" />
                        <richtext:RichTextToolbarItem Type="TextColor" />
                        <richtext:RichTextToolbarItem Type="Hyperlink" />
                        <richtext:RichTextToolbarItem Type="Image" />
                        <richtext:RichTextToolbarItem Type="Table" />
                    </richtext:SfRichTextEditor.ToolbarItems>
                    <richtext:SfRichTextEditor.ToolbarSettings>
                        <richtext:RichTextEditorToolbarSettings BackgroundColor="Transparent" SelectionColor="#3B9DE8"/>
                    </richtext:SfRichTextEditor.ToolbarSettings>
                </richtext:SfRichTextEditor>

                <!-- Actions -->
                <HorizontalStackLayout Grid.Row="4"
                           Grid.ColumnSpan="2"
                           Spacing="12">

                    <buttons:SfButton Text="Send"
                             WidthRequest="120"
                             HeightRequest="44"
                             Command="{Binding Composer.SendCommand}"
                             Background="#106EBE"
                             TextColor="White" />

                    <buttons:SfButton Text="Discard"
                             WidthRequest="120"
                             HeightRequest="44"
                             Command="{Binding CloseComposerCommand}"
                             Background="#E5E5E5"
                             TextColor="Black" />
                </HorizontalStackLayout>

            </Grid>

            <Grid IsVisible="{Binding IsComposing, Converter={StaticResource BooleanNegationConverter}}">
                <VerticalStackLayout IsVisible="{Binding HasSelectedMessage, Converter={StaticResource BooleanNegationConverter}}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                    <Label FontFamily="MauiMaterialAssets" Text="&#xE717;" FontSize="80" TextColor="#2F8FE0" HorizontalOptions="Center" />
                    <Label Text="Choose a message to read it." FontSize="22" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <ScrollView IsVisible="{Binding HasSelectedMessage}">
                    <VerticalStackLayout Padding="24,18" Spacing="14">
                        <Label Text="{Binding SelectedMessage.Subject}" FontSize="28" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="64,*" ColumnSpacing="14">
                            <Border HeightRequest="56" WidthRequest="56" StrokeShape="Ellipse" BackgroundColor="#D7E8FB">
                                <Label Text="{Binding SelectedMessage.Sender, Converter={StaticResource InitialsConverter}}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding SelectedMessage.Sender}" FontSize="20" FontAttributes="Bold" />
                                <Label Text="{Binding SelectedMessage.ReceivedOn, StringFormat='{0:dd/MM/yyyy h:mm tt}'}" FontSize="15" TextColor="#666666" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{Binding SelectedMessage.Greeting}" FontSize="16" FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedMessage.Greeting}" Value="">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding SelectedMessage.Body}" FontSize="14" LineBreakMode="WordWrap" LineHeight="2" CharacterSpacing="0.5"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10" Padding="0,10,0,0">
                            <Label Text="To" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Column="1" Text="{Binding SelectedMessage.Recipients}" FontSize="16" />
                            <Label Grid.Row="1" Text="Cc" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedMessage.Cc}" FontSize="16" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
