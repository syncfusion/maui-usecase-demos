<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.TreeView;assembly=Syncfusion.Maui.TreeView"
             xmlns:listview="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:vm="clr-namespace:FluentMail.ViewModels"
             xmlns:controls="clr-namespace:FluentMail.Views.Controls"
             x:Class="FluentMail.Views.MailWorkspacePage"
             x:DataType="vm:MailWorkspaceViewModel"
             Title="Mail"
             BackgroundColor="{AppThemeBinding Light=#F3F3F3, Dark=#1E1E1E}">
    <ContentPage.BindingContext>
        <vm:MailWorkspaceViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="270,490,*" Padding="0" BackgroundColor="{AppThemeBinding Light=#F3F3F3, Dark=#1E1E1E}">
        <Grid Grid.ColumnSpan="3" Padding="20,16,20,14" ColumnDefinitions="*,Auto">
            <Grid ColumnDefinitions="*,Auto" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}" Padding="18,10" StrokeThickness="0">
                <Label Text="Search Mail and People" FontSize="18" TextColor="{AppThemeBinding Light=#666666, Dark=#B7BDC8}" VerticalOptions="Center" />
                <Label Grid.Column="1" FontFamily="MauiMaterialAssets" Text="&#xE8B6;" FontSize="22" TextColor="{StaticResource PrimaryLight}" VerticalOptions="Center" />
            </Grid>
            <HorizontalStackLayout Grid.Column="1" Spacing="26" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6">
                    <Label FontFamily="MauiMaterialAssets" Text="&#xE145;" FontSize="20" TextColor="{StaticResource PrimaryLight}" />
                    <Label Text="New" FontSize="18" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <Label FontFamily="MauiMaterialAssets" Text="&#xE879;" FontSize="20" TextColor="{StaticResource PrimaryLight}" />
                    <Label Text="Mark all as read" FontSize="18" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#F3F3F3, Dark=#252525}" StrokeThickness="0">
            <VerticalStackLayout Padding="10,12" Spacing="8">
                <Grid Padding="12,6" ColumnDefinitions="Auto,*">
                    <Label FontFamily="MauiMaterialAssets" Text="&#xE313;" FontSize="18" Margin="0,0,10,0" />
                    <Label Text="Favorites" FontSize="18" FontAttributes="Bold" />
                </Grid>
                <syncfusion:SfTreeView ItemsSource="{Binding Folders}" SelectionMode="Single" ItemHeight="40" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
                    <syncfusion:SfTreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="16,8" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Name}" FontSize="16" />
                                <Label Grid.Column="1" Text="{Binding UnreadCount}" FontSize="16" TextColor="{StaticResource PrimaryLight}" />
                            </Grid>
                        </DataTemplate>
                    </syncfusion:SfTreeView.ItemTemplate>
                </syncfusion:SfTreeView>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" StrokeThickness="0">
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="22,18,18,10" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding SelectedFolder.Name}" FontSize="28" FontAttributes="Bold" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Label Text="Filter" FontSize="18" TextColor="{StaticResource PrimaryLight}" />
                        <Label FontFamily="MauiMaterialAssets" Text="&#xE313;" FontSize="18" TextColor="{StaticResource PrimaryLight}" />
                    </HorizontalStackLayout>
                </Grid>
                <Grid Grid.Row="1">
                    <listview:SfListView ItemsSource="{Binding VisibleMessages}" SelectionMode="Single" ItemSpacing="0" SelectedItem="{Binding SelectedMessage, Mode=TwoWay}" BackgroundColor="White">
                        <listview:SfListView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                                    <Grid Padding="14,14,14,12" ColumnDefinitions="4,44,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <Border x:Name="UnreadBar" Grid.RowSpan="3" WidthRequest="4" BackgroundColor="Transparent" StrokeThickness="0" />
                                        <Border Grid.Column="1" HeightRequest="36" WidthRequest="36" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light=#D7E8FB, Dark=#27405E}">
                                            <Label Text="{Binding Sender, Converter={StaticResource InitialsConverter}}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="13" />
                                        </Border>
                                        <Label Grid.Column="2" Text="{Binding Sender}" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=#202020, Dark=#F5F5F5}" />
                                        <Label Grid.Column="3" Text="{Binding ReceivedOn, StringFormat='{0:h:mm tt}'}" FontSize="15" TextColor="{AppThemeBinding Light=#666666, Dark=#B7BDC8}" />
                                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding Subject}" FontSize="15" TextColor="{AppThemeBinding Light=#666666, Dark=#B7BDC8}" />
                                        <Label Grid.Row="2" Grid.Column="2" Text="Hi Kerry Best," FontSize="14" TextColor="{AppThemeBinding Light=#8A8A8A, Dark=#B7BDC8}" />
                                        <Grid Grid.Row="1" Grid.Column="3" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                            <Label FontFamily="MauiMaterialAssets" Text="&#xE0C8;" FontSize="18" TextColor="{AppThemeBinding Light=#5F5F5F, Dark=#B7BDC8}" />
                                            <Label Grid.Column="1" FontFamily="MauiMaterialAssets" Text="&#xE878;" FontSize="18" TextColor="{AppThemeBinding Light=#5F5F5F, Dark=#B7BDC8}" />
                                            <Label Grid.Column="2" FontFamily="MauiMaterialAssets" Text="&#xE897;" FontSize="18" TextColor="{StaticResource PrimaryLight}" />
                                        </Grid>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="ReadStates">
                                                <VisualState Name="Read">
                                                    <VisualState.StateTriggers>
                                                        <StateTrigger IsActive="{Binding IsRead}" />
                                                    </VisualState.StateTriggers>
                                                    <VisualState.Setters>
                                                        <Setter TargetName="UnreadBar" Property="BackgroundColor" Value="Transparent" />
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" />
                                                        <Setter TargetName="SenderLabel" Property="Label.TextColor" Value="{AppThemeBinding Light=#202020, Dark=#F5F5F5}" />
                                                        <Setter TargetName="SubjectLabel" Property="Label.TextColor" Value="{AppThemeBinding Light=#666666, Dark=#B7BDC8}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState Name="Unread">
                                                    <VisualState.StateTriggers>
                                                        <StateTrigger IsActive="{Binding IsRead, Converter={StaticResource BooleanNegationConverter}}" />
                                                    </VisualState.StateTriggers>
                                                    <VisualState.Setters>
                                                        <Setter TargetName="UnreadBar" Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EAF2FF, Dark=#20324D}" />
                                                        <Setter TargetName="SenderLabel" Property="Label.TextColor" Value="{StaticResource PrimaryLight}" />
                                                        <Setter TargetName="SubjectLabel" Property="Label.TextColor" Value="{StaticResource PrimaryLight}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </listview:SfListView.ItemTemplate>
                    </listview:SfListView>
                    <controls:StateView IsVisible="{Binding IsEmptyFolder}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" BackgroundColor="White" StrokeThickness="0">
            <Grid>
                <ScrollView>
                    <VerticalStackLayout Padding="24,18" Spacing="14">
                        <Label Text="{Binding SelectedMessage.Subject}" FontSize="28" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="64,*" ColumnSpacing="14">
                            <Border HeightRequest="56" WidthRequest="56" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light=#D7E8FB, Dark=#27405E}">
                                <Label Text="{Binding SelectedMessage.Sender, Converter={StaticResource InitialsConverter}}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding SelectedMessage.Sender}" FontSize="20" FontAttributes="Bold" />
                                <Label Text="{Binding SelectedMessage.ReceivedOn, StringFormat='{0:dd/MM/yyyy h:mm tt}'}" FontSize="15" TextColor="{AppThemeBinding Light=#666666, Dark=#B7BDC8}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="Hi Kerry Best," FontSize="16" FontAttributes="Bold" />
                        <Label Text="{Binding SelectedMessage.Body}" FontSize="16" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10" Padding="0,10,0,0">
                            <Label Text="To" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Column="1" Text="{Binding SelectedMessage.Recipients}" FontSize="16" />
                            <Label Grid.Row="1" Text="Cc" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedMessage.Cc}" FontSize="16" />
                            <Label Grid.Row="2" Text="Status" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedMessage.Status}" FontSize="16" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
                <controls:StateView IsVisible="{Binding IsLoading}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
