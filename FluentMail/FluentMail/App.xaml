<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:FluentMail.Converters"
             xmlns:syncTheme="clr-namespace:Syncfusion.Maui.Themes;assembly=Syncfusion.Maui.Core"
             x:Class="FluentMail.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:InitialsConverter x:Key="InitialsConverter" />
            <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
            <converters:DateGroupTitleConverter x:Key="DateGroupTitleConverter" />
            <converters:NewestFirstGroupComparer x:Key="NewestFirstGroupComparer" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <syncTheme:SyncfusionThemeResourceDictionary />
                <ResourceDictionary>
                    <x:String x:Key="SfListViewTheme">CommonTheme</x:String>
                    <Color x:Key="SfListViewNormalListViewItemBackground">Transparent</Color>
                    <Color x:Key="SfListViewHoverListViewItemBackground">Transparent</Color>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>