<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:FluentMail.Views"
       x:Class="FluentMail.AppShell">
    <FlyoutItem Title="Mail">
        <ShellContent ContentTemplate="{DataTemplate views:MailWorkspacePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Drafts">
        <ShellContent ContentTemplate="{DataTemplate views:DraftWorkspacePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Archive">
        <ShellContent ContentTemplate="{DataTemplate views:ArchivePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Deleted">
        <ShellContent ContentTemplate="{DataTemplate views:DeletedItemsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Compose">
        <ShellContent ContentTemplate="{DataTemplate views:ComposePage}" />
    </FlyoutItem>
</Shell>
