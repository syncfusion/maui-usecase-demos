<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HospitalManagement"
             xmlns:syncTheme="clr-namespace:Syncfusion.Maui.Themes;assembly=Syncfusion.Maui.Core"
             x:Class="HospitalManagement.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Syncfusion Theme Resource Dictionary -->
                <syncTheme:SyncfusionThemeResourceDictionary VisualTheme="MaterialLight"/>
                <!-- Light and Dark Theme Colors -->
                <ResourceDictionary Source="Resources/Styles/Theme.Light.xaml" />
                <ResourceDictionary Source="Resources/Styles/Theme.Dark.xaml" />
                <!-- Base Colors and Styles -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
