<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="E_Commerce_Orders.AnalyticsPage"
             Title="Analytics"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkBackground}}">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource DarkBackground}}">
                <!-- Modern Header -->
                <Grid Padding="0" Background="{StaticResource AppHeaderGradientBrush}">
                    <VerticalStackLayout Padding="20,24,20,20" Spacing="8">
                        <Label Text="📊 Sales Analytics" Style="{StaticResource PageTitle}" TextColor="{StaticResource WhiteBrush}" Margin="0,0,0,4" />
                        <Label Text="Real-time order &amp; revenue insights" FontSize="14" TextColor="{StaticResource WhiteBrush}" Opacity="0.85" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="16" Padding="20,16">
                    <!-- Summary Cards Grid - Modern Border Style -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <!-- Total Orders Card -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ElevatedCardBorder}" >

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            
                            <VerticalStackLayout Spacing="8">
                                <Label Text="📈 Total Orders" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PrimaryBrush}" />
                                <Label Text="{Binding TotalOrders}" FontSize="32" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                <Label Text="All time" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Avg Order Value Card -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ElevatedCardBorder}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="💰 Avg Order Value" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TertiaryBrush}" />
                                <Label Text="{Binding AvgOrderValue, StringFormat='${0:N0}'}" FontSize="32" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                <Label Text="Per transaction" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Revenue Card -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ElevatedCardBorder}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="💵 Total Revenue" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource SecondaryBrush}" />
                                <Label Text="{Binding TotalRevenue, StringFormat='${0:N0}'}" FontSize="32" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                <Label Text="Complete" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total Items Card -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ElevatedCardBorder}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="📦 Total Items" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource AccentBrush}" />
                                <Label Text="{Binding TotalItems}" FontSize="32" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                <Label Text="Sold" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Status Distribution -->
                    <Border Padding="16" Style="{StaticResource ElevatedCardBorder}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="📊 Order Status Distribution" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />

                            <VerticalStackLayout Spacing="14">
                                <!-- Delivered -->
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="✓ Delivered" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"  />
                                        <Label Text="{Binding DeliveredCount, StringFormat='{0} orders'}" FontSize="11" TextColor="{StaticResource TertiaryBrush}" FontAttributes="Bold" />
                                        <Label Text="{Binding DeliveredPercent, StringFormat='{0:P0}'}" FontSize="11" TextColor="{StaticResource PrimaryBrush}" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                    <ProgressBar Progress="{Binding DeliveredPercent}" ProgressColor="{StaticResource TertiaryBrush}" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" HeightRequest="6" />
                                </VerticalStackLayout>

                                <!-- Shipped -->
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="📦 Shipped" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"  />
                                        <Label Text="{Binding ShippedCount, StringFormat='{0} orders'}" FontSize="11" TextColor="{StaticResource PrimaryBrush}" FontAttributes="Bold" />
                                        <Label Text="{Binding ShippedPercent, StringFormat='{0:P0}'}" FontSize="11" TextColor="{StaticResource PrimaryBrush}" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                    <ProgressBar Progress="{Binding ShippedPercent}" ProgressColor="{StaticResource PrimaryBrush}" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" HeightRequest="6" />
                                </VerticalStackLayout>

                                <!-- Pending -->
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="⏳ Pending" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"  />
                                        <Label Text="{Binding PendingCount, StringFormat='{0} orders'}" FontSize="11" TextColor="{StaticResource Magenta}" FontAttributes="Bold" />
                                        <Label Text="{Binding PendingPercent, StringFormat='{0:P0}'}" FontSize="11" TextColor="{StaticResource PrimaryBrush}" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                    <ProgressBar Progress="{Binding PendingPercent}" ProgressColor="{StaticResource Magenta}" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" HeightRequest="6" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Key Metrics -->
                    <Border Padding="16" Style="{StaticResource ElevatedCardBorder}" >

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="📊 Key Metrics" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                <!-- Avg Items Per Order -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Padding="12" Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" Spacing="6">
                                    <Label Text="📦 Avg Items/Order" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" FontAttributes="Bold" />
                                    <Label Text="{Binding AvgItemsPerOrder, StringFormat='{0:F1}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TertiaryBrush}" />
                                </VerticalStackLayout>

                                <!-- Fulfillment Rate -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Padding="12" Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" Spacing="6">
                                    <Label Text="✓ Fulfillment Rate" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" FontAttributes="Bold" />
                                    <Label Text="{Binding FulfillmentRate, StringFormat='{0:P0}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBrush}" />
                                </VerticalStackLayout>

                                <!-- Revenue Per Order -->
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Padding="12" Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" Spacing="6">
                                    <Label Text="💰 Revenue/Order" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" FontAttributes="Bold" />
                                    <Label Text="{Binding AvgOrderValue, StringFormat='${0:F2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TertiaryBrush}" />
                                </VerticalStackLayout>

                                <!-- Total Transactions -->
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Padding="12" Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" Spacing="6">
                                    <Label Text="💳 Transactions" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" FontAttributes="Bold" />
                                    <Label Text="{Binding TotalOrders}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryBrush}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Performance Card -->
                    <Border Padding="16" Style="{StaticResource ElevatedCardBorder}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="🎯 Performance" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />

                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="12" Padding="12" Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}">
                                    <Label Text="Growth Rate:" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"  />
                                    <Label Text="↗ +12.5%" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TertiaryBrush}" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="12" Padding="12" Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}">
                                    <Label Text="Avg Delivery Time:" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"  />
                                    <Label Text="2-3 days" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PrimaryBrush}" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="12" Padding="12" Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}">
                                    <Label Text="Customer Satisfaction:" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"  />
                                    <Label Text="⭐ 4.8/5.0" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TertiaryBrush}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <BoxView HeightRequest="20" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
