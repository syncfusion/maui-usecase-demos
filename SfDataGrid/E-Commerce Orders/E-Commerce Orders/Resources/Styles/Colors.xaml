<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Modern 2026 Color Palette - Clean & Professional -->
    <Color x:Key="Primary">#3B82F6</Color>
    <Color x:Key="PrimaryDark">#1D4ED8</Color>
    <Color x:Key="PrimaryLight">#DBEAFE</Color>
    <Color x:Key="PrimaryDarkText">#1E293B</Color>
    
    <Color x:Key="Secondary">#10B981</Color>
    <Color x:Key="SecondaryLight">#D1FAE5</Color>
    
    <Color x:Key="Accent">#F59E0B</Color>
    <Color x:Key="AccentLight">#FEF3C7</Color>
    
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="DangerLight">#FEE2E2</Color>
    
    <Color x:Key="Tertiary">#8B5CF6</Color>
    <Color x:Key="TertiaryLight">#EDE9FE</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0F172A</Color>
    <Color x:Key="OffWhite">#F8FAFC</Color>
    
    <!-- DARK THEME SPECIFIC COLORS -->
    <!-- Dark backgrounds for dark mode -->
    <Color x:Key="DarkBackground">#0F172A</Color>
    <Color x:Key="DarkSurface">#1E293B</Color>
    <Color x:Key="DarkSurfaceAlt">#334155</Color>
    <Color x:Key="DarkContainer">#0F172A</Color>
    <Color x:Key="DarkContainerHigh">#1E293B</Color>
    
    <!-- Dark text colors -->
    <Color x:Key="DarkTextPrimary">#F1F5F9</Color>
    <Color x:Key="DarkTextSecondary">#CBD5E1</Color>
    <Color x:Key="DarkTextTertiary">#94A3B8</Color>
    <Color x:Key="DarkTextDisabled">#64748B</Color>
    
    <!-- Card background with theme support -->
    <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#1E293B</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="BackgroundLight">#F8FAFC</Color>
    <Color x:Key="BackgroundDark">#0F172A</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E293B</Color>

    <!-- Status Colors - Light -->
    <Color x:Key="DeliveredGreen">#10B981</Color>
    <Color x:Key="DeliveredGreenLight">#D1FAE5</Color>
    <Color x:Key="DeliveredGreenDark">#047857</Color>
    
    <Color x:Key="ShippedBlue">#3B82F6</Color>
    <Color x:Key="ShippedBlueLight">#DBEAFE</Color>
    <Color x:Key="ShippedBlueDark">#1E40AF</Color>
    
    <Color x:Key="PendingOrange">#F59E0B</Color>
    <Color x:Key="PendingOrangeLight">#FEF3C7</Color>
    <Color x:Key="PendingOrangeDark">#B45309</Color>

    <!-- Grayscale - Clean & Minimal -->
    <!-- Light mode grays -->
    <Color x:Key="Gray50">#F9FAFB</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray800">#1F2937</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#0B1220</Color>
    
    <!-- Dark mode gray scale (inverted for better contrast) -->
    <Color x:Key="DarkGray50">#0F172A</Color>
    <Color x:Key="DarkGray100">#1E293B</Color>
    <Color x:Key="DarkGray200">#334155</Color>
    <Color x:Key="DarkGray300">#475569</Color>
    <Color x:Key="DarkGray400">#64748B</Color>
    <Color x:Key="DarkGray500">#78828F</Color>
    <Color x:Key="DarkGray600">#94A3B8</Color>
    <Color x:Key="DarkGray700">#CBD5E1</Color>
    <Color x:Key="DarkGray800">#E2E8F0</Color>
    <Color x:Key="DarkGray900">#F1F5F9</Color>
    <Color x:Key="DarkGray950">#F8FAFC</Color>
    
    <!-- Legacy compatibility colors (used in Styles) -->
    <Color x:Key="Magenta">#D63384</Color>
    <Color x:Key="MidnightBlue">#0F1724</Color>
    <Color x:Key="OffBlack">#F3F4F6</Color>
    <Color x:Key="SecondaryDarkText">#0B6EDC</Color>

    <!-- Theme-aware brushes -->
    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource BackgroundLight}" Dark="{StaticResource BackgroundDark}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <SolidColorBrush x:Key="SurfaceBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource SurfaceLight}" Dark="{StaticResource SurfaceDark}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <!-- Card Background Brush with Theme Support -->
    <SolidColorBrush x:Key="CardBackgroundBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource CardBackgroundLight}" Dark="{StaticResource CardBackgroundDark}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <!-- Primary Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    
    <!-- Secondary Brushes -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLight}"/>
    
    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}"/>
    
    <!-- Danger Brushes -->
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLight}"/>
    
    <!-- Tertiary Brushes -->
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="TertiaryLightBrush" Color="{StaticResource TertiaryLight}"/>

    <!-- Text Brushes with Theme Support -->
    <SolidColorBrush x:Key="TextPrimaryBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource Black}" Dark="{StaticResource DarkTextPrimary}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <SolidColorBrush x:Key="TextSecondaryBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource Gray600}" Dark="{StaticResource DarkTextSecondary}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <SolidColorBrush x:Key="TextTertiaryBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource Gray400}" Dark="{StaticResource DarkTextTertiary}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="OffWhiteBrush" Color="{StaticResource OffWhite}"/>

    <SolidColorBrush x:Key="Gray50Brush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Status Brushes - Light & Dark Variants -->
    <SolidColorBrush x:Key="DeliveredGreenBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource DeliveredGreen}" Dark="{StaticResource DeliveredGreenDark}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <SolidColorBrush x:Key="DeliveredGreenLightBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource DeliveredGreenLight}" Dark="{StaticResource DarkGray200}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <SolidColorBrush x:Key="ShippedBlueBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource ShippedBlue}" Dark="{StaticResource ShippedBlueDark}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <SolidColorBrush x:Key="ShippedBlueLightBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource ShippedBlueLight}" Dark="{StaticResource DarkGray200}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <SolidColorBrush x:Key="PendingOrangeBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource PendingOrange}" Dark="{StaticResource PendingOrangeDark}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <SolidColorBrush x:Key="PendingOrangeLightBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource PendingOrangeLight}" Dark="{StaticResource DarkGray200}"/>
        </SolidColorBrush.Color>
    </SolidColorBrush>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="AppHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Primary}" Offset="0" />
        <GradientStop Color="{StaticResource Tertiary}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Primary}" Offset="0" />
        <GradientStop Color="{StaticResource PrimaryDark}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>