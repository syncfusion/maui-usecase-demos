<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:E_Commerce_Orders.Converters"
             xmlns:sfPopup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             x:Class="E_Commerce_Orders.OrderDetailPage"
             Title="Order Details">

    <ContentPage.Resources>
        <local:StatusColorConverter x:Key="statusColorConverter"/>
        <local:StatusBackgroundConverter x:Key="statusBackgroundConverter"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0">
            <!-- Header with Gradient Background -->
            <Border Padding="0" Background="{StaticResource AppHeaderGradientBrush}" Margin="0">
                <VerticalStackLayout Padding="24" Spacing="12">
                    <Label Text="📋 Order Details"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{StaticResource WhiteBrush}" />
                    <Label Text="{Binding SelectedOrder.OrderId, StringFormat='Order #{0:D5}'}"
                           FontSize="16"
                           TextColor="{StaticResource Gray200Brush}" />
                    <HorizontalStackLayout Spacing="12">
                        <Border Padding="12,6"
                                Background="{Binding SelectedOrder.OrderStatus, Converter={StaticResource statusBackgroundConverter}}"
                                StrokeThickness="0">
                            <Label Text="{Binding SelectedOrder.OrderStatus}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource WhiteBrush}" />
                        </Border>
                        <Label Text="{Binding OrderDateDisplay}"
                               FontSize="12"
                               TextColor="{StaticResource Gray200Brush}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Main Content -->
            <VerticalStackLayout Padding="20" Spacing="20">
                <!-- Customer Info Card -->
                <Border Padding="20" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="👤 Customer Information" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="Name:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" MinimumWidthRequest="80" />
                                <Label Text="{Binding SelectedOrder.CustomerName}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"  />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="Order ID:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" MinimumWidthRequest="80" />
                                <Label Text="{Binding SelectedOrder.OrderId}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Order Summary Card -->
                <Border Padding="20" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📦 Order Summary" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />

                        <!-- Items List -->
                        <CollectionView ItemsSource="{Binding SelectedOrder.Products}" SelectionMode="Single" SelectionChangedCommand="{Binding ItemSelectedCommand}" SelectionChangedCommandParameter="{Binding SelectedItem}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" Margin="0,6" Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"  Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                            <HorizontalStackLayout Spacing="16">
                                                <VerticalStackLayout >
                                                    <Label Text="Qty" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                    <Label Text="{Binding Quantity}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TertiaryBrush}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout >
                                                    <Label Text="Unit Price" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                    <Label Text="{Binding Price, StringFormat='${0:F2}'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TertiaryBrush}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout >
                                                    <Label Text="Subtotal" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                    <Label Text="{Binding SubTotal, StringFormat='${0:F2}'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PrimaryBrush}" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Financial Summary Card -->
                <Border Padding="20" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="💰 Financial Summary" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />

                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="Subtotal:" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"  />
                                <Label Text="{Binding SubtotalAmount, StringFormat='${0:F2}'}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="Tax (10%):" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"  />
                                <Label Text="{Binding TaxAmount, StringFormat='${0:F2}'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TertiaryBrush}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="Shipping:" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"  />
                                <Label Text="{Binding ShippingCost, StringFormat='${0:F2}'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TertiaryBrush}" />
                            </HorizontalStackLayout>
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}" Margin="0,8" />
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="Total Price:" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"  />
                                <Label Text="{Binding SelectedOrder.TotalPrice, StringFormat='${0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryBrush}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Status Timeline Card -->
                <Border Padding="20" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📍 Status Timeline" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />

                        <VerticalStackLayout Spacing="16">
                            <!-- Order Placed -->
                            <HorizontalStackLayout Spacing="12">
                                <Border Padding="0" Background="{StaticResource TertiaryBrush}" WidthRequest="40" HeightRequest="40">
                                    <Label Text="✓" FontSize="20" TextColor="{StaticResource WhiteBrush}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Order Placed" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                    <Label Text="Today, 10:30 AM" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <!-- Processing -->
                            <HorizontalStackLayout Spacing="12">
                                <Border Padding="0" Background="{StaticResource Magenta}" WidthRequest="40" HeightRequest="40">
                                    <Label Text="⚙" FontSize="20" TextColor="{StaticResource WhiteBrush}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Processing" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                    <Label Text="Est. Today, 2:00 PM" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <!-- Shipped -->
                            <HorizontalStackLayout Spacing="12">
                                <Border Padding="0" Background="{StaticResource PrimaryBrush}" WidthRequest="40" HeightRequest="40">
                                    <Label Text="📦" FontSize="20" TextColor="{StaticResource WhiteBrush}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Shipped" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                    <Label Text="Est. Tomorrow" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <!-- Delivery -->
                            <HorizontalStackLayout Spacing="12">
                                <Border Padding="0" Background="{StaticResource Gray200Brush}" WidthRequest="40" HeightRequest="40">
                                    <Label Text="🚚" FontSize="20" TextColor="{StaticResource Gray400Brush}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Delivered" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500Brush}" />
                                    <Label Text="Est. In 3 days" FontSize="10" TextColor="{StaticResource Gray600Brush}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons -->
                <VerticalStackLayout Spacing="12">
                    <Button Text="🔄 Reorder" Background="{StaticResource PrimaryBrush}" TextColor="{StaticResource WhiteBrush}" CornerRadius="12" Padding="16" FontAttributes="Bold" Clicked="OnReorderClicked" />
                    <Button Text="💬 Contact Support" Background="{StaticResource SecondaryBrush}" TextColor="{StaticResource WhiteBrush}" CornerRadius="12" Padding="16" FontAttributes="Bold" Clicked="OnContactSupportClicked" />
                    <Button Text="← Back to Orders" Background="PaleVioletRed" TextColor="{StaticResource BlackBrush}" CornerRadius="12" Padding="16" FontAttributes="Bold" Clicked="OnBackClicked" />
                </VerticalStackLayout>

                <sfPopup:SfPopup x:Name="sfPopup" ShowFooter="False" ShowHeader="False" AutoSizeMode="Both">
                    <sfPopup:SfPopup.ContentTemplate>

                        <DataTemplate>
                            <!-- Support Issue Report Panel -->
                            <Border x:Name="SupportReportPanel"
        Padding="20"
        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}">
                                <VerticalStackLayout Spacing="14">
                                    <Label Text="Report an Issue" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                    <Label Text="Choose the order issue below and our team will contact you within 6 hours." FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Select issue type" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
                                        <Picker Title="Choose issue type"
                    ItemsSource="{Binding SupportIssueOptions}"
                    SelectedItem="{Binding SelectedIssueType}"
                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    TitleColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Additional details" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
                                        <Editor Placeholder="Describe the problem briefly..."
                    Text="{Binding SupportIssueDetails}"
                    AutoSize="TextChanges"
                    HeightRequest="110"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkGray100}}"
                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                    </VerticalStackLayout>

                                    <Button Text="Report Issue"
                Background="{StaticResource PrimaryBrush}"
                TextColor="{StaticResource WhiteBrush}"
                CornerRadius="12"
                Padding="14"
                FontAttributes="Bold"
                Clicked="OnSubmitSupportReportClicked" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                        
                    </sfPopup:SfPopup.ContentTemplate>
                </sfPopup:SfPopup>

                

                <BoxView HeightRequest="20" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
