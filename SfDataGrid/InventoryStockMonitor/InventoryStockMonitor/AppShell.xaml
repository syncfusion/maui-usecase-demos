<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StockMonitor.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:StockMonitor.Views">

    <Shell.ToolbarItems>
        <ToolbarItem 
            x:Name="ThemeToggleButton"
            Text="🌙"
            Clicked="OnThemeToggleClicked"
            Priority="1" />
    </Shell.ToolbarItems>

    <ShellContent
        Title="Dashboard"
        ContentTemplate="{DataTemplate local:DashboardPage}"
        Route="DashboardPage" />

</Shell>
