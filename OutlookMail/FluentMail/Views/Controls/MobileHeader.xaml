<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             x:Class="FluentMail.Views.Controls.MobileHeader"
             x:Name="Root">
    <Grid Padding="16,8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" HeightRequest="70" BackgroundColor="{AppThemeBinding Light=#F3F3F3, Dark=#1E1E1E}">
        <Label Text="{Binding Title, Source={x:Reference Root}}" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1B1B1B, Dark=#F5F5F5}" VerticalOptions="Center" />
        <Image x:Name="FilterIcon" Grid.Column="1" Source="{AppThemeBinding Light=ic_filter.svg, Dark=ic_filter_d.svg}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"
               IsVisible="{Binding HasFilter, Source={x:Reference Root}}" SemanticProperties.Description="Filter mail folders">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFilterTapped" />
            </Image.GestureRecognizers>
        </Image>
        <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="Ellipse">
            <Image Source="profile.png" Aspect="AspectFill" />
        </Border>
        <popup:SfPopup x:Name="FilterPopup" ShowHeader="False" ShowFooter="False" BackgroundColor="Transparent" ShowCloseButton="False" WidthRequest="210" HeightRequest="200">
            <popup:SfPopup.PopupStyle>
                <popup:PopupStyle CornerRadius="6" HasShadow="True" MessageBackground="{AppThemeBinding Light=#F3F3F3, Dark=#1E1E1E}" OverlayColor="Transparent" />
            </popup:SfPopup.PopupStyle>
            <popup:SfPopup.ContentTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="6">
                        <Label Text="Inbox" FontSize="17" TextColor="{AppThemeBinding Light=#1B1B1B, Dark=#F5F5F5}" Padding="14,0" HeightRequest="48" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFilterOptionTapped" CommandParameter="Inbox" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="Sent items" FontSize="17" TextColor="{AppThemeBinding Light=#1B1B1B, Dark=#F5F5F5}" Padding="14,0" HeightRequest="48" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFilterOptionTapped" CommandParameter="Sent Items" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="Archived" FontSize="17" TextColor="{AppThemeBinding Light=#1B1B1B, Dark=#F5F5F5}" Padding="14,0" HeightRequest="48" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFilterOptionTapped" CommandParameter="Archive" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="Deleted mails" FontSize="17" TextColor="{AppThemeBinding Light=#1B1B1B, Dark=#F5F5F5}" Padding="14,0" HeightRequest="48" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFilterOptionTapped" CommandParameter="Deleted Items" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>
    </Grid>
</ContentView>